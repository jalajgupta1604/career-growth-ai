<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Interview Debriefs</h1>
        <p class="mt-1 text-sm text-gray-500">Log your real interviews and get AI-powered analysis</p>
      </div>
      <%= link_to new_interview_debrief_path, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors" do %>
        <span class="material-symbols-outlined text-[20px]">add</span>
        New Debrief
      <% end %>
    </div>

    <% if @debriefs.any? %>
      <div class="space-y-4">
        <% @debriefs.each do |debrief| %>
          <%= link_to interview_debrief_path(debrief), class: "block bg-white rounded-2xl border border-gray-100 p-6 hover:border-cyan-200 hover:shadow-md transition-all" do %>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-gray-100 rounded-xl flex items-center justify-center">
                  <span class="material-symbols-outlined text-[24px] text-gray-500">business</span>
                </div>
                <div>
                  <h3 class="text-base font-bold text-gray-900"><%= debrief.company_name %></h3>
                  <p class="text-sm text-gray-500"><%= debrief.role_applied || "Not specified" %> &bull; <%= debrief.interview_date&.strftime("%b %d, %Y") || "No date" %></p>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <span class="px-2.5 py-1 text-xs font-medium rounded-full
                  <%= case debrief.status
                      when 'completed' then 'bg-green-50 text-green-600'
                      when 'analyzing' then 'bg-yellow-50 text-yellow-600'
                      when 'failed' then 'bg-red-50 text-red-600'
                      else 'bg-gray-100 text-gray-500'
                      end %>">
                  <%= debrief.status.capitalize %>
                </span>
                <span class="material-symbols-outlined text-gray-400 text-[20px]">chevron_right</span>
              </div>
            </div>
            <% if debrief.analyzed? && debrief.ai_analysis["difficulty_rating"].present? %>
              <div class="mt-3 flex items-center gap-3 text-xs text-gray-400">
                <span>Difficulty: <strong class="text-gray-600"><%= debrief.ai_analysis["difficulty_rating"] %></strong></span>
                <span>&bull;</span>
                <span><%= (debrief.questions_data || []).size %> questions logged</span>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white rounded-2xl border border-gray-100 p-16 text-center">
        <div class="w-16 h-16 bg-cyan-50 rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="material-symbols-outlined text-cyan-500 text-[32px]">rate_review</span>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">No debriefs yet</h3>
        <p class="text-sm text-gray-500 mb-6">After your next interview, log the questions here for AI analysis and improvement tips.</p>
        <%= link_to new_interview_debrief_path, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors" do %>
          <span class="material-symbols-outlined text-[20px]">add</span>
          Log Your First Interview
        <% end %>
      </div>
    <% end %>
  </div>
</div>

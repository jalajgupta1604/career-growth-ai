<% content_for :page_title, "Edit #{@department.name}" %>

<div class="max-w-2xl">
  <div class="bg-white rounded-2xl border border-gray-100 p-6">
    <%= form_with model: @department, url: enterprise_department_path(@department), method: :patch, class: "space-y-5" do |f| %>
      <% if @department.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-xl p-4">
          <ul class="list-disc list-inside text-sm text-red-600 space-y-1">
            <% @department.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Department Name</label>
        <%= f.text_field :name, class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Description</label>
        <%= f.text_area :description, rows: 3, class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition resize-y" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Department Head</label>
        <%= f.select :head_id, @company.users.map { |u| [u.full_name || u.email, u.id] }, { include_blank: "Select a head (optional)" }, class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Parent Department</label>
        <%= f.select :parent_department_id, @company.departments.where.not(id: @department.id).map { |d| [d.name, d.id] }, { include_blank: "None (top-level)" }, class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition" %>
      </div>

      <div class="flex items-center justify-between pt-2">
        <% if current_member&.hr_admin? %>
          <%= button_to enterprise_department_path(@department), method: :delete, class: "text-sm text-red-500 hover:text-red-700 font-medium cursor-pointer", data: { turbo_confirm: "Delete #{@department.name}? Members will be unassigned." } do %>
            Delete Department
          <% end %>
        <% end %>
        <div class="flex items-center gap-3">
          <%= link_to "Cancel", enterprise_department_path(@department), class: "px-4 py-2.5 text-sm font-medium text-gray-600 hover:text-gray-800" %>
          <%= f.submit "Save Changes", class: "px-6 py-2.5 bg-emerald-600 text-white text-sm font-semibold rounded-xl hover:bg-emerald-700 transition cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

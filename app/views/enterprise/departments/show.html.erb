<% content_for :page_title, @department.name %>
<% content_for :page_subtitle, "#{@members.count} members" %>

<% content_for :page_actions do %>
  <% if current_member&.hr_admin? %>
    <%= link_to edit_enterprise_department_path(@department), class: "inline-flex items-center gap-1.5 px-4 py-2 bg-white border border-gray-200 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition" do %>
      <span class="material-symbols-outlined text-base">edit</span> Edit
    <% end %>
  <% end %>
<% end %>

<!-- Department Info -->
<div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Department Head</p>
      <% if @department.head %>
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center text-xs font-bold text-emerald-700">
            <%= @department.head.full_name&.first&.upcase || "H" %>
          </div>
          <span class="text-sm font-medium text-gray-900"><%= @department.head.full_name || @department.head.email %></span>
        </div>
      <% else %>
        <p class="text-sm text-gray-400">Not assigned</p>
      <% end %>
    </div>
    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Parent Department</p>
      <% if @department.parent_department %>
        <%= link_to @department.parent_department.name, enterprise_department_path(@department.parent_department), class: "text-sm font-medium text-emerald-600 hover:text-emerald-700" %>
      <% else %>
        <p class="text-sm text-gray-400">Top-level</p>
      <% end %>
    </div>
    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Description</p>
      <p class="text-sm text-gray-700"><%= @department.description.presence || "—" %></p>
    </div>
  </div>
</div>

<!-- Members -->
<div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-100">
    <h3 class="text-base font-semibold text-gray-900">Members</h3>
  </div>

  <% if @members.any? %>
    <div class="divide-y divide-gray-50">
      <% @members.each do |member| %>
        <div class="flex items-center justify-between px-6 py-4 hover:bg-gray-50 transition-colors">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-emerald-100 flex items-center justify-center text-xs font-bold text-emerald-700">
              <%= member.user.full_name&.first&.upcase || "?" %>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-900"><%= member.user.full_name || member.user.email %></p>
              <p class="text-xs text-gray-400"><%= member.title || member.user.role %></p>
            </div>
          </div>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold
            <%= case member.role
                when 'hr_admin', 'admin' then 'bg-purple-100 text-purple-700'
                when 'manager' then 'bg-blue-100 text-blue-700'
                else 'bg-gray-100 text-gray-600'
                end %>">
            <%= member.role.humanize %>
          </span>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="py-8 text-center">
      <p class="text-sm text-gray-400">No members in this department yet.</p>
    </div>
  <% end %>
</div>

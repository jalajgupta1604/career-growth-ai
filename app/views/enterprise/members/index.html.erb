<% content_for :page_title, "Team Members" %>
<% content_for :page_subtitle, "#{@company.name} — #{@members.count} members" %>

<% if current_member&.hr_admin? %>
  <!-- Add Member -->
  <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
    <h3 class="text-sm font-semibold text-gray-900 mb-3">Add Team Member</h3>
    <%= form_with(url: enterprise_members_path, method: :post, class: "flex items-end gap-4") do |f| %>
      <div class="flex-1">
        <label class="block text-xs text-gray-500 mb-1">Email Address</label>
        <input type="email" name="email" placeholder="user@company.com" required class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:border-transparent">
      </div>
      <div>
        <label class="block text-xs text-gray-500 mb-1">Role</label>
        <select name="member_role" class="px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:border-transparent">
          <option value="employee">Employee</option>
          <option value="manager">Manager</option>
          <option value="hr_admin">HR Admin</option>
          <option value="viewer">Viewer</option>
        </select>
      </div>
      <%= f.submit "Add Member", class: "px-4 py-2.5 bg-emerald-600 text-white text-sm font-semibold rounded-xl hover:bg-emerald-700 transition cursor-pointer" %>
    <% end %>
  </div>
<% end %>

<!-- Members List -->
<div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
  <!-- Table Header -->
  <div class="hidden md:grid grid-cols-12 gap-4 px-6 py-3 text-xs font-semibold text-gray-400 uppercase tracking-wide border-b border-gray-100">
    <div class="col-span-3">Name</div>
    <div class="col-span-2">Title</div>
    <div class="col-span-2">Department</div>
    <div class="col-span-2">Role</div>
    <div class="col-span-1">Status</div>
    <div class="col-span-2 text-right">Actions</div>
  </div>

  <div class="divide-y divide-gray-50">
    <% @members.each do |member| %>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 px-6 py-4 items-center hover:bg-gray-50 transition-colors">
        <div class="col-span-3">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-emerald-100 flex items-center justify-center text-xs font-bold text-emerald-700">
              <%= member.user.full_name&.first&.upcase || member.user.email.first.upcase %>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-900"><%= member.user.full_name || member.user.email %></p>
              <p class="text-xs text-gray-400"><%= member.user.email %></p>
            </div>
          </div>
        </div>
        <div class="col-span-2">
          <p class="text-sm text-gray-700"><%= member.title || "—" %></p>
        </div>
        <div class="col-span-2">
          <p class="text-sm text-gray-700"><%= member.department&.name || "—" %></p>
        </div>
        <div class="col-span-2">
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold
            <%= case member.role
                when 'hr_admin', 'admin' then 'bg-purple-100 text-purple-700'
                when 'manager' then 'bg-blue-100 text-blue-700'
                when 'employee', 'member' then 'bg-gray-100 text-gray-600'
                else 'bg-gray-100 text-gray-500'
                end %>">
            <%= member.role.humanize %>
          </span>
        </div>
        <div class="col-span-1">
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
            <%= member.employment_status == 'active' ? 'bg-green-50 text-green-700' : 'bg-gray-100 text-gray-500' %>">
            <%= (member.employment_status || "active").capitalize %>
          </span>
        </div>
        <div class="col-span-2 text-right">
          <% if current_member&.hr_admin? && member.user != current_user %>
            <%= button_to enterprise_member_path(member), method: :delete, class: "text-xs text-red-500 hover:text-red-700 font-medium cursor-pointer", data: { turbo_confirm: "Remove #{member.user.full_name || member.user.email} from the team?" } do %>
              <span class="material-symbols-outlined text-sm">person_remove</span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= @data[:company].name %> Analytics</h1>
      <p class="mt-1 text-gray-500">Enterprise HR dashboard &middot; <%= @data[:team_size] %> team members</p>
    </div>
    <div class="flex items-center gap-3">
      <%= button_to "Refresh Analytics", enterprise_refresh_path, method: :post, class: "px-4 py-2 bg-cyan-500 text-white text-sm font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer" %>
      <%= link_to "Manage Team", enterprise_members_path, class: "px-4 py-2 bg-gray-100 text-gray-700 text-sm font-semibold rounded-xl hover:bg-gray-200 transition-colors" %>
    </div>
  </div>

  <% snapshot = @data[:snapshot] %>
  <% if snapshot %>
    <!-- Key Metrics -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <p class="text-sm font-medium text-gray-500">Team Size</p>
        <p class="mt-2 text-3xl font-bold text-gray-900"><%= snapshot.team_size %></p>
      </div>
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <p class="text-sm font-medium text-gray-500">Avg Salary</p>
        <p class="mt-2 text-3xl font-bold text-cyan-600">&#8377;<%= number_with_delimiter(snapshot.avg_salary.to_i) %></p>
      </div>
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <p class="text-sm font-medium text-gray-500">Avg Experience</p>
        <p class="mt-2 text-3xl font-bold text-gray-900"><%= snapshot.avg_experience.to_f.round(1) %> yrs</p>
      </div>
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <p class="text-sm font-medium text-gray-500">Unique Skills</p>
        <p class="mt-2 text-3xl font-bold text-purple-600"><%= @data[:skill_summary].dig("total_unique_skills") || 0 %></p>
      </div>
    </div>

    <!-- Salary Distribution -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Salary Overview</h3>
        <% salary = @data[:salary_summary] %>
        <% if salary.present? %>
          <div class="space-y-3">
            <div class="flex justify-between"><span class="text-sm text-gray-500">Minimum</span><span class="text-sm font-semibold">&#8377;<%= number_with_delimiter(salary["min"] || salary[:min] || 0) %></span></div>
            <div class="flex justify-between"><span class="text-sm text-gray-500">Median</span><span class="text-sm font-semibold">&#8377;<%= number_with_delimiter(salary["median"] || salary[:median] || 0) %></span></div>
            <div class="flex justify-between"><span class="text-sm text-gray-500">Average</span><span class="text-sm font-semibold">&#8377;<%= number_with_delimiter(salary["average"] || salary[:average] || 0) %></span></div>
            <div class="flex justify-between"><span class="text-sm text-gray-500">Maximum</span><span class="text-sm font-semibold">&#8377;<%= number_with_delimiter(salary["max"] || salary[:max] || 0) %></span></div>
            <div class="flex justify-between border-t border-gray-100 pt-3"><span class="text-sm text-gray-500">Total Payroll</span><span class="text-sm font-bold text-cyan-600">&#8377;<%= number_with_delimiter(salary["total_payroll"] || salary[:total_payroll] || 0) %></span></div>
          </div>

          <% distribution = salary["distribution"] || salary[:distribution] || [] %>
          <% if distribution.any? %>
            <div class="mt-4 pt-4 border-t border-gray-100">
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Distribution</p>
              <div class="space-y-2">
                <% distribution.each do |bucket| %>
                  <% label = bucket["label"] || bucket[:label] %>
                  <% count = bucket["count"] || bucket[:count] || 0 %>
                  <% pct = snapshot.team_size > 0 ? (count.to_f / snapshot.team_size * 100).round : 0 %>
                  <div class="flex items-center gap-3">
                    <span class="text-xs text-gray-500 w-16"><%= label %></span>
                    <div class="flex-1 bg-gray-100 rounded-full h-2"><div class="h-2 rounded-full bg-cyan-500" style="width: <%= pct %>%"></div></div>
                    <span class="text-xs font-medium text-gray-700"><%= count %></span>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-400">No salary data available yet.</p>
        <% end %>
      </div>

      <!-- Top Skills -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Top Team Skills</h3>
        <% skills = @data[:skill_summary].dig("top_skills") || @data[:skill_summary].dig(:top_skills) || [] %>
        <% if skills.any? %>
          <div class="space-y-2">
            <% skills.first(10).each do |skill| %>
              <% name = skill["name"] || skill[:name] %>
              <% count = skill["count"] || skill[:count] || 0 %>
              <% pct = snapshot.team_size > 0 ? (count.to_f / snapshot.team_size * 100).round : 0 %>
              <div class="flex items-center gap-3">
                <span class="text-sm text-gray-700 w-32 truncate"><%= name %></span>
                <div class="flex-1 bg-gray-100 rounded-full h-2"><div class="h-2 rounded-full bg-purple-500" style="width: <%= pct %>%"></div></div>
                <span class="text-xs font-medium text-gray-500"><%= count %> members</span>
              </div>
            <% end %>
          </div>
          <p class="mt-3 text-xs text-gray-400">Skill coverage: <%= @data[:skill_summary].dig("skill_coverage") || @data[:skill_summary].dig(:skill_coverage) || 0 %>%</p>
        <% else %>
          <p class="text-sm text-gray-400">No skill data available yet.</p>
        <% end %>
      </div>
    </div>

    <!-- Roles & Hiring -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Roles Breakdown</h3>
        <% roles = @data[:roles_breakdown] || {} %>
        <% if roles.any? %>
          <div class="space-y-2">
            <% roles.each do |role, count| %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-700"><%= role %></span>
                <span class="text-sm font-semibold text-gray-900"><%= count %></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-400">No role data available.</p>
        <% end %>
      </div>

      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Recent Hiring</h3>
        <% hiring = @data[:hiring_summary] %>
        <% if hiring.present? %>
          <div class="space-y-3">
            <div class="flex justify-between"><span class="text-sm text-gray-500">New hires (3 months)</span><span class="text-sm font-semibold"><%= hiring["recent_hires"] || hiring[:recent_hires] || 0 %></span></div>
            <div class="flex justify-between"><span class="text-sm text-gray-500">Avg experience (new)</span><span class="text-sm font-semibold"><%= hiring["avg_experience_new"] || hiring[:avg_experience_new] || 0 %> years</span></div>
          </div>
          <% roles_hiring = hiring["roles_hiring"] || hiring[:roles_hiring] || {} %>
          <% if roles_hiring.any? %>
            <div class="mt-4 pt-4 border-t border-gray-100">
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Roles Hired</p>
              <div class="flex flex-wrap gap-2">
                <% roles_hiring.each do |role, count| %>
                  <span class="px-2.5 py-1 bg-green-50 text-green-700 rounded-md text-xs font-medium"><%= role %> (<%= count %>)</span>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-400">No hiring data available.</p>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl border border-gray-100 p-12 text-center">
      <h3 class="text-lg font-semibold text-gray-900 mb-2">No Analytics Data Yet</h3>
      <p class="text-sm text-gray-500 mb-6">Click "Refresh Analytics" to generate your first team snapshot.</p>
    </div>
  <% end %>
</div>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Team Members</h1>
      <p class="mt-1 text-gray-500"><%= @company.name %> &middot; <%= @members.count %> members</p>
    </div>
    <%= link_to "&larr; Back to Dashboard".html_safe, enterprise_dashboard_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <!-- Add Member -->
  <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
    <h3 class="text-sm font-semibold text-gray-900 mb-3">Add Team Member</h3>
    <%= form_with(url: enterprise_add_member_path, method: :post, class: "flex items-end gap-4") do |f| %>
      <div class="flex-1">
        <label class="block text-xs text-gray-500 mb-1">Email Address</label>
        <input type="email" name="email" placeholder="user@company.com" required class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-cyan-500 focus:border-transparent">
      </div>
      <div>
        <label class="block text-xs text-gray-500 mb-1">Role</label>
        <select name="member_role" class="px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-cyan-500 focus:border-transparent">
          <option value="member">Member</option>
          <option value="admin">Admin</option>
        </select>
      </div>
      <%= f.submit "Add Member", class: "px-4 py-2.5 bg-cyan-500 text-white text-sm font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer" %>
    <% end %>
  </div>

  <!-- Members List -->
  <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
    <div class="divide-y divide-gray-50">
      <% @members.each do |member| %>
        <div class="flex items-center justify-between px-6 py-4 hover:bg-gray-50 transition-colors">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 bg-cyan-100 rounded-full flex items-center justify-center">
              <span class="text-sm font-bold text-cyan-600"><%= member.user.full_name&.first&.upcase || member.user.email.first.upcase %></span>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-900"><%= member.user.full_name || member.user.email %></p>
              <p class="text-xs text-gray-500"><%= member.user.email %> &middot; <%= member.user.role %> &middot; <%= member.user.experience_years %> yrs</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="px-2.5 py-1 text-xs font-semibold rounded-full
              <%= member.admin? ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-gray-600' %>">
              <%= member.role.capitalize %>
            </span>
            <% if member.user != current_user %>
              <%= button_to "Remove", enterprise_remove_member_path(member_id: member.id), method: :delete, class: "text-xs text-red-500 hover:text-red-700 font-medium cursor-pointer", data: { turbo_confirm: "Remove #{member.user.full_name || member.user.email} from the team?" } %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

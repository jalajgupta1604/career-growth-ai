<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <%= link_to salary_submissions_path, class: "text-sm text-gray-500 hover:text-gray-700" do %>
      &larr; Back to Salary Explorer
    <% end %>
    <h1 class="text-3xl font-bold text-gray-900 mt-4">Share Your Salary</h1>
    <p class="mt-1 text-gray-500">Contribute anonymously to help the community. Your identity is never revealed.</p>
  </div>

  <%= form_with model: SalarySubmission.new, url: salary_submissions_path, method: :post, class: "space-y-6" do |f| %>
    <div class="bg-white rounded-2xl border border-gray-100 p-6 space-y-5">
      <h2 class="text-lg font-semibold text-gray-900">Role & Location</h2>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
          <%= f.text_field :role, value: current_user.role, class: "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">City</label>
          <%= f.text_field :city, value: current_user.city, class: "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" %>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Experience (years)</label>
          <%= f.number_field :experience_years, value: current_user.experience_years, class: "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500", min: 0, max: 40 %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Company Type</label>
          <select name="salary_submission[company_type]" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
            <option value="">Select type...</option>
            <option value="startup">Startup</option>
            <option value="mid_size">Mid-size</option>
            <option value="mnc">MNC</option>
            <option value="product">Product Company</option>
            <option value="service">Service Company</option>
          </select>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 p-6 space-y-5">
      <h2 class="text-lg font-semibold text-gray-900">Compensation</h2>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Base Salary (&#8377; per annum)</label>
          <%= f.number_field :base_salary, class: "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500", placeholder: "e.g., 1200000", step: 1000 %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Total CTC (optional)</label>
          <%= f.number_field :total_ctc, class: "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500", placeholder: "e.g., 1800000", step: 1000 %>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Company Name (optional)</label>
        <%= f.text_field :company_name, class: "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500", placeholder: "e.g., Flipkart" %>
      </div>
    </div>

    <div class="flex items-center gap-3 bg-green-50 rounded-xl p-4">
      <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
      <p class="text-xs text-green-700">Your submission is <strong>anonymous by default</strong>. Your name and email are never shared publicly.</p>
    </div>

    <div class="flex items-center justify-between">
      <%= link_to "Cancel", salary_submissions_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <button type="submit" class="px-8 py-3 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer">
        Submit Anonymously
      </button>
    </div>
  <% end %>
</div>

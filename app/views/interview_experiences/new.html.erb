<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <%= link_to interview_experiences_path, class: "text-sm text-gray-500 hover:text-gray-700" do %>
      &larr; Back to Experiences
    <% end %>
    <h1 class="text-3xl font-bold text-gray-900 mt-4">Share Interview Experience</h1>
    <p class="mt-1 text-gray-500">Help others by sharing your interview experience anonymously</p>
  </div>

  <%= form_with model: InterviewExperience.new, url: interview_experiences_path, method: :post, class: "space-y-6" do |f| %>
    <div class="bg-white rounded-2xl border border-gray-100 p-6 space-y-5">
      <h2 class="text-lg font-semibold text-gray-900">Interview Details</h2>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Company Name</label>
          <%= f.text_field :company_name, class: "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500", placeholder: "e.g., Google" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
          <%= f.text_field :role, value: current_user.role, class: "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" %>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Difficulty</label>
          <select name="interview_experience[difficulty]" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500">
            <option value="easy">Easy</option>
            <option value="medium" selected>Medium</option>
            <option value="hard">Hard</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Outcome</label>
          <select name="interview_experience[outcome]" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500">
            <option value="">Select...</option>
            <option value="selected">Selected</option>
            <option value="rejected">Rejected</option>
            <option value="in_progress">In Progress</option>
            <option value="no_response">No Response</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Total Rounds</label>
          <%= f.number_field :rounds_count, class: "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500", min: 1, max: 15, placeholder: "e.g., 4" %>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Overall Rating (1-5)</label>
        <div class="flex gap-2">
          <% (1..5).each do |rating| %>
            <label class="cursor-pointer">
              <input type="radio" name="interview_experience[overall_rating]" value="<%= rating %>" class="peer sr-only">
              <div class="w-10 h-10 rounded-lg border-2 border-gray-200 flex items-center justify-center text-sm font-bold text-gray-400 peer-checked:border-cyan-500 peer-checked:bg-cyan-50 peer-checked:text-cyan-600 transition-all">
                <%= rating %>
              </div>
            </label>
          <% end %>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 p-6 space-y-5">
      <h2 class="text-lg font-semibold text-gray-900">Your Experience</h2>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Summary</label>
        <textarea name="interview_experience[experience_summary]" rows="5" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 resize-y" placeholder="Describe your overall interview experience, what was asked, what went well, what didn't..."></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Round Details (one per line)</label>
        <textarea name="interview_experience[rounds_data]" rows="4" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 resize-y" placeholder="Round 1: Online coding test - 2 DSA problems
Round 2: Technical interview - System design
Round 3: Managerial round - Behavioral questions
Round 4: HR round - Salary discussion"></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Tags (comma separated)</label>
        <input type="text" name="interview_experience[tags]" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" placeholder="e.g., DSA, System Design, Behavioral, Live Coding">
      </div>
    </div>

    <div class="flex items-center gap-3 bg-green-50 rounded-xl p-4">
      <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
      <p class="text-xs text-green-700">Your submission is <strong>anonymous by default</strong>. Company name and experience will be shared, but your identity stays private.</p>
    </div>

    <div class="flex items-center justify-between">
      <%= link_to "Cancel", interview_experiences_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <button type="submit" class="px-8 py-3 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer">
        Share Experience
      </button>
    </div>
  <% end %>
</div>

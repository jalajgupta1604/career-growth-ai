<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="text-center mb-12">
    <h1 class="text-3xl font-bold text-gray-900">Go Pro</h1>
    <p class="mt-3 text-gray-500">Unlock full access to career reports, PDFs, and all Pro features.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8"
       data-controller="subscription"
       data-subscription-key-id-value="<%= ENV.fetch('RAZORPAY_KEY_ID', '') %>"
       data-subscription-user-name-value="<%= current_user.full_name %>"
       data-subscription-user-email-value="<%= current_user.email %>">
    <!-- Monthly -->
    <div class="bg-white rounded-2xl border-2 border-gray-200 p-8">
      <p class="text-sm font-semibold text-cyan-600 uppercase tracking-wide">Pro Monthly</p>
      <p class="mt-4 text-4xl font-bold text-gray-900">&#8377;499<span class="text-lg font-normal text-gray-400">/mo</span></p>
      <p class="mt-1 text-sm text-gray-400">Full access, cancel anytime</p>
      <div class="mt-8">
        <button data-action="click->subscription#subscribe"
                data-plan="monthly"
                class="w-full py-3 px-6 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 transition-colors cursor-pointer">
          Subscribe Monthly
        </button>
      </div>
    </div>
    <!-- Yearly -->
    <div class="bg-white rounded-2xl border-2 border-cyan-500 p-8 relative">
      <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-cyan-500 text-white text-xs font-bold px-3 py-1 rounded-full">SAVE 2 MONTHS</div>
      <p class="text-sm font-semibold text-cyan-600 uppercase tracking-wide">Pro Yearly</p>
      <p class="mt-4 text-4xl font-bold text-gray-900">&#8377;4,999<span class="text-lg font-normal text-gray-400">/yr</span></p>
      <p class="mt-1 text-sm text-cyan-600 font-medium">&#8377;417/mo effective price</p>
      <div class="mt-8">
        <button data-action="click->subscription#subscribe"
                data-plan="yearly"
                class="w-full py-3 px-6 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 transition-colors cursor-pointer">
          Subscribe Yearly
        </button>
      </div>
    </div>
  </div>

  <p class="mt-6 text-center text-xs text-gray-400">Secure payment via Razorpay. Cancel anytime from your subscription management page.</p>
</div>

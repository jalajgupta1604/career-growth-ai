<div class="min-h-screen bg-gray-950">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">Public API</h1>
      <p class="mt-1 text-sm text-gray-400">Manage API keys for programmatic access to Career Growth AI services</p>
    </div>

    <!-- Create New Key -->
    <div class="bg-gray-900 rounded-2xl border border-gray-800 p-6 mb-6">
      <h2 class="text-base font-semibold text-white mb-4">Create New API Key</h2>
      <%= form_with url: api_keys_path, method: :post, class: "flex items-end gap-3" do |f| %>
        <div class="flex-1">
          <label class="block text-sm font-medium text-gray-300 mb-1.5">Key Name</label>
          <input type="text" name="api_key[name]" required class="w-full px-4 py-2.5 bg-gray-800 border border-gray-700 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-colors" placeholder="e.g. Production Backend, Mobile App">
        </div>
        <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors whitespace-nowrap" data-turbo-submits-with="Creating...">
          <span class="material-symbols-outlined text-[20px]">key</span>
          Create Key
        </button>
      <% end %>
    </div>

    <!-- Flash notice for newly created key -->
    <% if flash[:notice]&.include?("Key:") %>
      <div class="bg-green-500/10 border border-green-500/20 rounded-xl p-4 mb-6">
        <div class="flex items-start gap-3">
          <span class="material-symbols-outlined text-green-400 text-[20px] mt-0.5">check_circle</span>
          <div>
            <p class="text-sm font-medium text-green-400">API key created successfully!</p>
            <p class="text-sm text-green-300 mt-1 font-mono break-all"><%= flash[:notice].sub("API key created! Key: ", "") %></p>
            <p class="text-xs text-green-400/60 mt-2">Copy this key now. For security, the full key won't be shown again.</p>
          </div>
        </div>
      </div>
    <% end %>

    <!-- API Keys List -->
    <div class="bg-gray-900 rounded-2xl border border-gray-800 overflow-hidden mb-8">
      <div class="px-6 py-4 border-b border-gray-800">
        <h2 class="text-base font-semibold text-white">Your API Keys</h2>
      </div>

      <% if @api_keys.any? %>
        <div class="divide-y divide-gray-800">
          <% @api_keys.each do |api_key| %>
            <div class="px-6 py-4 flex items-center justify-between">
              <div class="flex items-center gap-4 min-w-0">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center <%= api_key.active? ? 'bg-cyan-500/10' : 'bg-gray-800' %>">
                  <span class="material-symbols-outlined text-[20px] <%= api_key.active? ? 'text-cyan-400' : 'text-gray-600' %>">key</span>
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <h3 class="text-sm font-semibold text-white truncate"><%= api_key.name %></h3>
                    <span class="px-2 py-0.5 text-xs font-medium rounded-full <%= api_key.active? ? 'bg-green-500/10 text-green-400' : 'bg-red-500/10 text-red-400' %>">
                      <%= api_key.active? ? "Active" : "Inactive" %>
                    </span>
                  </div>
                  <div class="flex items-center gap-3 text-xs text-gray-500 mt-0.5">
                    <span class="font-mono"><%= api_key.key.present? ? "#{api_key.key[0..7]}#{'*' * 24}" : "—" %></span>
                    <% if api_key.respond_to?(:tier) && api_key.tier.present? %>
                      <span>&bull; Tier: <strong class="text-gray-400"><%= api_key.tier.titleize %></strong></span>
                    <% end %>
                    <% if api_key.respond_to?(:calls_count) %>
                      <span>&bull; <%= api_key.calls_count %><% if api_key.respond_to?(:rate_limit) && api_key.rate_limit.present? %>/<%= api_key.rate_limit %><% end %> calls</span>
                    <% end %>
                    <span>&bull; Created <%= time_ago_in_words(api_key.created_at) %> ago</span>
                  </div>
                </div>
              </div>
              <% if api_key.active? %>
                <%= button_to api_key_path(api_key), method: :delete, class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-red-400 bg-red-500/10 rounded-lg hover:bg-red-500/20 transition-colors", data: { turbo_confirm: "Deactivate this API key? This cannot be undone." } do %>
                  <span class="material-symbols-outlined text-[16px]">block</span>
                  Deactivate
                <% end %>
              <% else %>
                <span class="text-xs text-gray-600">Deactivated</span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="px-6 py-12 text-center">
          <div class="w-14 h-14 bg-cyan-500/10 rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="material-symbols-outlined text-cyan-400 text-[28px]">vpn_key</span>
          </div>
          <p class="text-sm text-gray-400">No API keys yet. Create one above to get started.</p>
        </div>
      <% end %>
    </div>

    <!-- API Documentation -->
    <div class="bg-gray-900 rounded-2xl border border-gray-800 p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-cyan-400 text-[20px]">menu_book</span>
        <h2 class="text-base font-semibold text-white">Quick Start</h2>
      </div>

      <div class="space-y-4">
        <div>
          <h3 class="text-sm font-medium text-gray-300 mb-2">Authentication</h3>
          <p class="text-sm text-gray-400 mb-2">Include your API key in the request header:</p>
          <div class="bg-gray-800 rounded-xl p-4 font-mono text-sm text-cyan-400 overflow-x-auto border border-gray-700">
            Authorization: Bearer YOUR_API_KEY
          </div>
        </div>

        <div>
          <h3 class="text-sm font-medium text-gray-300 mb-2">Example: Get Career Report</h3>
          <div class="bg-gray-800 rounded-xl p-4 font-mono text-sm text-gray-300 overflow-x-auto border border-gray-700">
            <span class="text-cyan-400">curl</span> -X GET https://api.careergrowth.ai/v1/career-report \<br>
            &nbsp;&nbsp;-H <span class="text-green-400">"Authorization: Bearer YOUR_API_KEY"</span> \<br>
            &nbsp;&nbsp;-H <span class="text-green-400">"Content-Type: application/json"</span>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-medium text-gray-300 mb-2">Example: Submit Interview Debrief</h3>
          <div class="bg-gray-800 rounded-xl p-4 font-mono text-sm text-gray-300 overflow-x-auto border border-gray-700">
            <span class="text-cyan-400">curl</span> -X POST https://api.careergrowth.ai/v1/interview-debriefs \<br>
            &nbsp;&nbsp;-H <span class="text-green-400">"Authorization: Bearer YOUR_API_KEY"</span> \<br>
            &nbsp;&nbsp;-H <span class="text-green-400">"Content-Type: application/json"</span> \<br>
            &nbsp;&nbsp;-d <span class="text-green-400">'{"company": "Acme", "role": "SWE", "questions": [...]}'</span>
          </div>
        </div>

        <div class="pt-2 border-t border-gray-800">
          <p class="text-xs text-gray-500">Rate limits depend on your subscription tier. API keys can be deactivated at any time but cannot be reactivated. Generate a new key if needed.</p>
        </div>
      </div>
    </div>
  </div>
</div>

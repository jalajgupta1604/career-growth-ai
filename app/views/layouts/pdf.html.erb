<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1f2937; line-height: 1.5; margin: 0; padding: 40px; background: #fff; font-size: 12px; }

    /* Clearfix */
    .clearfix:after { content: ""; display: table; clear: both; }

    /* Header */
    .pdf-header { padding-bottom: 16px; border-bottom: 3px solid #06b6d4; margin-bottom: 24px; }
    .pdf-header .logo-icon { display: inline-block; width: 28px; height: 28px; background: #06b6d4; border-radius: 6px; color: #fff; font-weight: bold; font-size: 16px; text-align: center; line-height: 28px; vertical-align: middle; margin-right: 8px; }
    .pdf-header .logo-text { display: inline-block; font-size: 18px; font-weight: 700; color: #111827; vertical-align: middle; }
    .pdf-header .date { float: right; font-size: 10px; color: #9ca3af; line-height: 28px; }

    /* Title */
    .pdf-title { margin-bottom: 20px; }
    .pdf-title h1 { font-size: 24px; font-weight: 800; color: #111827; margin-bottom: 4px; }
    .pdf-title p { font-size: 12px; color: #6b7280; }

    /* Section */
    .section { margin-bottom: 20px; }
    .section-title { font-size: 14px; font-weight: 700; color: #111827; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid #e5e7eb; }
    .section-title .dot { display: inline-block; width: 8px; height: 8px; background: #06b6d4; border-radius: 50%; margin-right: 6px; vertical-align: middle; }

    /* Stats table */
    .stats-table { width: 100%; border-collapse: separate; border-spacing: 8px 0; margin-bottom: 16px; }
    .stats-table td { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px; text-align: center; }
    .stat-label { font-size: 9px; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px; }
    .stat-value { font-size: 20px; font-weight: 800; }
    .color-primary { color: #06b6d4; }
    .color-danger { color: #dc2626; }
    .color-dark { color: #111827; }

    /* Progress bar */
    .progress-label { font-size: 10px; color: #9ca3af; margin-bottom: 4px; }
    .progress-bar { width: 100%; height: 8px; background: #f3f4f6; border-radius: 4px; }
    .progress-fill { height: 8px; background: #06b6d4; border-radius: 4px; }
    .progress-note { font-size: 10px; color: #9ca3af; margin-top: 4px; }

    /* Two column */
    .col-left { float: left; width: 48%; }
    .col-right { float: right; width: 48%; }

    /* Skill list */
    .skill-table { width: 100%; }
    .skill-table td { padding: 8px 0; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
    .skill-table tr:last-child td { border-bottom: none; }
    .skill-bullet { display: inline-block; width: 6px; height: 6px; background: #06b6d4; border-radius: 50%; margin-right: 8px; vertical-align: middle; }
    .skill-name { font-size: 12px; font-weight: 600; color: #111827; }
    .skill-tag { font-size: 10px; font-weight: 600; color: #16a34a; background: #f0fdf4; padding: 2px 8px; border-radius: 10px; white-space: nowrap; }

    /* Hack items */
    .hack-item { margin-bottom: 10px; }
    .hack-dot { display: inline-block; width: 6px; height: 6px; background: #06b6d4; border-radius: 50%; margin-right: 8px; vertical-align: top; margin-top: 5px; }
    .hack-text { display: inline-block; width: 90%; font-size: 11px; color: #4b5563; line-height: 1.5; vertical-align: top; }

    /* Roadmap */
    .roadmap-table { width: 100%; border-collapse: separate; border-spacing: 8px 0; }
    .roadmap-table td { background: #f9fafb; border-radius: 8px; padding: 12px; vertical-align: top; width: 25%; }
    .roadmap-badge { display: inline-block; width: 26px; height: 26px; border-radius: 50%; color: #fff; font-size: 9px; font-weight: 700; text-align: center; line-height: 26px; margin-bottom: 6px; }
    .roadmap-phase { font-size: 11px; font-weight: 700; color: #111827; margin-bottom: 2px; }
    .roadmap-desc { font-size: 10px; color: #6b7280; line-height: 1.4; }

    /* Certs */
    .cert-item { padding: 4px 0; font-size: 11px; color: #374151; }
    .cert-check { color: #06b6d4; font-weight: bold; margin-right: 6px; }

    /* Footer */
    .pdf-footer { margin-top: 24px; padding-top: 12px; border-top: 1px solid #e5e7eb; text-align: center; }
    .pdf-footer p { font-size: 9px; color: #9ca3af; margin-bottom: 2px; }

    /* Page break */
    .page-break { page-break-before: always; }
  </style>
</head>
<body>
  <%= yield %>
</body>
</html>

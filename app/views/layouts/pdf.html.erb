<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: 'Helvetica', sans-serif; color: #1a1a2e; line-height: 1.6; margin: 0; padding: 20px; }
    h1 { color: #4f46e5; font-size: 28px; border-bottom: 3px solid #4f46e5; padding-bottom: 10px; }
    h2 { color: #374151; font-size: 20px; margin-top: 30px; border-bottom: 1px solid #e5e7eb; padding-bottom: 8px; }
    h3 { color: #6b7280; font-size: 14px; text-transform: uppercase; letter-spacing: 1px; }
    .header { text-align: center; margin-bottom: 30px; }
    .header .logo { font-size: 32px; font-weight: bold; color: #4f46e5; }
    .stat-box { display: inline-block; width: 30%; text-align: center; padding: 15px; margin: 5px; background: #f9fafb; border-radius: 8px; }
    .stat-value { font-size: 24px; font-weight: bold; color: #4f46e5; }
    .stat-label { font-size: 12px; color: #6b7280; }
    .skill-item { padding: 8px 0; border-bottom: 1px solid #f3f4f6; }
    .milestone { margin: 15px 0; padding-left: 20px; border-left: 3px solid #4f46e5; }
    .footer { text-align: center; margin-top: 40px; font-size: 11px; color: #9ca3af; border-top: 1px solid #e5e7eb; padding-top: 15px; }
  </style>
</head>
<body>
  <%= yield %>
</body>
</html>

<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Career Growth AI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#06b6d4">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Career Growth AI">
    <link rel="manifest" href="/manifest.json">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-gray-50">
    <% if user_signed_in? && !controller_name.in?(%w[pages onboarding career_reports resumes sessions registrations interview_prep]) %>
      <nav class="bg-white border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between h-16">
            <div class="flex items-center">
              <%= link_to root_path, class: "flex items-center space-x-2" do %>
                <div class="w-7 h-7 bg-cyan-500 rounded-lg flex items-center justify-center">
                  <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                </div>
                <span class="text-lg font-bold text-gray-900">Career Growth AI</span>
              <% end %>
              <div class="ml-8 flex items-center space-x-4">
                <%= link_to "Dashboard", dashboard_path, class: "text-gray-500 hover:text-cyan-600 px-3 py-2 text-sm font-medium" %>
                <%= form_tag search_path, method: :get, class: "relative hidden sm:block" do %>
                  <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-base">search</span>
                  <%= text_field_tag :q, params[:q], placeholder: "Search...", class: "w-48 pl-8 pr-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent bg-gray-50" %>
                <% end %>
              </div>
            </div>
            <div class="flex items-center space-x-4">
              <%= link_to notifications_path, class: "relative text-gray-400 hover:text-cyan-600 transition-colors" do %>
                <span class="material-symbols-outlined text-xl">notifications</span>
                <% if current_user.unread_notifications_count > 0 %>
                  <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center"><%= [current_user.unread_notifications_count, 9].min %></span>
                <% end %>
              <% end %>
              <% if current_user.admin? %>
                <%= link_to admin_root_path, class: "text-gray-400 hover:text-cyan-600 transition-colors", title: "Admin Panel" do %>
                  <span class="material-symbols-outlined text-xl">admin_panel_settings</span>
                <% end %>
              <% end %>
              <%= link_to profile_path, class: "flex items-center gap-2 text-sm text-gray-500 hover:text-cyan-600 transition-colors" do %>
                <%= user_avatar(current_user, size: "w-7 h-7") %>
                <span class="font-medium"><%= current_user.full_name || current_user.email %></span>
              <% end %>
              <% if current_user.subscribed? %>
                <span class="inline-flex items-center px-2 py-0.5 bg-amber-400 text-amber-900 text-xs font-bold rounded-full shadow-sm">PRO</span>
              <% end %>
              <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "text-sm text-gray-400 hover:text-red-500" %>
            </div>
          </div>
        </div>
      </nav>
    <% end %>

    <% if notice.present? %>
      <div class="max-w-7xl mx-auto px-4 mt-4">
        <div class="bg-cyan-50 border border-cyan-200 text-cyan-700 px-4 py-3 rounded-lg text-sm"><%= notice %></div>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="max-w-7xl mx-auto px-4 mt-4">
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"><%= alert %></div>
      </div>
    <% end %>

    <main>
      <%= yield %>
    </main>
  </body>
</html>

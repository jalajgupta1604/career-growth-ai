<!DOCTYPE html>
<html class="h-full">
  <head>
    <title>Hire with Career Growth AI — Employer Platform</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="icon" href="/icon.png" type="image/png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-white">
    <!-- Minimal top bar -->
    <nav class="border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <%= link_to employer_landing_path, class: "flex items-center gap-2.5" do %>
              <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center">
                <span class="material-symbols-outlined text-white text-lg">business_center</span>
              </div>
              <div class="flex items-baseline gap-1.5">
                <span class="text-lg font-bold text-gray-900">Career Growth AI</span>
                <span class="text-xs font-semibold text-indigo-600 bg-indigo-50 px-1.5 py-0.5 rounded">for Employers</span>
              </div>
            <% end %>
          </div>
          <div class="flex items-center gap-4">
            <% if user_signed_in? %>
              <% if current_user.employer_profile.present? %>
                <%= link_to "Go to Dashboard", employer_root_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-700" %>
              <% else %>
                <%= link_to "Set Up Company", employer_onboarding_path, class: "px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition" %>
              <% end %>
            <% else %>
              <%= link_to "Sign In", employer_login_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
              <%= link_to "Get Started", employer_login_path, class: "px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice.present? %>
      <div class="max-w-7xl mx-auto px-4 mt-4">
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm"><%= notice %></div>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="max-w-7xl mx-auto px-4 mt-4">
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"><%= alert %></div>
      </div>
    <% end %>

    <main>
      <%= yield %>
    </main>
  </body>
</html>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-1">
        <span class="material-symbols-outlined text-cyan-500 text-[32px]">receipt_long</span>
        <h1 class="text-3xl font-bold text-gray-900">Billing & Invoices</h1>
      </div>
      <p class="mt-1 text-sm text-gray-500">View your payment history and download invoices.</p>
    </div>

    <% if @invoices.present? %>
      <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-gray-100">
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wide">Invoice #</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wide">Amount</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wide">Tax</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wide">Total</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wide">Status</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wide">Date</th>
                <th class="px-6 py-3 text-right text-xs font-semibold text-gray-400 uppercase tracking-wide"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              <% @invoices.each do |invoice| %>
                <tr class="hover:bg-gray-50/50 transition-colors">
                  <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= invoice.invoice_number %></td>
                  <td class="px-6 py-4 text-sm text-gray-600">&#8377;<%= number_with_delimiter(invoice.amount) %></td>
                  <td class="px-6 py-4 text-sm text-gray-600">&#8377;<%= number_with_delimiter(invoice.tax) %></td>
                  <td class="px-6 py-4 text-sm font-semibold text-gray-900">&#8377;<%= number_with_delimiter(invoice.total) %></td>
                  <td class="px-6 py-4">
                    <span class="px-2.5 py-1 text-xs font-medium rounded-full
                      <%= case invoice.status
                          when 'paid' then 'bg-green-50 text-green-600 border border-green-200'
                          when 'pending' then 'bg-amber-50 text-amber-600 border border-amber-200'
                          when 'failed' then 'bg-red-50 text-red-600 border border-red-200'
                          else 'bg-gray-50 text-gray-600 border border-gray-200'
                          end %>">
                      <%= invoice.status.capitalize %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= invoice.created_at.strftime("%b %d, %Y") %></td>
                  <td class="px-6 py-4 text-right">
                    <%= link_to invoice_path(invoice), class: "inline-flex items-center gap-1 text-sm text-cyan-600 hover:text-cyan-700 font-medium" do %>
                      View
                      <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% else %>
      <div class="bg-white rounded-2xl border border-gray-100 p-16 text-center">
        <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="material-symbols-outlined text-gray-400 text-[32px]">receipt_long</span>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">No invoices yet</h3>
        <p class="text-sm text-gray-500">Your payment history will appear here once you make a purchase.</p>
      </div>
    <% end %>

    <div class="mt-8 text-center">
      <%= link_to "Back to Dashboard", dashboard_path, class: "text-sm text-cyan-600 font-medium hover:text-cyan-700" %>
    </div>
  </div>
</div>

<div class="min-h-screen bg-gray-950">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <%# Header %>
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-1">
        <span class="material-symbols-outlined text-cyan-400 text-[32px]">forum</span>
        <h1 class="text-3xl font-bold text-white">Community</h1>
      </div>
      <p class="mt-1 text-sm text-gray-400">Share milestones, ask questions, and learn from fellow professionals</p>
    </div>

    <%# Filter Tabs %>
    <div class="flex flex-wrap gap-2 mb-8">
      <% filters = [
        { key: nil, label: "All" },
        { key: "milestone", label: "Milestones" },
        { key: "job_switch", label: "Job Switches" },
        { key: "learning", label: "Learning" },
        { key: "question", label: "Questions" }
      ] %>
      <% filters.each do |f| %>
        <%= link_to community_index_path(filter: f[:key]),
          class: "px-4 py-2 text-sm font-medium rounded-full transition-colors #{@filter == f[:key] ? 'bg-cyan-500 text-white' : 'bg-gray-900 text-gray-400 border border-gray-800 hover:border-gray-700 hover:text-gray-300'}" do %>
          <%= f[:label] %>
        <% end %>
      <% end %>
    </div>

    <%# Share Something Form %>
    <div class="bg-gray-900 rounded-2xl border border-gray-800 p-6 mb-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-cyan-400 text-[20px]">add_circle</span>
        <h2 class="text-lg font-semibold text-white">Share Something</h2>
      </div>

      <%= form_with url: community_index_path, method: :post, class: "space-y-4", data: { controller: "loading-button", loading_button_text_value: "Posting...", action: "submit->loading-button#submit" } do |f| %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-400 mb-1">Post Type</label>
            <select name="community_post[post_type]" class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-sm text-white focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
              <option value="milestone">Milestone</option>
              <option value="job_switch">Job Switch</option>
              <option value="learning">Learning</option>
              <option value="question">Question</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-400 mb-1">Title</label>
            <%= f.text_field :title, name: "community_post[title]", class: "w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500", placeholder: "Give your post a title" %>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-400 mb-1">Content</label>
          <%= f.text_area :content, name: "community_post[content]", rows: 3, class: "w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 resize-none", placeholder: "Share your experience, ask a question, or celebrate a win..." %>
        </div>

        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 cursor-pointer">
            <%= f.check_box :anonymous, name: "community_post[anonymous]", class: "w-4 h-4 rounded border-gray-700 bg-gray-800 text-cyan-500 focus:ring-cyan-500 focus:ring-offset-0" %>
            <span class="text-sm text-gray-400">Post anonymously</span>
          </label>

          <button type="submit" data-loading-button-target="button" class="inline-flex items-center gap-2 px-6 py-2.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer">
            <span class="material-symbols-outlined text-[20px]">add_circle</span>
            Share Post
          </button>
        </div>
      <% end %>
    </div>

    <%# Feed %>
    <% if @posts.present? %>
      <div class="space-y-4">
        <% @posts.each do |post| %>
          <div class="bg-gray-900 rounded-2xl border border-gray-800 p-6 hover:border-gray-700 transition-all">
            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center">
                  <span class="material-symbols-outlined text-gray-400 text-[20px]">person</span>
                </div>
                <div>
                  <p class="text-sm font-medium text-white"><%= post.display_author %></p>
                  <p class="text-xs text-gray-500"><%= time_ago_in_words(post.created_at) %> ago</p>
                </div>
              </div>
              <span class="px-2.5 py-1 text-xs font-medium rounded-full
                <%= case post.post_type
                    when 'milestone' then 'bg-green-900/50 text-green-400 border border-green-800'
                    when 'job_switch' then 'bg-blue-900/50 text-blue-400 border border-blue-800'
                    when 'learning' then 'bg-purple-900/50 text-purple-400 border border-purple-800'
                    when 'question' then 'bg-yellow-900/50 text-yellow-400 border border-yellow-800'
                    else 'bg-gray-800 text-gray-400 border border-gray-700'
                    end %>">
                <%= post.post_type.humanize %>
              </span>
            </div>

            <h3 class="text-base font-bold text-white mb-1"><%= post.title %></h3>
            <p class="text-sm text-gray-400 leading-relaxed mb-4"><%= post.content %></p>

            <div class="flex items-center gap-4 pt-3 border-t border-gray-800">
              <%= button_to like_community_path(post), method: :post, class: "inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-cyan-400 transition-colors cursor-pointer" do %>
                <span class="material-symbols-outlined text-[18px]">thumb_up</span>
                <span><%= post.likes_count %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-gray-900 rounded-2xl border border-gray-800 p-16 text-center">
        <div class="w-16 h-16 bg-gray-800 rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="material-symbols-outlined text-cyan-400 text-[32px]">forum</span>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">No posts yet</h3>
        <p class="text-sm text-gray-400 mb-6">Be the first to share something with the community. Your journey can inspire others!</p>
      </div>
    <% end %>

  </div>
</div>

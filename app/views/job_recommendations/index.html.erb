<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Job Recommendations</h1>
      <p class="mt-1 text-gray-500">AI-powered job matches based on your profile</p>
    </div>
    <%= button_to "Generate New Matches", generate_job_recommendations_path, method: :post, class: "px-4 py-2 bg-cyan-500 text-white text-sm font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer" %>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-2xl border border-gray-100 p-4 text-center">
      <p class="text-2xl font-bold text-gray-900"><%= @data[:total_count] %></p>
      <p class="text-xs text-gray-500">Total Matches</p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 p-4 text-center">
      <p class="text-2xl font-bold text-cyan-600"><%= @data[:new_count] %></p>
      <p class="text-xs text-gray-500">New</p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 p-4 text-center">
      <p class="text-2xl font-bold text-amber-600"><%= @data[:saved_count] %></p>
      <p class="text-xs text-gray-500">Saved</p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 p-4 text-center">
      <p class="text-2xl font-bold text-green-600"><%= @data[:applied_count] %></p>
      <p class="text-xs text-gray-500">Applied</p>
    </div>
  </div>

  <!-- Top Match -->
  <% if @data[:top_match] %>
    <% top = @data[:top_match] %>
    <div class="bg-gradient-to-r from-cyan-500 to-cyan-600 rounded-2xl p-6 mb-6 text-white">
      <p class="text-xs font-semibold uppercase tracking-wide opacity-80 mb-1">Best Match</p>
      <h2 class="text-xl font-bold"><%= top.job_listing.title %></h2>
      <p class="text-sm opacity-90"><%= top.job_listing.company_name %> &middot; <%= top.job_listing.location %></p>
      <div class="flex items-center gap-4 mt-3">
        <span class="px-3 py-1 bg-white/20 rounded-full text-sm font-semibold"><%= top.match_percentage %>% match</span>
        <% if top.job_listing.salary_range_text.present? %>
          <span class="text-sm opacity-90"><%= top.job_listing.salary_range_text %></span>
        <% end %>
      </div>
      <%= link_to "View Details", job_recommendation_path(top), class: "mt-3 inline-block text-sm font-semibold underline" %>
    </div>
  <% end %>

  <!-- All Recommendations -->
  <div class="space-y-4">
    <% @data[:recommendations].each do |rec| %>
      <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-1">
              <h3 class="text-base font-semibold text-gray-900"><%= rec.job_listing.title %></h3>
              <span class="px-2 py-0.5 text-xs font-bold rounded-full
                <% if rec.match_percentage >= 80 %>bg-green-100 text-green-700
                <% elsif rec.match_percentage >= 60 %>bg-cyan-100 text-cyan-700
                <% else %>bg-gray-100 text-gray-600<% end %>">
                <%= rec.match_percentage %>% match
              </span>
              <% if rec.status == "saved" %>
                <span class="px-2 py-0.5 text-xs font-bold bg-amber-100 text-amber-700 rounded-full">Saved</span>
              <% elsif rec.status == "applied" %>
                <span class="px-2 py-0.5 text-xs font-bold bg-green-100 text-green-700 rounded-full">Applied</span>
              <% end %>
            </div>
            <p class="text-sm text-gray-500"><%= rec.job_listing.company_name %> &middot; <%= rec.job_listing.location %> &middot; <%= rec.job_listing.job_type&.humanize %></p>
            <% if rec.job_listing.salary_range_text.present? %>
              <p class="text-sm font-medium text-gray-700 mt-1"><%= rec.job_listing.salary_range_text %></p>
            <% end %>
            <% if rec.match_reasons.present? %>
              <div class="flex flex-wrap gap-2 mt-2">
                <% (rec.match_reasons || []).each do |reason| %>
                  <span class="text-xs text-gray-500 bg-gray-50 px-2 py-0.5 rounded"><%= reason %></span>
                <% end %>
              </div>
            <% end %>
          </div>
          <div class="flex items-center gap-2 ml-4">
            <% unless rec.status == "saved" %>
              <%= button_to "Save", save_job_recommendation_path(rec), method: :post, class: "px-3 py-1.5 text-xs font-semibold text-cyan-600 border border-cyan-200 rounded-lg hover:bg-cyan-50 transition-colors cursor-pointer" %>
            <% end %>
            <%= link_to "Details", job_recommendation_path(rec), class: "px-3 py-1.5 text-xs font-semibold text-white bg-cyan-500 rounded-lg hover:bg-cyan-600 transition-colors" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @data[:recommendations].empty? %>
    <div class="bg-white rounded-2xl border border-gray-100 p-12 text-center">
      <div class="w-16 h-16 bg-cyan-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">No Recommendations Yet</h3>
      <p class="text-sm text-gray-500 mb-6">Click "Generate New Matches" to get AI-powered job recommendations tailored to your profile.</p>
    </div>
  <% end %>
</div>

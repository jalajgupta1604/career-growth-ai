<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to "&larr; Back to Recommendations".html_safe, job_recommendations_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <% listing = @recommendation.job_listing %>

  <div class="bg-white rounded-2xl border border-gray-100 p-8 mb-6">
    <div class="flex items-start justify-between mb-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= listing.title %></h1>
        <p class="text-base text-gray-500 mt-1"><%= listing.company_name %></p>
      </div>
      <span class="px-4 py-2 text-sm font-bold rounded-xl
        <% if @recommendation.match_percentage >= 80 %>bg-green-100 text-green-700
        <% elsif @recommendation.match_percentage >= 60 %>bg-cyan-100 text-cyan-700
        <% else %>bg-gray-100 text-gray-600<% end %>">
        <%= @recommendation.match_percentage %>% Match
      </span>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div>
        <p class="text-xs text-gray-400">Location</p>
        <p class="text-sm font-medium text-gray-900"><%= listing.location || "Not specified" %></p>
      </div>
      <div>
        <p class="text-xs text-gray-400">Job Type</p>
        <p class="text-sm font-medium text-gray-900"><%= listing.job_type&.humanize || "Full Time" %></p>
      </div>
      <div>
        <p class="text-xs text-gray-400">Experience</p>
        <p class="text-sm font-medium text-gray-900"><%= listing.experience_range || "Not specified" %> years</p>
      </div>
      <div>
        <p class="text-xs text-gray-400">Salary Range</p>
        <p class="text-sm font-medium text-gray-900"><%= listing.salary_range_text.presence || "Not disclosed" %></p>
      </div>
    </div>

    <% if listing.description.present? %>
      <div class="mb-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-2">Description</h3>
        <p class="text-sm text-gray-600 leading-relaxed"><%= listing.description %></p>
      </div>
    <% end %>

    <!-- Match Reasons -->
    <% if @recommendation.match_reasons.present? %>
      <div class="mb-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-2">Why This Matches</h3>
        <div class="space-y-2">
          <% (@recommendation.match_reasons || []).each do |reason| %>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <p class="text-sm text-gray-600"><%= reason %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Skills -->
    <% skill_matches = @recommendation.skill_matches || {} %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-2">Matched Skills</h3>
        <div class="flex flex-wrap gap-2">
          <% (skill_matches["matched"] || skill_matches[:matched] || []).each do |skill| %>
            <span class="px-2.5 py-1 bg-green-50 text-green-700 border border-green-100 rounded-md text-xs font-medium"><%= skill %></span>
          <% end %>
          <% if (skill_matches["matched"] || skill_matches[:matched] || []).empty? %>
            <p class="text-sm text-gray-400">None detected</p>
          <% end %>
        </div>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-2">Skills to Learn</h3>
        <div class="flex flex-wrap gap-2">
          <% (skill_matches["missing"] || skill_matches[:missing] || []).each do |skill| %>
            <span class="px-2.5 py-1 bg-red-50 text-red-700 border border-red-100 rounded-md text-xs font-medium"><%= skill %></span>
          <% end %>
          <% if (skill_matches["missing"] || skill_matches[:missing] || []).empty? %>
            <p class="text-sm text-gray-400">None — you're fully qualified!</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
      <% unless @recommendation.status == "applied" %>
        <%= button_to "Mark as Applied", apply_job_recommendation_path(@recommendation), method: :post, class: "px-4 py-2 bg-green-500 text-white text-sm font-semibold rounded-lg hover:bg-green-600 transition-colors cursor-pointer" %>
      <% else %>
        <span class="px-4 py-2 bg-green-100 text-green-700 text-sm font-semibold rounded-lg">Applied</span>
      <% end %>
      <% unless @recommendation.status == "saved" %>
        <%= button_to "Save Job", save_job_recommendation_path(@recommendation), method: :post, class: "px-4 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition-colors cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>

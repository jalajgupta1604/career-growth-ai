<% content_for :page_title, "Analytics & BI" %>

<!-- Stats Row -->
<div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total Users</span>
      <div class="w-8 h-8 bg-cyan-50 rounded-lg flex items-center justify-center">
        <span class="material-symbols-outlined text-cyan-600 text-lg">group</span>
      </div>
    </div>
    <p class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(@stats[:total_users]) %></p>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">Active Users</span>
      <div class="w-8 h-8 bg-blue-50 rounded-lg flex items-center justify-center">
        <span class="material-symbols-outlined text-blue-600 text-lg">person</span>
      </div>
    </div>
    <p class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(@stats[:active_users]) %></p>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">Subscribers</span>
      <div class="w-8 h-8 bg-amber-50 rounded-lg flex items-center justify-center">
        <span class="material-symbols-outlined text-amber-600 text-lg">star</span>
      </div>
    </div>
    <p class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(@stats[:subscribers]) %></p>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">MRR</span>
      <div class="w-8 h-8 bg-green-50 rounded-lg flex items-center justify-center">
        <span class="material-symbols-outlined text-green-600 text-lg">payments</span>
      </div>
    </div>
    <p class="text-2xl font-bold text-green-600"><%= number_to_currency(@stats[:mrr], unit: "\u20B9", precision: 0) %></p>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">DAU/MAU</span>
      <div class="w-8 h-8 bg-purple-50 rounded-lg flex items-center justify-center">
        <span class="material-symbols-outlined text-purple-600 text-lg">trending_up</span>
      </div>
    </div>
    <p class="text-2xl font-bold text-purple-600"><%= @stats[:dau_mau_ratio] %>%</p>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">Churn Rate</span>
      <div class="w-8 h-8 bg-red-50 rounded-lg flex items-center justify-center">
        <span class="material-symbols-outlined text-red-600 text-lg">person_off</span>
      </div>
    </div>
    <p class="text-2xl font-bold text-red-600"><%= @stats[:churn_rate] %>%</p>
  </div>
</div>

<!-- Conversion Funnel & Top Features -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
  <!-- Conversion Funnel -->
  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <div class="flex items-center gap-2 mb-6">
      <span class="material-symbols-outlined text-gray-400">filter_alt</span>
      <h3 class="text-sm font-semibold text-gray-900">Conversion Funnel</h3>
    </div>

    <% if @stats[:conversion_funnel].present? %>
      <% max_count = @stats[:conversion_funnel].map { |s| s[:count] }.max.to_f %>
      <div class="space-y-3">
        <% @stats[:conversion_funnel].each_with_index do |step, index| %>
          <div>
            <div class="flex items-center justify-between text-sm mb-1">
              <span class="font-medium text-gray-700"><%= step[:step] %></span>
              <span class="text-gray-500"><%= number_with_delimiter(step[:count]) %></span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-6 relative overflow-hidden">
              <% width = max_count > 0 ? (step[:count].to_f / max_count * 100).round : 0 %>
              <div class="h-6 rounded-full bg-gradient-to-r from-cyan-500 to-cyan-400 transition-all" style="width: <%= width %>%"></div>
            </div>
            <% if index > 0 %>
              <% prev_count = @stats[:conversion_funnel][index - 1][:count].to_f %>
              <% drop_off = prev_count > 0 ? ((1 - step[:count].to_f / prev_count) * 100).round(1) : 0 %>
              <p class="text-xs text-red-500 mt-0.5 text-right">
                <span class="material-symbols-outlined text-xs align-middle">arrow_downward</span>
                <%= drop_off %>% drop-off
              </p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-8 text-center text-sm text-gray-400">No funnel data available</div>
    <% end %>
  </div>

  <!-- Top Features -->
  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <div class="flex items-center gap-2 mb-6">
      <span class="material-symbols-outlined text-gray-400">bar_chart</span>
      <h3 class="text-sm font-semibold text-gray-900">Top Features</h3>
    </div>

    <% if @stats[:top_features].present? %>
      <% max_feature_count = @stats[:top_features].values.max.to_f %>
      <div class="space-y-3">
        <% @stats[:top_features].sort_by { |_, v| -v }.each_with_index do |(feature, count), index| %>
          <% colors = ["bg-cyan-500", "bg-blue-500", "bg-purple-500", "bg-amber-500", "bg-green-500", "bg-red-400", "bg-indigo-500", "bg-pink-500"] %>
          <div>
            <div class="flex items-center justify-between text-sm mb-1">
              <span class="text-gray-700"><%= feature.to_s.humanize %></span>
              <span class="font-medium text-gray-900"><%= number_with_delimiter(count) %></span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-3">
              <% width = max_feature_count > 0 ? (count.to_f / max_feature_count * 100).round : 0 %>
              <div class="h-3 rounded-full <%= colors[index % colors.length] %> transition-all" style="width: <%= width %>%"></div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-8 text-center text-sm text-gray-400">No feature usage data available</div>
    <% end %>
  </div>
</div>

<!-- Cohort Retention Heatmap -->
<div class="bg-white rounded-xl border border-gray-200 p-6 mb-8">
  <div class="flex items-center gap-2 mb-6">
    <span class="material-symbols-outlined text-gray-400">grid_on</span>
    <h3 class="text-sm font-semibold text-gray-900">Cohort Retention</h3>
  </div>

  <% if @stats[:cohorts].present? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr>
            <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Cohort</th>
            <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Size</th>
            <% max_periods = @stats[:cohorts].map { |c| c[:retention].length }.max || 0 %>
            <% max_periods.times do |i| %>
              <th class="px-3 py-2 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">M<%= i + 1 %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% @stats[:cohorts].each do |cohort| %>
            <tr>
              <td class="px-3 py-2 font-medium text-gray-700 whitespace-nowrap"><%= cohort[:month] %></td>
              <td class="px-3 py-2 text-gray-500"><%= number_with_delimiter(cohort[:size]) %></td>
              <% cohort[:retention].each do |pct| %>
                <%
                  bg_class = if pct > 80
                    "bg-green-500 text-white"
                  elsif pct > 50
                    "bg-yellow-400 text-gray-900"
                  else
                    "bg-red-500 text-white"
                  end
                %>
                <td class="px-1 py-1 text-center">
                  <div class="rounded px-2 py-1.5 text-xs font-semibold <%= bg_class %>">
                    <%= pct %>%
                  </div>
                </td>
              <% end %>
              <% (max_periods - cohort[:retention].length).times do %>
                <td class="px-1 py-1 text-center">
                  <div class="rounded px-2 py-1.5 text-xs text-gray-300">&mdash;</div>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="flex items-center gap-4 mt-4 text-xs text-gray-500">
      <span class="flex items-center gap-1"><span class="inline-block w-3 h-3 rounded bg-green-500"></span> &gt;80%</span>
      <span class="flex items-center gap-1"><span class="inline-block w-3 h-3 rounded bg-yellow-400"></span> 51&ndash;80%</span>
      <span class="flex items-center gap-1"><span class="inline-block w-3 h-3 rounded bg-red-500"></span> &le;50%</span>
    </div>
  <% else %>
    <div class="py-8 text-center text-sm text-gray-400">No cohort data available</div>
  <% end %>
</div>

<!-- Revenue Forecast -->
<div class="bg-white rounded-xl border border-gray-200 p-6">
  <div class="flex items-center gap-2 mb-6">
    <span class="material-symbols-outlined text-gray-400">show_chart</span>
    <h3 class="text-sm font-semibold text-gray-900">Revenue Forecast</h3>
  </div>

  <% if @revenue_forecast.present? %>
    <% max_mrr = @revenue_forecast.map { |f| f[:projected_mrr] }.max.to_f %>
    <div class="flex items-end gap-2" style="height: 200px;">
      <% @revenue_forecast.each do |forecast| %>
        <div class="flex-1 flex flex-col items-center justify-end h-full">
          <span class="text-xs font-semibold text-gray-700 mb-1">
            <%= number_to_currency(forecast[:projected_mrr], unit: "\u20B9", precision: 0, format: "%u%n") %>
          </span>
          <% height = max_mrr > 0 ? (forecast[:projected_mrr].to_f / max_mrr * 100).round : 0 %>
          <div class="w-full bg-gradient-to-t from-cyan-600 to-cyan-400 rounded-t-lg transition-all" style="height: <%= height %>%"></div>
          <span class="text-xs text-gray-500 mt-2 whitespace-nowrap"><%= forecast[:month] %></span>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="py-8 text-center text-sm text-gray-400">No forecast data available</div>
  <% end %>
</div>

<!-- Search Analytics & Trending -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-8">
  <!-- Popular Searches -->
  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <div class="flex items-center gap-2 mb-4">
      <span class="material-symbols-outlined text-gray-400">search</span>
      <h3 class="text-sm font-semibold text-gray-900">Popular Searches</h3>
    </div>
    <% if @popular_searches.any? %>
      <div class="space-y-2">
        <% @popular_searches.first(10).each do |query, count| %>
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-700"><%= query %></span>
            <span class="font-medium text-gray-500"><%= count %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-6 text-center text-sm text-gray-400">No search data yet</div>
    <% end %>
  </div>

  <!-- Zero-Result Searches (Content Gaps) -->
  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <div class="flex items-center gap-2 mb-4">
      <span class="material-symbols-outlined text-gray-400">search_off</span>
      <h3 class="text-sm font-semibold text-gray-900">Content Gaps (Zero Results)</h3>
    </div>
    <% if @zero_result_searches.any? %>
      <div class="space-y-2">
        <% @zero_result_searches.each do |query, count| %>
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-700"><%= query %></span>
            <span class="font-medium text-red-500"><%= count %> searches</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-6 text-center text-sm text-gray-400">No zero-result queries</div>
    <% end %>
  </div>
</div>

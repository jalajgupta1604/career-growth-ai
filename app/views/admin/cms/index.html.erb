<% content_for :page_title, "Content Management" %>

<!-- Header with filter tabs and create button -->
<div class="flex items-center justify-between mb-6">
  <div class="flex items-center gap-1 bg-white rounded-lg border border-gray-200 p-1">
    <%
      filter_tabs = [
        ["All", nil],
        ["Lessons", "lesson"],
        ["Company Packs", "company_pack"],
        ["Challenges", "challenge"],
        ["Skill Trends", "skill_trend"]
      ]
    %>
    <% filter_tabs.each do |label, type| %>
      <% active = params[:type] == type %>
      <%= link_to label,
            admin_cms_index_path(type: type),
            class: "px-3 py-1.5 text-sm font-medium rounded-md transition #{active ? 'bg-cyan-600 text-white shadow-sm' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}" %>
    <% end %>
  </div>

  <%= link_to new_admin_cm_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-cyan-600 text-white text-sm font-medium rounded-lg hover:bg-cyan-700 transition" do %>
    <span class="material-symbols-outlined text-lg">add</span>
    Create New
  <% end %>
</div>

<!-- Content Table -->
<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
  <table class="w-full">
    <thead class="bg-gray-50 border-b border-gray-200">
      <tr>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Title</th>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Type</th>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Author</th>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Published</th>
        <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @contents.each do |content| %>
        <tr class="hover:bg-gray-50 transition">
          <td class="px-5 py-3">
            <div>
              <p class="text-sm font-medium text-gray-900"><%= content.title %></p>
              <p class="text-xs text-gray-400 mt-0.5"><%= content.slug %></p>
            </div>
          </td>
          <td class="px-5 py-3">
            <%
              type_colors = {
                "lesson" => "bg-blue-100 text-blue-700",
                "company_pack" => "bg-purple-100 text-purple-700",
                "challenge" => "bg-amber-100 text-amber-700",
                "skill_trend" => "bg-cyan-100 text-cyan-700"
              }
              color_class = type_colors[content.content_type] || "bg-gray-100 text-gray-600"
            %>
            <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium rounded-full <%= color_class %>">
              <%= content.content_type.humanize %>
            </span>
          </td>
          <td class="px-5 py-3">
            <%
              status_colors = {
                "draft" => "bg-gray-100 text-gray-600",
                "published" => "bg-green-100 text-green-700",
                "archived" => "bg-red-100 text-red-700"
              }
              status_class = status_colors[content.status] || "bg-gray-100 text-gray-600"
            %>
            <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium rounded-full <%= status_class %>">
              <%= content.status.capitalize %>
            </span>
          </td>
          <td class="px-5 py-3 text-sm text-gray-500"><%= content.author %></td>
          <td class="px-5 py-3 text-sm text-gray-500">
            <%= content.published_at ? content.published_at.strftime("%b %d, %Y") : "—" %>
          </td>
          <td class="px-5 py-3 text-right">
            <div class="flex items-center justify-end gap-3">
              <%= link_to edit_admin_cm_path(content), class: "text-sm text-cyan-600 hover:text-cyan-700 font-medium" do %>
                <span class="material-symbols-outlined text-lg">edit</span>
              <% end %>
              <% if content.status == "draft" || content.status == "archived" %>
                <%= button_to publish_admin_cm_path(content), method: :post, class: "text-sm text-green-600 hover:text-green-700 font-medium", title: "Publish" do %>
                  <span class="material-symbols-outlined text-lg">publish</span>
                <% end %>
              <% end %>
              <% if content.status == "published" %>
                <%= button_to archive_admin_cm_path(content), method: :post, class: "text-sm text-red-500 hover:text-red-600 font-medium", title: "Archive" do %>
                  <span class="material-symbols-outlined text-lg">archive</span>
                <% end %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>

      <% if @contents.empty? %>
        <tr>
          <td colspan="6" class="px-5 py-16 text-center">
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-3xl text-gray-400">edit_note</span>
              </div>
              <p class="text-sm font-medium text-gray-900">No content yet</p>
              <p class="text-sm text-gray-400 mt-1">Get started by creating your first piece of content.</p>
              <%= link_to new_admin_cm_path, class: "mt-4 inline-flex items-center gap-2 px-4 py-2 bg-cyan-600 text-white text-sm font-medium rounded-lg hover:bg-cyan-700 transition" do %>
                <span class="material-symbols-outlined text-lg">add</span>
                Create Content
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

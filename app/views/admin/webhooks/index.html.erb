<% content_for :page_title, "Webhook Subscriptions" %>

<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
  <table class="w-full">
    <thead class="bg-gray-50 border-b border-gray-200">
      <tr>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">User</th>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">URL</th>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Events</th>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Failures</th>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Last Triggered</th>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Created</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @webhooks.each do |webhook| %>
        <tr class="hover:bg-gray-50 transition">
          <td class="px-5 py-3 text-sm text-gray-900"><%= webhook.user&.email || "—" %></td>
          <td class="px-5 py-3">
            <span class="text-sm text-gray-700 font-mono break-all"><%= truncate(webhook.url, length: 50) %></span>
          </td>
          <td class="px-5 py-3">
            <div class="flex flex-wrap gap-1">
              <% Array(webhook.events).each do |event| %>
                <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium rounded-full bg-blue-100 text-blue-700"><%= event %></span>
              <% end %>
            </div>
          </td>
          <td class="px-5 py-3">
            <% if webhook.active? %>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 text-green-700">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                Active
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-500">
                <span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span>
                Inactive
              </span>
            <% end %>
          </td>
          <td class="px-5 py-3">
            <% if webhook.failure_count > 0 %>
              <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium rounded-full bg-red-100 text-red-700"><%= webhook.failure_count %></span>
            <% else %>
              <span class="text-sm text-gray-400">0</span>
            <% end %>
          </td>
          <td class="px-5 py-3 text-sm text-gray-500">
            <%= webhook.last_triggered_at ? time_ago_in_words(webhook.last_triggered_at) + " ago" : "Never" %>
          </td>
          <td class="px-5 py-3 text-sm text-gray-500"><%= webhook.created_at.strftime("%b %d, %Y") %></td>
        </tr>
      <% end %>

      <% if @webhooks.empty? %>
        <tr>
          <td colspan="7" class="px-5 py-16 text-center">
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-3xl text-gray-400">webhook</span>
              </div>
              <p class="text-sm font-medium text-gray-900">No webhook subscriptions</p>
              <p class="text-sm text-gray-400 mt-1">Webhook subscriptions created by users will appear here.</p>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

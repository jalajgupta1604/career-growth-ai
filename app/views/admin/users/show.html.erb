<% content_for :page_title, "User Details" %>

<div class="mb-4">
  <%= link_to admin_users_path, class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-cyan-600 transition" do %>
    <span class="material-symbols-outlined text-base">arrow_back</span> Back to Users
  <% end %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Profile Card -->
  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <div class="text-center mb-4">
      <div class="w-16 h-16 rounded-full bg-cyan-100 flex items-center justify-center text-xl font-bold text-cyan-700 mx-auto">
        <%= @user.full_name&.first&.upcase || @user.email.first.upcase %>
      </div>
      <h3 class="text-lg font-bold text-gray-900 mt-3"><%= @user.full_name || "—" %></h3>
      <p class="text-sm text-gray-400"><%= @user.email %></p>
    </div>

    <div class="space-y-3 text-sm border-t border-gray-100 pt-4">
      <div class="flex justify-between">
        <span class="text-gray-500">Role</span>
        <span class="font-medium text-gray-900"><%= @user.role || "—" %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-500">City</span>
        <span class="font-medium text-gray-900"><%= @user.city || "—" %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-500">Experience</span>
        <span class="font-medium text-gray-900"><%= @user.experience_years ? "#{@user.experience_years} years" : "—" %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-500">Joined</span>
        <span class="font-medium text-gray-900"><%= @user.created_at.strftime("%b %d, %Y") %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-500">Status</span>
        <% if @user.subscribed? %>
          <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium rounded-full bg-amber-100 text-amber-700">PRO</span>
        <% else %>
          <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-500">Free</span>
        <% end %>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-500">Admin</span>
        <% if @user.admin? %>
          <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium rounded-full bg-purple-100 text-purple-700"><%= @user.admin_role.humanize %></span>
        <% else %>
          <span class="text-gray-400">No</span>
        <% end %>
      </div>
    </div>

    <div class="mt-6 pt-4 border-t border-gray-100 space-y-2">
      <%= button_to @user.admin? ? "Remove Admin" : "Make Admin", toggle_admin_admin_user_path(@user), method: :post, class: "w-full px-4 py-2 text-sm font-medium rounded-lg border #{@user.admin? ? 'border-red-200 text-red-600 hover:bg-red-50' : 'border-cyan-200 text-cyan-600 hover:bg-cyan-50'} transition" %>
      <% if @user.subscribed? %>
        <%= button_to "Cancel Subscription", toggle_subscription_admin_user_path(@user), method: :post, class: "w-full px-4 py-2 text-sm font-medium rounded-lg border border-red-200 text-red-600 hover:bg-red-50 transition", data: { turbo_confirm: "Are you sure you want to cancel this user's subscription?" } %>
      <% end %>
    </div>
  </div>

  <!-- Activity & Stats -->
  <div class="lg:col-span-2 space-y-6">
    <!-- Usage Stats -->
    <div class="bg-white rounded-xl border border-gray-200 p-5">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Usage Statistics</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="text-center p-3 bg-gray-50 rounded-lg">
          <p class="text-xl font-bold text-gray-900"><%= @user.resumes.count %></p>
          <p class="text-xs text-gray-500">Resumes</p>
        </div>
        <div class="text-center p-3 bg-gray-50 rounded-lg">
          <p class="text-xl font-bold text-gray-900"><%= @user.mock_interviews.count %></p>
          <p class="text-xs text-gray-500">Interviews</p>
        </div>
        <div class="text-center p-3 bg-gray-50 rounded-lg">
          <p class="text-xl font-bold text-gray-900"><%= @user.career_reports.count %></p>
          <p class="text-xs text-gray-500">Reports</p>
        </div>
        <div class="text-center p-3 bg-gray-50 rounded-lg">
          <p class="text-xl font-bold text-gray-900"><%= @user.community_posts.count %></p>
          <p class="text-xs text-gray-500">Posts</p>
        </div>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-5 border-b border-gray-100">
        <h3 class="text-sm font-semibold text-gray-900">Recent Activity</h3>
      </div>
      <div class="divide-y divide-gray-50">
        <% @recent_activity.each do |log| %>
          <div class="px-5 py-3 flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-900"><%= log.action.humanize %></p>
              <p class="text-xs text-gray-400"><%= log.resource_type %> #<%= log.resource_id %></p>
            </div>
            <span class="text-xs text-gray-400"><%= time_ago_in_words(log.created_at) %> ago</span>
          </div>
        <% end %>
        <% if @recent_activity.empty? %>
          <div class="px-5 py-6 text-center text-sm text-gray-400">No activity recorded</div>
        <% end %>
      </div>
    </div>
  </div>
</div>

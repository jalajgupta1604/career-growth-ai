<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">A/B Experiments</h1>
      <p class="text-sm text-gray-500 mt-1">Manage feature experiments and track conversion rates</p>
    </div>
    <%= link_to new_admin_experiment_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-gray-900 text-white font-semibold rounded-xl hover:bg-gray-800 transition-colors" do %>
      <span class="material-symbols-outlined text-[18px]">science</span>
      New Experiment
    <% end %>
  </div>

  <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
    <table class="w-full">
      <thead>
        <tr class="border-b border-gray-100">
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Name</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Variants</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Metric</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Participants</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <% @experiments.each do |exp| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <%= link_to exp.name, admin_experiment_path(exp), class: "font-semibold text-gray-900 hover:text-cyan-600" %>
              <p class="text-xs text-gray-400 mt-0.5"><%= exp.description %></p>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 text-xs font-semibold rounded-full
                <%= case exp.status
                    when 'running' then 'bg-green-50 text-green-600'
                    when 'completed' then 'bg-gray-100 text-gray-600'
                    else 'bg-yellow-50 text-yellow-600'
                    end %>">
                <%= exp.status.capitalize %>
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-gray-600"><%= exp.variants.join(", ") %></td>
            <td class="px-6 py-4 text-sm text-gray-600"><%= exp.metric %></td>
            <td class="px-6 py-4 text-sm text-gray-600"><%= exp.experiment_assignments.count %></td>
            <td class="px-6 py-4">
              <%= link_to "View", admin_experiment_path(exp), class: "text-sm text-cyan-600 hover:text-cyan-800" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= paginate @experiments if @experiments.respond_to?(:total_pages) %>
</div>

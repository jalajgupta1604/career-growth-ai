<div class="p-6">
  <nav class="flex items-center gap-2 text-sm mb-6">
    <%= link_to "Experiments", admin_experiments_path, class: "text-gray-400 hover:text-gray-600" %>
    <span class="material-symbols-outlined text-gray-300 text-[16px]">chevron_right</span>
    <span class="text-gray-700 font-medium">New Experiment</span>
  </nav>

  <div class="max-w-2xl">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Create A/B Experiment</h1>

    <%= form_with url: admin_experiments_path, method: :post, class: "space-y-5" do |f| %>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Experiment Name</label>
        <input type="text" name="experiment[name]" required class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-gray-900" placeholder="e.g., pricing_page_v2">
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Description</label>
        <textarea name="experiment[description]" rows="2" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-gray-900" placeholder="What are you testing?"></textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Variants (comma-separated)</label>
        <input type="text" name="experiment[variants_text]" required class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-gray-900" placeholder="e.g., control, variant_a, variant_b">
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Conversion Metric</label>
        <input type="text" name="experiment[metric]" required class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-gray-900" placeholder="e.g., subscription_conversion">
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Traffic Percentage</label>
        <input type="number" name="experiment[traffic_percentage]" value="100" min="1" max="100" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-gray-900">
      </div>

      <button type="submit" class="px-6 py-2.5 bg-gray-900 text-white font-semibold rounded-xl hover:bg-gray-800 transition-colors cursor-pointer">
        Create Experiment
      </button>
    <% end %>
  </div>
</div>

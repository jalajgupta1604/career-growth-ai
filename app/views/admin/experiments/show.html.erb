<div class="p-6">
  <nav class="flex items-center gap-2 text-sm mb-6">
    <%= link_to "Experiments", admin_experiments_path, class: "text-gray-400 hover:text-gray-600" %>
    <span class="material-symbols-outlined text-gray-300 text-[16px]">chevron_right</span>
    <span class="text-gray-700 font-medium"><%= @experiment.name %></span>
  </nav>

  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @experiment.name %></h1>
      <p class="text-sm text-gray-500 mt-1"><%= @experiment.description %></p>
    </div>
    <div class="flex items-center gap-3">
      <% if @experiment.status == "draft" %>
        <%= button_to "Start", start_admin_experiment_path(@experiment), method: :post, class: "px-4 py-2 bg-green-500 text-white font-semibold rounded-xl hover:bg-green-600 transition-colors cursor-pointer" %>
      <% elsif @experiment.status == "running" %>
        <%= button_to "Stop", stop_admin_experiment_path(@experiment), method: :post, class: "px-4 py-2 bg-red-500 text-white font-semibold rounded-xl hover:bg-red-600 transition-colors cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <!-- Experiment Info -->
  <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-2xl border border-gray-100 p-5 text-center">
      <p class="text-xs font-semibold text-gray-400 uppercase mb-1">Status</p>
      <p class="text-lg font-bold text-gray-900"><%= @experiment.status.capitalize %></p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 p-5 text-center">
      <p class="text-xs font-semibold text-gray-400 uppercase mb-1">Metric</p>
      <p class="text-lg font-bold text-gray-900"><%= @experiment.metric %></p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 p-5 text-center">
      <p class="text-xs font-semibold text-gray-400 uppercase mb-1">Traffic</p>
      <p class="text-lg font-bold text-gray-900"><%= @experiment.traffic_percentage %>%</p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 p-5 text-center">
      <p class="text-xs font-semibold text-gray-400 uppercase mb-1">Participants</p>
      <p class="text-lg font-bold text-gray-900"><%= @experiment.experiment_assignments.count %></p>
    </div>
  </div>

  <!-- Variant Results -->
  <div class="bg-white rounded-2xl border border-gray-100 p-6">
    <h2 class="text-lg font-bold text-gray-900 mb-4">Variant Performance</h2>
    <div class="grid grid-cols-1 sm:grid-cols-<%= @stats.size %> gap-4">
      <% @stats.each do |variant, data| %>
        <div class="bg-gray-50 rounded-xl p-5 text-center">
          <p class="text-sm font-semibold text-gray-600 mb-3"><%= variant %></p>
          <p class="text-3xl font-bold text-gray-900 mb-1"><%= data[:conversion_rate] %>%</p>
          <p class="text-xs text-gray-400">conversion rate</p>
          <div class="flex items-center justify-center gap-4 mt-3 text-xs text-gray-500">
            <span><%= data[:total] %> assigned</span>
            <span><%= data[:converted] %> converted</span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

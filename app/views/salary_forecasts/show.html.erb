<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm mb-6">
      <%= link_to "Salary Forecasts", salary_forecasts_path, class: "text-gray-400 hover:text-cyan-500 transition-colors" %>
      <span class="material-symbols-outlined text-gray-300 text-[16px]">chevron_right</span>
      <span class="text-gray-700 font-medium">Forecast Details</span>
    </nav>

    <% if @forecast.completed? %>
      <% result = @forecast.result_data %>

      <!-- Current Salary -->
      <div class="bg-white rounded-2xl border border-gray-100 p-8 mb-6">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 bg-gray-50 rounded-xl flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[28px] text-cyan-500">account_balance_wallet</span>
          </div>
          <div>
            <p class="text-sm text-gray-500">Current Salary</p>
            <p class="text-3xl font-bold text-gray-900"><%= "#{(@forecast.current_salary / 100000.0).round(1)}L" %> <span class="text-base font-normal text-gray-400">per annum</span></p>
          </div>
        </div>
      </div>

      <!-- Projected Salaries: Year 1, 2, 3 -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <% @forecast.projected_salaries.each_with_index do |projection, idx| %>
          <div class="bg-white rounded-2xl border border-gray-100 p-6 text-center">
            <span class="material-symbols-outlined text-cyan-500 text-[28px] mb-2">calendar_month</span>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Year <%= idx + 1 %></p>
            <div class="space-y-2">
              <div>
                <p class="text-2xl font-bold text-gray-900"><%= "#{(projection["likely"] / 100000.0).round(1)}L" %></p>
                <p class="text-xs text-gray-400">Most Likely</p>
              </div>
              <div class="flex items-center justify-center gap-3 text-xs text-gray-500">
                <span class="px-2 py-0.5 bg-gray-50 rounded-full">Min: <%= "#{(projection["min"] / 100000.0).round(1)}L" %></span>
                <span class="px-2 py-0.5 bg-gray-50 rounded-full">Max: <%= "#{(projection["max"] / 100000.0).round(1)}L" %></span>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Skill Plan -->
      <% if result["skill_plan"].present? %>
        <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
          <div class="flex items-center gap-3 mb-5">
            <span class="material-symbols-outlined text-cyan-500">school</span>
            <h2 class="text-lg font-bold text-gray-900">Skill Development Plan</h2>
          </div>
          <div class="space-y-4">
            <% result["skill_plan"].each do |skill| %>
              <div class="flex items-start justify-between p-4 bg-gray-50 rounded-xl">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-1">
                    <h4 class="text-sm font-semibold text-gray-900"><%= skill["name"] %></h4>
                    <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-cyan-50 text-cyan-600 border border-cyan-200">
                      +<%= skill["salary_boost_percentage"] %>%
                    </span>
                  </div>
                  <p class="text-sm text-gray-500"><%= skill["impact"] %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Market Factors -->
      <% if result["market_factors"].present? %>
        <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
          <div class="flex items-center gap-3 mb-5">
            <span class="material-symbols-outlined text-cyan-500">monitoring</span>
            <h2 class="text-lg font-bold text-gray-900">Market Factors</h2>
          </div>
          <div class="space-y-3">
            <% result["market_factors"].each do |factor| %>
              <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0
                  <%= case factor['direction']
                      when 'positive' then 'bg-green-50'
                      when 'negative' then 'bg-red-50'
                      else 'bg-gray-100'
                      end %>">
                  <span class="material-symbols-outlined text-[20px]
                    <%= case factor['direction']
                        when 'positive' then 'text-green-500'
                        when 'negative' then 'text-red-500'
                        else 'text-gray-400'
                        end %>">
                    <%= case factor['direction']
                        when 'positive' then 'arrow_upward'
                        when 'negative' then 'arrow_downward'
                        else 'remove'
                        end %>
                  </span>
                </div>
                <div class="flex-1">
                  <h4 class="text-sm font-semibold text-gray-900"><%= factor["name"] %></h4>
                  <p class="text-sm text-gray-500"><%= factor["impact"] %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Summary -->
      <% if result["summary"].present? %>
        <div class="bg-white rounded-2xl border border-gray-100 p-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="material-symbols-outlined text-cyan-500">summarize</span>
            <h2 class="text-lg font-bold text-gray-900">Summary</h2>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed"><%= result["summary"] %></p>
        </div>
      <% end %>

    <% elsif @forecast.status == "failed" %>
      <!-- Error State -->
      <div class="bg-white rounded-2xl border border-red-100 p-16 text-center">
        <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="material-symbols-outlined text-red-500 text-[32px]">error</span>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Forecast generation failed</h3>
        <p class="text-sm text-gray-500 mb-4">Something went wrong while generating your salary forecast. Please try again.</p>
        <%= button_to salary_forecasts_path, method: :post, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer" do %>
          <span class="material-symbols-outlined text-[20px]">refresh</span>
          Try Again
        <% end %>
      </div>

    <% elsif @forecast.status == "processing" %>
      <div class="bg-white rounded-2xl border border-gray-100 p-16 text-center">
        <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="animate-spin h-8 w-8 text-cyan-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Generating forecast...</h3>
        <p class="text-sm text-gray-500">Our AI is analyzing market data and your profile. This usually takes a few seconds.</p>
      </div>

    <% else %>
      <div class="bg-white rounded-2xl border border-gray-100 p-16 text-center">
        <p class="text-sm text-gray-500">Forecast pending...</p>
      </div>
    <% end %>
  </div>
</div>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <div class="flex items-center gap-3 mb-1">
          <span class="material-symbols-outlined text-cyan-500 text-[32px]">trending_up</span>
          <h1 class="text-3xl font-bold text-gray-900">Salary Trajectory</h1>
        </div>
        <p class="mt-1 text-sm text-gray-500">AI-powered salary projections based on your skills, experience, and market trends.</p>
      </div>
      <%= button_to salary_forecasts_path, method: :post, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer", data: { controller: "loading-button", loading_button_text_value: "Generating Forecast...", action: "submit->loading-button#submit" } do %>
        <span class="material-symbols-outlined text-[20px]" data-loading-button-target="button">auto_graph</span>
        Generate Forecast
      <% end %>
    </div>

    <!-- Past Forecasts -->
    <% if @forecasts.present? %>
      <div class="space-y-4">
        <% @forecasts.each do |forecast| %>
          <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:border-cyan-200 transition-colors">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-gray-50 rounded-xl flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-cyan-500 text-[24px]">query_stats</span>
                </div>
                <div>
                  <h3 class="text-base font-semibold text-gray-900">Salary Forecast</h3>
                  <p class="text-xs text-gray-400 mt-1"><%= forecast.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <span class="px-3 py-1 text-xs font-semibold rounded-full
                  <%= case forecast.status
                      when 'completed' then 'bg-green-50 text-green-600 border border-green-200'
                      when 'processing' then 'bg-yellow-50 text-yellow-600 border border-yellow-200'
                      when 'failed' then 'bg-red-50 text-red-600 border border-red-200'
                      else 'bg-gray-50 text-gray-500 border border-gray-200'
                      end %>">
                  <%= forecast.status.capitalize %>
                </span>
                <% if forecast.completed? %>
                  <%= link_to salary_forecast_path(forecast), class: "inline-flex items-center gap-1 text-sm font-medium text-cyan-500 hover:text-cyan-600 transition-colors" do %>
                    View
                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="bg-white rounded-2xl border border-gray-100 p-16 text-center">
        <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="material-symbols-outlined text-cyan-500 text-[32px]">trending_up</span>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">No forecasts yet</h3>
        <p class="text-sm text-gray-500 mb-6">Generate your first salary forecast to see where your career trajectory is headed.</p>
        <%= button_to salary_forecasts_path, method: :post, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer", data: { controller: "loading-button", loading_button_text_value: "Generating Forecast...", action: "submit->loading-button#submit" } do %>
          <span class="material-symbols-outlined text-[20px]" data-loading-button-target="button">auto_graph</span>
          Generate Forecast
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="min-h-screen bg-gray-950">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">New Career Simulation</h1>
      <p class="mt-1 text-sm text-gray-400">Describe a career scenario and our AI will project outcomes, timelines, and risks.</p>
    </div>

    <%= form_with model: @simulation, url: career_simulations_path, class: "space-y-6", data: { controller: "loading-button", loading_button_text_value: "Running Simulation...", action: "submit->loading-button#submit" } do |f| %>
      <div class="bg-gray-900 rounded-2xl border border-gray-800 p-8 space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="scenario_type" class="block text-sm font-semibold text-gray-300 mb-1">Scenario Type</label>
            <%= select_tag :scenario_type, options_for_select([
              ["Role Change", "role_change"],
              ["Company Switch", "company_switch"],
              ["Skill Pivot", "skill_pivot"],
              ["Promotion", "promotion"],
              ["Freelancing", "freelancing"]
            ]), class: "w-full px-4 py-2.5 bg-gray-800 border border-gray-700 rounded-xl text-sm text-white focus:border-cyan-500 focus:ring-cyan-500 transition-colors", required: true %>
          </div>
          <div>
            <label for="target_role" class="block text-sm font-semibold text-gray-300 mb-1">Target Role</label>
            <%= text_field_tag :target_role, nil, class: "w-full px-4 py-2.5 bg-gray-800 border border-gray-700 rounded-xl text-sm text-white focus:border-cyan-500 focus:ring-cyan-500 transition-colors placeholder-gray-500", placeholder: "e.g. Staff Engineer, Engineering Manager", required: true %>
          </div>
        </div>

        <div>
          <label for="target_company_type" class="block text-sm font-semibold text-gray-300 mb-1">Target Company Type</label>
          <%= select_tag :target_company_type, options_for_select([
            ["Startup", "startup"],
            ["Mid-size", "mid_size"],
            ["Enterprise", "enterprise"],
            ["FAANG / Big Tech", "faang"],
            ["Remote-first", "remote"]
          ]), class: "w-full px-4 py-2.5 bg-gray-800 border border-gray-700 rounded-xl text-sm text-white focus:border-cyan-500 focus:ring-cyan-500 transition-colors", required: true %>
        </div>

        <div>
          <label for="description" class="block text-sm font-semibold text-gray-300 mb-1">Describe Your Scenario</label>
          <p class="text-xs text-gray-500 mb-2">Include your current situation, goals, and any constraints.</p>
          <%= text_area_tag :description, nil, rows: 6, class: "w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-xl text-sm text-white focus:border-cyan-500 focus:ring-cyan-500 transition-colors resize-none placeholder-gray-500", placeholder: "I'm a mid-level backend engineer with 4 years of experience at a mid-size company. I want to transition into a staff engineering role at a FAANG company within the next 18 months..." %>
        </div>
      </div>

      <div class="flex items-center justify-between pt-2">
        <%= link_to "Cancel", career_simulations_path, class: "text-sm font-medium text-gray-500 hover:text-gray-300 transition-colors" %>
        <%= f.submit "Run Simulation", class: "px-6 py-2.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

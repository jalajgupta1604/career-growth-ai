<div class="min-h-screen bg-gray-50">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Webhook Integrations</h1>
      <p class="mt-1 text-sm text-gray-500">Receive real-time notifications when events happen on your account.</p>
    </div>

    <!-- Create Webhook Form -->
    <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
      <h2 class="text-base font-semibold text-gray-900 mb-4">Add New Webhook</h2>
      <%= form_with url: webhooks_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Endpoint URL</label>
          <input type="url" name="webhook_subscription[url]" required
                 class="w-full px-4 py-2.5 bg-white border border-gray-300 rounded-xl text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-colors"
                 placeholder="https://example.com/webhooks">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Events to subscribe</label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <% WebhookSubscription::AVAILABLE_EVENTS.each do |event| %>
              <label class="flex items-center gap-2.5 px-3 py-2 rounded-lg border border-gray-200 hover:border-cyan-300 hover:bg-cyan-50/30 cursor-pointer transition-colors">
                <input type="checkbox" name="webhook_subscription[events][]" value="<%= event %>"
                       class="h-4 w-4 rounded border-gray-300 text-cyan-600 focus:ring-cyan-500">
                <span class="text-sm text-gray-700"><%= event %></span>
              </label>
            <% end %>
          </div>
        </div>

        <div class="pt-2">
          <button type="submit"
                  class="inline-flex items-center gap-2 px-5 py-2.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors"
                  data-turbo-submits-with="Creating...">
            <span class="material-symbols-outlined text-[20px]">add</span>
            Create Webhook
          </button>
        </div>
      <% end %>
    </div>

    <!-- Existing Webhooks -->
    <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-base font-semibold text-gray-900">Your Webhooks</h2>
      </div>

      <% if @subscriptions.any? %>
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead>
              <tr class="border-b border-gray-100">
                <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Endpoint</th>
                <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Events</th>
                <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Secret</th>
                <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider sr-only">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @subscriptions.each do |subscription| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 py-4">
                    <p class="text-sm font-medium text-gray-900 truncate max-w-[220px]"><%= subscription.url %></p>
                    <% if subscription.respond_to?(:last_triggered_at) && subscription.last_triggered_at.present? %>
                      <p class="text-xs text-gray-400 mt-0.5">Last triggered <%= time_ago_in_words(subscription.last_triggered_at) %> ago</p>
                    <% end %>
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-1">
                      <% (subscription.events || []).each do |event| %>
                        <span class="inline-block px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-600"><%= event %></span>
                      <% end %>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <% if subscription.active? %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 text-xs font-semibold rounded-full bg-green-100 text-green-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                        Active
                      </span>
                    <% else %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 text-xs font-semibold rounded-full bg-red-100 text-red-600">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
                        Inactive
                      </span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4">
                    <% if subscription.respond_to?(:secret) && subscription.secret.present? %>
                      <span class="font-mono text-xs text-gray-400"><%= subscription.secret[0..5] %><%= '*' * 20 %></span>
                    <% else %>
                      <span class="text-xs text-gray-400">&mdash;</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <%= button_to webhook_path(subscription), method: :delete,
                          class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100 transition-colors",
                          data: { turbo_confirm: "Delete this webhook? This cannot be undone." } do %>
                      <span class="material-symbols-outlined text-[16px]">delete</span>
                      Delete
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-6 py-12 text-center">
          <div class="w-14 h-14 bg-cyan-50 rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="material-symbols-outlined text-cyan-500 text-[28px]">webhook</span>
          </div>
          <h3 class="text-sm font-semibold text-gray-900 mb-1">No webhooks configured</h3>
          <p class="text-sm text-gray-500">Create your first webhook above to start receiving event notifications.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

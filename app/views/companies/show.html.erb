<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <!-- Company Header -->
  <div class="bg-white rounded-2xl border border-gray-100 p-8 mb-8">
    <div class="flex items-start gap-6">
      <% if @company.company_logo_url.present? %>
        <img src="<%= @company.company_logo_url %>" alt="<%= @company.company_name %>" class="w-20 h-20 rounded-xl object-cover border border-gray-200">
      <% else %>
        <div class="w-20 h-20 rounded-xl bg-indigo-100 flex items-center justify-center">
          <span class="text-2xl font-bold text-indigo-600"><%= @company.company_name.first(2).upcase %></span>
        </div>
      <% end %>
      <div class="flex-1">
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-2xl font-bold text-gray-900"><%= @company.company_name %></h1>
          <% if @company.verified? %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded-full bg-blue-100 text-blue-700">
              <span class="material-symbols-outlined text-sm">verified</span> Verified
            </span>
          <% end %>
        </div>
        <div class="flex flex-wrap gap-4 text-sm text-gray-500">
          <% if @company.industry.present? %>
            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-base">business</span> <%= @company.industry %></span>
          <% end %>
          <% if @company.headquarters.present? %>
            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-base">location_on</span> <%= @company.headquarters %></span>
          <% end %>
          <% if @company.company_size.present? %>
            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-base">group</span> <%= @company.company_size %> employees</span>
          <% end %>
          <% if @company.company_website.present? %>
            <a href="<%= @company.company_website %>" target="_blank" rel="noopener" class="flex items-center gap-1 text-indigo-600 hover:text-indigo-700">
              <span class="material-symbols-outlined text-base">language</span> Website
            </a>
          <% end %>
        </div>
      </div>
    </div>
    <% if @company.company_description.present? %>
      <div class="mt-6 text-sm text-gray-600 leading-relaxed"><%= simple_format(@company.company_description) %></div>
    <% end %>
  </div>

  <!-- Open Positions -->
  <h2 class="text-lg font-semibold text-gray-900 mb-4">Open Positions (<%= @jobs.size %>)</h2>

  <% if @jobs.any? %>
    <div class="space-y-4">
      <% @jobs.each do |job| %>
        <div class="bg-white rounded-xl border border-gray-100 p-6 hover:border-indigo-200 transition">
          <div class="flex items-start justify-between">
            <div>
              <h3 class="font-semibold text-gray-900"><%= job.title %></h3>
              <div class="flex flex-wrap gap-3 mt-2 text-sm text-gray-500">
                <% if job.location.present? %>
                  <span class="flex items-center gap-1"><span class="material-symbols-outlined text-base">location_on</span> <%= job.location %></span>
                <% end %>
                <% if job.job_type.present? %>
                  <span class="flex items-center gap-1"><span class="material-symbols-outlined text-base">work</span> <%= job.job_type.titleize %></span>
                <% end %>
                <% if job.experience_level.present? %>
                  <span class="flex items-center gap-1"><span class="material-symbols-outlined text-base">trending_up</span> <%= job.experience_level.titleize %></span>
                <% end %>
              </div>
            </div>
            <%= link_to job_posting_path(job), class: "inline-flex items-center px-4 py-2 bg-indigo-500 text-white text-sm font-medium rounded-lg hover:bg-indigo-600 transition" do %>
              View & Apply
            <% end %>
          </div>
          <p class="mt-3 text-sm text-gray-600 line-clamp-2"><%= truncate(job.description.to_s, length: 200) %></p>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-gray-100 p-8 text-center">
      <span class="material-symbols-outlined text-4xl text-gray-300">work_off</span>
      <p class="mt-2 text-sm text-gray-500">No open positions at the moment.</p>
    </div>
  <% end %>
</div>

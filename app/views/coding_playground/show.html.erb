<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <%= link_to coding_playground_index_path, class: "text-sm text-cyan-600 font-medium hover:text-cyan-700" do %>
          <span class="inline-flex items-center gap-1">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            All Problems
          </span>
        <% end %>
      </div>
    </div>

    <!-- Split Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Left Side: Problem Description -->
      <div class="bg-white rounded-2xl border border-gray-100 p-8 overflow-y-auto" style="max-height: calc(100vh - 140px);">
        <!-- Title & Badges -->
        <div class="mb-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="px-2.5 py-0.5 text-xs font-medium rounded-full
              <%= case @problem[:difficulty]
                  when 'easy' then 'bg-green-50 text-green-600'
                  when 'medium' then 'bg-yellow-50 text-yellow-600'
                  when 'hard' then 'bg-red-50 text-red-600'
                  end %>">
              <%= @problem[:difficulty]&.capitalize %>
            </span>
            <span class="px-2.5 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-500">
              <%= @problem[:category] %>
            </span>
          </div>
          <h1 class="text-2xl font-bold text-gray-900"><%= @problem[:title] %></h1>
        </div>

        <!-- Description -->
        <div class="mb-6">
          <p class="text-sm text-gray-600 leading-relaxed"><%= @problem[:description] %></p>
        </div>

        <!-- Examples -->
        <% if @problem[:examples].present? %>
          <div class="mb-6">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Examples</h3>
            <div class="space-y-4">
              <% @problem[:examples].each_with_index do |example, i| %>
                <div class="bg-gray-50 rounded-xl p-4">
                  <p class="text-xs font-semibold text-gray-500 mb-2">Example <%= i + 1 %></p>
                  <div class="space-y-1.5">
                    <p class="text-sm text-gray-700"><span class="font-semibold text-gray-900">Input:</span> <code class="text-sm bg-gray-100 px-1.5 py-0.5 rounded"><%= example[:input] || example["input"] %></code></p>
                    <p class="text-sm text-gray-700"><span class="font-semibold text-gray-900">Output:</span> <code class="text-sm bg-gray-100 px-1.5 py-0.5 rounded"><%= example[:output] || example["output"] %></code></p>
                    <% explanation = example[:explanation] || example["explanation"] %>
                    <% if explanation.present? %>
                      <p class="text-xs text-gray-500 mt-1"><span class="font-semibold">Explanation:</span> <%= explanation %></p>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Constraints -->
        <% if @problem[:constraints].present? %>
          <div class="mb-6">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Constraints</h3>
            <ul class="space-y-1.5">
              <% @problem[:constraints].each do |constraint| %>
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="material-symbols-outlined text-gray-400 text-[16px] mt-0.5 shrink-0">check_small</span>
                  <code class="text-sm"><%= constraint %></code>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Hints (Accordion) -->
        <% if @problem[:hints].present? %>
          <div class="mt-6" data-controller="accordion">
            <button data-action="click->accordion#toggle" class="flex items-center gap-2 text-sm font-medium text-cyan-600 hover:text-cyan-700">
              <span class="material-symbols-outlined text-[18px]">lightbulb</span>
              Show Hints
              <span data-accordion-target="icon" class="material-symbols-outlined text-[18px] transition-transform">expand_more</span>
            </button>
            <div data-accordion-target="content" class="hidden mt-3 space-y-2">
              <% @problem[:hints].each_with_index do |hint, i| %>
                <p class="text-sm text-gray-500 pl-4 border-l-2 border-cyan-200">Hint <%= i + 1 %>: <%= hint %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Right Side: Code Editor -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 flex flex-col" style="max-height: calc(100vh - 140px);">
        <!-- Language Tabs -->
        <div class="flex items-center gap-2 mb-4">
          <% [["Python", "python"], ["JavaScript", "javascript"], ["Java", "java"], ["C++", "cpp"]].each do |label, lang| %>
            <button type="button"
                    data-lang-tab="<%= lang %>"
                    onclick="switchLanguage('<%= lang %>')"
                    class="px-3 py-1.5 text-xs font-medium rounded-lg transition-colors <%= lang == 'python' ? 'bg-cyan-500 text-white' : 'bg-gray-200 text-gray-700' %>">
              <%= label %>
            </button>
          <% end %>
        </div>

        <!-- Monaco Editor Container -->
        <div id="editor" class="rounded-xl overflow-hidden border border-gray-200 mb-4 flex-1" style="min-height: 400px;"></div>

        <!-- Submit Form -->
        <%= form_with url: submit_coding_playground_index_path, method: :post, id: "code_form",
            data: { controller: "loading-button", loading_button_text_value: "Evaluating Code...", action: "submit->loading-button#submit" } do |f| %>
          <%= f.hidden_field :problem_id, value: @problem[:id] %>
          <%= f.hidden_field :language, value: "python", id: "language_input" %>
          <%= f.hidden_field :code, value: "", id: "code_input" %>
          <%= f.submit "Run & Evaluate", class: "w-full py-3 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer flex items-center justify-center gap-2" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Monaco Editor CDN -->
<script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js"></script>
<script>
  require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });

  let editor;
  let currentLanguage = 'python';
  const languageMap = { python: 'python', javascript: 'javascript', java: 'java', cpp: 'cpp' };

  require(['vs/editor/editor.main'], function () {
    editor = monaco.editor.create(document.getElementById('editor'), {
      value: '# Write your solution here\n',
      language: 'python',
      theme: 'vs-dark',
      minimap: { enabled: false },
      fontSize: 14,
      lineNumbers: 'on',
      automaticLayout: true,
      scrollBeyondLastLine: false,
      padding: { top: 16 }
    });
  });

  function switchLanguage(lang) {
    currentLanguage = lang;
    const model = editor.getModel();
    monaco.editor.setModelLanguage(model, languageMap[lang] || lang);
    document.getElementById('language_input').value = lang;
    document.querySelectorAll('[data-lang-tab]').forEach(t => {
      t.classList.toggle('bg-cyan-500', t.dataset.langTab === lang);
      t.classList.toggle('text-white', t.dataset.langTab === lang);
      t.classList.toggle('bg-gray-200', t.dataset.langTab !== lang);
      t.classList.toggle('text-gray-700', t.dataset.langTab !== lang);
    });
  }

  document.getElementById('code_form').addEventListener('submit', function() {
    document.getElementById('code_input').value = editor.getValue();
  });
</script>

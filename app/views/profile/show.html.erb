<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl font-bold text-gray-900">My Profile</h1>
    <%= link_to edit_profile_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
      Edit Profile
    <% end %>
  </div>

  <!-- Profile Card -->
  <div class="bg-white rounded-2xl border border-gray-100 p-8 mb-8">
    <div class="flex items-center gap-5 mb-8">
      <div class="relative group">
        <% if current_user.avatar_url.present? %>
          <img src="<%= current_user.avatar_url %>" class="w-20 h-20 rounded-full object-cover ring-4 ring-gray-100" alt="Profile">
        <% else %>
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-cyan-400 to-cyan-600 flex items-center justify-center ring-4 ring-gray-100">
            <span class="text-2xl font-bold text-white"><%= current_user.full_name&.first&.upcase || "U" %></span>
          </div>
        <% end %>
        <%= link_to edit_profile_path(anchor: "photo"), class: "absolute inset-0 flex items-center justify-center rounded-full bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity" do %>
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <% end %>
      </div>
      <div>
        <h2 class="text-xl font-bold text-gray-900"><%= current_user.full_name || "No name set" %></h2>
        <p class="text-sm text-gray-500"><%= current_user.email %></p>
        <% if current_user.subscribed? %>
          <span class="inline-flex items-center px-2.5 py-0.5 bg-amber-400 text-amber-900 text-xs font-bold rounded-full mt-1">PRO</span>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="bg-gray-50 rounded-xl p-4">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Role</p>
        <p class="text-sm font-semibold text-gray-900"><%= current_user.role.presence || "Not set" %></p>
      </div>
      <div class="bg-gray-50 rounded-xl p-4">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">City</p>
        <p class="text-sm font-semibold text-gray-900"><%= current_user.city.presence || "Not set" %></p>
      </div>
      <div class="bg-gray-50 rounded-xl p-4">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Experience</p>
        <p class="text-sm font-semibold text-gray-900"><%= current_user.experience_years.present? ? "#{current_user.experience_years} years" : "Not set" %></p>
      </div>
      <div class="bg-gray-50 rounded-xl p-4">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Current Salary</p>
        <p class="text-sm font-semibold text-gray-900"><%= current_user.current_salary.present? ? "₹#{number_with_delimiter(current_user.current_salary)}" : "Not set" %></p>
      </div>
    </div>
  </div>

  <!-- Subscription Section -->
  <div class="bg-white rounded-2xl border border-gray-100 p-8 mb-8">
    <h3 class="text-lg font-bold text-gray-900 mb-6">Subscription</h3>

    <% if current_user.legacy_paid? && !@subscription %>
      <div class="flex items-center gap-4 p-4 bg-amber-50 border border-amber-200 rounded-xl">
        <div class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 2a2 2 0 00-2 2v14l3.5-2 3.5 2 3.5-2 3.5 2V4a2 2 0 00-2-2H5zm4.707 3.707a1 1 0 00-1.414-1.414l-3 3a1 1 0 000 1.414l3 3a1 1 0 001.414-1.414L8.414 9H10a3 3 0 013 3v1a1 1 0 102 0v-1a5 5 0 00-5-5H8.414l1.293-1.293z" clip-rule="evenodd"/></svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-amber-900">Lifetime Access</p>
          <p class="text-xs text-amber-700">Grandfathered from previous purchase. Full access indefinitely.</p>
        </div>
      </div>

    <% elsif @subscription&.active_access? %>
      <div class="flex items-center justify-between p-4 bg-green-50 border border-green-200 rounded-xl mb-4">
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-green-900">
              Pro <%= @subscription.plan_name.capitalize %>
              &mdash; &#8377;<%= number_with_delimiter(@subscription.amount) %>/<%= @subscription.plan_name == "monthly" ? "mo" : "yr" %>
            </p>
            <p class="text-xs text-green-700">
              <% if @subscription.cancelled? %>
                Cancelled &mdash; access until <%= @subscription.current_period_end&.strftime("%B %d, %Y") %>
              <% else %>
                Renews <%= @subscription.current_period_end&.strftime("%B %d, %Y") %>
              <% end %>
            </p>
          </div>
        </div>
        <span class="px-2.5 py-1 rounded-full text-xs font-semibold <%= @subscription.cancelled? ? 'bg-yellow-100 text-yellow-700' : 'bg-green-100 text-green-700' %>">
          <%= @subscription.cancelled? ? "Cancelling" : "Active" %>
        </span>
      </div>
      <%= link_to manage_subscriptions_path, class: "inline-flex items-center gap-2 text-sm font-medium text-cyan-600 hover:text-cyan-700" do %>
        Manage Subscription
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <% end %>

    <% else %>
      <div class="text-center py-4">
        <p class="text-sm text-gray-500 mb-4">No active subscription. Upgrade to unlock all Pro features.</p>
        <%= link_to pricing_path, class: "inline-flex items-center px-6 py-2.5 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 transition-colors" do %>
          View Plans
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Account Section -->
  <div class="bg-white rounded-2xl border border-gray-100 p-8">
    <h3 class="text-lg font-bold text-gray-900 mb-4">Account</h3>
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-900"><%= current_user.email %></p>
        <p class="text-xs text-gray-400">
          <% if current_user.provider == "google_oauth2" %>
            Signed in with Google
          <% else %>
            Email account
          <% end %>
        </p>
      </div>
      <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "px-4 py-2 text-sm font-medium text-red-600 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 transition-colors cursor-pointer" %>
    </div>
  </div>

  <div class="mt-6 text-center">
    <%= link_to "Back to Dashboard", dashboard_path, class: "text-sm text-cyan-600 font-medium hover:text-cyan-700" %>
  </div>
</div>

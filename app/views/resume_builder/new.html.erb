<div class="min-h-screen bg-gray-950">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">Generate Resume</h1>
      <p class="mt-1 text-sm text-gray-400">Enter your target role and our AI will craft a tailored resume from your profile.</p>
    </div>

    <%= form_with url: resume_builder_index_path, method: :post, class: "space-y-6", data: { controller: "loading-button", loading_button_text_value: "Generating Resume...", action: "submit->loading-button#submit" } do |f| %>
      <div class="bg-gray-900 rounded-2xl border border-gray-800 p-8 space-y-6">
        <div>
          <label for="target_role" class="block text-sm font-semibold text-gray-300 mb-1">Target Role</label>
          <p class="text-xs text-gray-500 mb-2">The role you want your resume optimized for.</p>
          <%= text_field_tag :target_role, nil, class: "w-full px-4 py-2.5 bg-gray-800 border border-gray-700 rounded-xl text-sm text-white focus:border-cyan-500 focus:ring-cyan-500 transition-colors placeholder-gray-500", placeholder: "e.g. Senior Backend Engineer, Product Manager, Staff SRE", required: true %>
        </div>
      </div>

      <div class="flex items-center justify-between pt-2">
        <%= link_to "Cancel", resume_builder_index_path, class: "text-sm font-medium text-gray-500 hover:text-gray-300 transition-colors" %>
        <%= f.submit "Generate Resume", class: "px-6 py-2.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

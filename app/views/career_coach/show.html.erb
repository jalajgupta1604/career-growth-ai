<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <%= link_to "&larr;".html_safe, career_coach_index_path, class: "text-gray-400 hover:text-gray-600" %>
      <div>
        <h1 class="text-lg font-bold text-gray-900"><%= @conversation.display_title %></h1>
        <p class="text-xs text-gray-400"><%= @messages.count %> messages</p>
      </div>
    </div>
    <% if @conversation.active? %>
      <%= button_to "Archive", archive_career_coach_path(@conversation), method: :post, class: "text-xs text-gray-400 hover:text-red-500 cursor-pointer" %>
    <% end %>
  </div>

  <!-- Messages -->
  <div class="space-y-4 mb-6">
    <% @messages.each do |msg| %>
      <% next if msg.role == "system" %>
      <div class="flex <%= msg.role == 'user' ? 'justify-end' : 'justify-start' %>">
        <div class="max-w-[80%] <%= msg.role == 'user' ? 'bg-cyan-500 text-white' : 'bg-white border border-gray-100 text-gray-800' %> rounded-2xl px-5 py-4">
          <% if msg.role == "assistant" %>
            <div class="flex items-center gap-2 mb-2">
              <div class="w-6 h-6 bg-cyan-100 rounded-full flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
              </div>
              <span class="text-xs font-semibold text-gray-500">Career Coach</span>
            </div>
          <% end %>
          <div class="text-sm leading-relaxed whitespace-pre-wrap"><%= msg.content %></div>
          <p class="text-[10px] mt-2 <%= msg.role == 'user' ? 'text-cyan-200' : 'text-gray-300' %>"><%= msg.created_at.strftime("%I:%M %p") %></p>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Message Input -->
  <% if @conversation.active? %>
    <div class="sticky bottom-4">
      <div class="bg-white rounded-2xl border border-gray-200 shadow-lg p-4">
        <%= form_with(url: message_career_coach_path(@conversation), method: :post, class: "flex items-end gap-3") do |f| %>
          <div class="flex-1">
            <textarea name="content" rows="2" placeholder="Ask your career coach anything..." class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-cyan-500 focus:border-transparent resize-none" autofocus></textarea>
          </div>
          <%= f.submit "Send", class: "px-6 py-3 bg-cyan-500 text-white text-sm font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer" %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="text-center py-4">
      <p class="text-sm text-gray-400">This conversation has been archived.</p>
      <%= link_to "Start New Conversation", career_coach_index_path, class: "text-sm text-cyan-600 font-semibold hover:text-cyan-700" %>
    </div>
  <% end %>
</div>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">AI Career Coach</h1>
    <p class="mt-1 text-gray-500">Get personalized career advice powered by AI</p>
  </div>

  <!-- Suggested Topics -->
  <div class="mb-8">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Start a New Conversation</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @suggested_topics.each do |topic| %>
        <%= button_to career_coach_index_path(topic: topic[:title]), method: :post, class: "bg-white rounded-2xl border border-gray-100 p-5 text-left hover:shadow-md hover:border-cyan-200 transition-all cursor-pointer group" do %>
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-cyan-100 rounded-xl flex items-center justify-center group-hover:bg-cyan-200 transition-colors shrink-0">
              <svg class="w-5 h-5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-900"><%= topic[:title] %></p>
              <p class="text-xs text-gray-500 mt-0.5"><%= topic[:description] %></p>
            </div>
          </div>
        <% end %>
      <% end %>

      <!-- Free form -->
      <%= button_to career_coach_index_path, method: :post, class: "bg-gradient-to-r from-cyan-500 to-cyan-600 rounded-2xl p-5 text-left text-white hover:shadow-md transition-all cursor-pointer" do %>
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
          </div>
          <div>
            <p class="text-sm font-semibold">Open Conversation</p>
            <p class="text-xs opacity-80 mt-0.5">Ask anything about your career</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Previous Conversations -->
  <% if @conversations.any? %>
    <div>
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Recent Conversations</h2>
      <div class="space-y-3">
        <% @conversations.each do |convo| %>
          <%= link_to career_coach_path(convo), class: "block bg-white rounded-2xl border border-gray-100 p-5 hover:shadow-md hover:border-cyan-200 transition-all" do %>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-gray-100 rounded-xl flex items-center justify-center">
                  <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-900"><%= convo.display_title %></p>
                  <p class="text-xs text-gray-400"><%= convo.coach_messages.count %> messages &middot; <%= time_ago_in_words(convo.updated_at) %> ago</p>
                </div>
              </div>
              <span class="px-2.5 py-1 text-xs font-semibold rounded-full
                <%= convo.active? ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500' %>">
                <%= convo.status.capitalize %>
              </span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

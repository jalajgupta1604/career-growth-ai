<h2>Subscription Cancelled</h2>

<p>Hi <%= @user.full_name.presence || "there" %>,</p>

<p>Your Pro <%= @subscription.plan_name.capitalize %> subscription has been cancelled.</p>

<% if @subscription.current_period_end.present? %>
  <div style="background-color: #fefce8; border: 1px solid #fde68a; border-radius: 8px; padding: 16px; margin: 16px 0;">
    <p style="margin: 0; font-size: 14px; color: #92400e;">
      <strong>You still have access</strong> until <strong><%= @subscription.current_period_end.strftime("%B %d, %Y") %></strong>.
      After that, you'll switch to the free plan.
    </p>
  </div>
<% end %>

<p>Changed your mind? You can resubscribe anytime.</p>

<p style="text-align: center; margin-top: 24px;">
  <a href="<%= pricing_url %>" class="btn">View Plans</a>
</p>

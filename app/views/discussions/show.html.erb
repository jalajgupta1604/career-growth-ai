<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm mb-6">
      <%= link_to "Discussions", discussions_path, class: "text-gray-400 hover:text-cyan-500 transition-colors" %>
      <span class="material-symbols-outlined text-gray-300 text-[16px]">chevron_right</span>
      <span class="text-gray-700 font-medium truncate"><%= @thread.title %></span>
    </nav>

    <!-- Thread -->
    <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
      <div class="flex items-start gap-4 mb-4">
        <div class="shrink-0">
          <%= user_avatar(@thread.user, size: 48) %>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between mb-1">
            <h1 class="text-xl font-bold text-gray-900"><%= @thread.title %></h1>
            <span class="px-2.5 py-1 text-xs font-medium rounded-full shrink-0
              <%= case @thread.category
                  when 'backend' then 'bg-purple-50 text-purple-600 border border-purple-200'
                  when 'frontend' then 'bg-blue-50 text-blue-600 border border-blue-200'
                  when 'devops' then 'bg-orange-50 text-orange-600 border border-orange-200'
                  when 'data_science' then 'bg-green-50 text-green-600 border border-green-200'
                  when 'career' then 'bg-yellow-50 text-yellow-600 border border-yellow-200'
                  else 'bg-gray-50 text-gray-600 border border-gray-200'
                  end %>">
              <%= @thread.category.humanize %>
            </span>
          </div>
          <div class="flex items-center gap-2 text-xs text-gray-400 mb-4">
            <span class="font-medium text-gray-600"><%= @thread.user.full_name %></span>
            <span>&bull;</span>
            <span><%= time_ago_in_words(@thread.created_at) %> ago</span>
          </div>
          <div class="text-sm text-gray-700 leading-relaxed">
            <%= simple_format(@thread.body) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Replies -->
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-cyan-500 text-[20px]">chat</span>
        <h2 class="text-lg font-semibold text-gray-900">
          Replies
          <% if @thread.replies.any? %>
            <span class="text-sm font-normal text-gray-400">(<%= @thread.replies.count %>)</span>
          <% end %>
        </h2>
      </div>

      <% if @thread.replies.any? %>
        <div class="space-y-3">
          <% @thread.replies.each do |reply| %>
            <div class="bg-white rounded-2xl border border-gray-100 p-5">
              <div class="flex items-start gap-3">
                <div class="shrink-0">
                  <%= user_avatar(reply.user, size: 36) %>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-sm font-semibold text-gray-900"><%= reply.user.full_name %></span>
                    <span class="text-xs text-gray-400"><%= time_ago_in_words(reply.created_at) %> ago</span>
                  </div>
                  <div class="text-sm text-gray-700 leading-relaxed">
                    <%= simple_format(reply.body) %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-white rounded-2xl border border-gray-100 p-8 text-center">
          <p class="text-sm text-gray-400">No replies yet. Be the first to respond!</p>
        </div>
      <% end %>
    </div>

    <!-- Reply Form -->
    <div class="bg-white rounded-2xl border border-gray-100 p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-cyan-500 text-[20px]">reply</span>
        <h3 class="text-base font-semibold text-gray-900">Post a Reply</h3>
      </div>

      <%= form_with url: discussion_replies_path(@thread), method: :post, class: "space-y-4", data: { controller: "loading-button", loading_button_text_value: "Posting Reply...", action: "submit->loading-button#submit", turbo: true } do |f| %>
        <div>
          <%= f.text_area :body, name: "reply[body]", rows: 4, class: "w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 resize-none", placeholder: "Share your thoughts..." %>
        </div>
        <div class="flex justify-end">
          <button type="submit" data-loading-button-target="button" class="inline-flex items-center gap-2 px-6 py-2.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer">
            <span class="material-symbols-outlined text-[20px]">send</span>
            Post Reply
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">
      Welcome back, <%= current_user.full_name || current_user.email %>
      <% if current_user.subscribed? %>
        <span class="inline-flex items-center px-2.5 py-0.5 bg-amber-400 text-amber-900 text-xs font-bold rounded-full align-middle ml-2 shadow-sm">PRO</span>
        <% if current_user.active_subscription? %>
          <%= link_to "Manage Subscription", profile_path, class: "text-xs text-cyan-600 font-medium hover:text-cyan-700 ml-2 align-middle" %>
        <% end %>
      <% else %>
        <%= link_to pricing_path, class: "inline-flex items-center px-3 py-1 bg-cyan-500 text-white text-xs font-semibold rounded-full align-middle ml-2 hover:bg-cyan-600 transition-colors" do %>
          Go Pro
        <% end %>
      <% end %>
    </h1>
    <p class="mt-1 text-gray-500"><%= current_user.role %> in <%= current_user.city %> &middot; <%= current_user.experience_years %> years experience</p>
  </div>

  <!-- Quick Stats -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <% if @salary_analysis %>
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <p class="text-sm font-medium text-gray-500">Salary Position</p>
        <p class="mt-2 text-3xl font-bold <%= @salary_analysis[:underpaid_percentage] > 0 ? 'text-red-600' : 'text-green-600' %>">
          <%= @salary_analysis[:underpaid_percentage] > 0 ? "#{@salary_analysis[:underpaid_percentage]}% underpaid" : "At market rate" %>
        </p>
        <p class="mt-1 text-sm text-gray-400">
          Market median: &#8377;<%= number_with_delimiter(@salary_analysis[:salary_range][:median].to_i) %>
        </p>
      </div>
    <% else %>
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <p class="text-sm font-medium text-gray-500">Salary Position</p>
        <p class="mt-2 text-lg text-gray-400">No benchmark data available for your profile yet.</p>
      </div>
    <% end %>

    <div class="bg-white rounded-2xl border border-gray-100 p-6">
      <p class="text-sm font-medium text-gray-500">Resume Status</p>
      <% if @resume %>
        <p class="mt-2 text-lg font-semibold text-gray-900"><%= @resume.parsing_status.humanize %></p>
        <p class="mt-1 text-sm text-gray-400">Uploaded <%= time_ago_in_words(@resume.created_at) %> ago</p>
      <% else %>
        <p class="mt-2 text-lg text-gray-400">No resume uploaded</p>
        <%= link_to "Upload Resume", new_resume_path, class: "mt-2 inline-block text-sm text-cyan-600 font-medium hover:text-cyan-700" %>
      <% end %>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 p-6">
      <p class="text-sm font-medium text-gray-500">Interview Readiness</p>
      <% if @latest_report %>
        <p class="mt-2 text-3xl font-bold text-cyan-600"><%= @latest_report.interview_score&.round(0) %>/100</p>
        <p class="mt-1 text-sm text-gray-400">Based on your latest report</p>
      <% else %>
        <p class="mt-2 text-lg text-gray-400">Generate a report to see your score</p>
      <% end %>
    </div>
  </div>

  <!-- Resume Management -->
  <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-8">
    <div class="flex items-center justify-between mb-5">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-cyan-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>
        <h2 class="text-xl font-semibold text-gray-900">Your Resume</h2>
      </div>
      <span class="text-sm text-gray-400"><%= @all_resumes.count %> resume<%= @all_resumes.count == 1 ? '' : 's' %> uploaded</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Current Active Resume -->
      <div class="lg:col-span-2">
        <% if @resume %>
          <div class="bg-gray-50 rounded-xl p-5">
            <div class="flex items-start justify-between">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl flex items-center justify-center
                  <%= case @resume.parsing_status
                      when 'completed' then 'bg-green-100'
                      when 'processing' then 'bg-yellow-100'
                      when 'failed' then 'bg-red-100'
                      else 'bg-gray-100'
                      end %>">
                  <% case @resume.parsing_status %>
                  <% when 'completed' %>
                    <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <% when 'processing' %>
                    <svg class="w-6 h-6 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                  <% when 'failed' %>
                    <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <% else %>
                    <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <% end %>
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <p class="text-sm font-semibold text-gray-900">Active Resume</p>
                    <span class="px-2 py-0.5 text-xs font-medium rounded-full
                      <%= case @resume.parsing_status
                          when 'completed' then 'bg-green-100 text-green-700'
                          when 'processing' then 'bg-yellow-100 text-yellow-700'
                          when 'failed' then 'bg-red-100 text-red-700'
                          else 'bg-gray-100 text-gray-500'
                          end %>">
                      <%= @resume.parsing_status.capitalize %>
                    </span>
                  </div>
                  <p class="text-xs text-gray-500 mt-1">Uploaded on <%= @resume.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
                  <% if @resume.completed? && @resume.parsed_data.present? %>
                    <div class="flex items-center gap-3 mt-2">
                      <span class="text-xs text-gray-400">
                        <strong class="text-gray-600"><%= (@resume.parsed_data["skills"] || []).size %></strong> skills extracted
                      </span>
                      <span class="text-xs text-gray-400">
                        <strong class="text-gray-600"><%= (@resume.parsed_data["experience_entries"] || @resume.parsed_data["experience"] || []).size %></strong> experience entries
                      </span>
                      <span class="text-xs text-gray-400">
                        <strong class="text-gray-600"><%= (@resume.parsed_data["certifications"] || []).size %></strong> certifications
                      </span>
                    </div>
                  <% end %>
                </div>
              </div>
              <%= link_to resume_path(@resume), class: "text-sm text-cyan-600 font-medium hover:text-cyan-700" do %>
                View Details
              <% end %>
            </div>

            <% if @resume.completed? && @resume.parsed_data.present? %>
              <div class="mt-4 pt-4 border-t border-gray-200">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Extracted Skills</p>
                <div class="flex flex-wrap gap-1.5">
                  <% (@resume.parsed_data["skills"] || []).first(10).each do |skill| %>
                    <span class="px-2.5 py-1 bg-cyan-50 text-cyan-700 border border-cyan-100 rounded-md text-xs font-medium"><%= skill %></span>
                  <% end %>
                  <% remaining = (@resume.parsed_data["skills"] || []).size - 10 %>
                  <% if remaining > 0 %>
                    <span class="px-2.5 py-1 bg-gray-100 text-gray-500 rounded-md text-xs font-medium">+<%= remaining %> more</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>

          <!-- Previous Resumes -->
          <% if @all_resumes.count > 1 %>
            <div class="mt-4">
              <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Previous Resumes</p>
              <div class="space-y-2">
                <% @all_resumes.drop(1).first(3).each do |resume| %>
                  <div class="flex items-center justify-between px-4 py-3 bg-gray-50 rounded-lg">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 bg-gray-200 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>
                      </div>
                      <div>
                        <p class="text-sm text-gray-600">Resume #<%= resume.id %></p>
                        <p class="text-xs text-gray-400"><%= resume.created_at.strftime("%b %d, %Y") %> &middot; <%= (resume.parsed_data&.dig("skills") || []).size %> skills</p>
                      </div>
                    </div>
                    <span class="text-xs font-medium px-2 py-0.5 rounded-full
                      <%= case resume.parsing_status
                          when 'completed' then 'bg-green-100 text-green-700'
                          when 'processing' then 'bg-yellow-100 text-yellow-700'
                          when 'failed' then 'bg-red-100 text-red-700'
                          else 'bg-gray-100 text-gray-500'
                          end %>">
                      <%= resume.parsing_status.capitalize %>
                    </span>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="bg-gray-50 rounded-xl p-8 text-center">
            <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
            </div>
            <p class="text-sm text-gray-500">No resume uploaded yet. Upload one to get personalized skill analysis.</p>
          </div>
        <% end %>
      </div>

      <!-- Upload / Change Resume -->
      <div>
        <div class="bg-cyan-50 border-2 border-dashed border-cyan-200 rounded-xl p-6 text-center hover:border-cyan-400 transition-colors">
          <div class="w-12 h-12 bg-cyan-100 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
          </div>
          <% if @resume %>
            <p class="text-sm font-semibold text-gray-900 mb-1">Change Resume</p>
            <p class="text-xs text-gray-500 mb-4">Upload a new resume to update your skills profile. Your next report will use this resume.</p>
          <% else %>
            <p class="text-sm font-semibold text-gray-900 mb-1">Upload Resume</p>
            <p class="text-xs text-gray-500 mb-4">Upload your resume for AI-powered skill extraction and career analysis.</p>
          <% end %>

          <%= form_with(url: resumes_path, method: :post, multipart: true, class: "space-y-3") do |f| %>
            <div class="relative">
              <label for="dashboard_resume_file" class="block w-full px-4 py-3 bg-white border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50 transition-colors">
                <span id="dashboard-file-label" class="text-sm text-gray-400">Choose PDF or DOCX...</span>
              </label>
              <input type="file" name="resume[file]" id="dashboard_resume_file" accept=".pdf,.docx" class="sr-only" onchange="document.getElementById('dashboard-file-label').textContent = this.files[0] ? this.files[0].name : 'Choose PDF or DOCX...'">
            </div>
            <%= f.submit "Upload & Analyze", class: "w-full py-2.5 bg-cyan-500 text-white text-sm font-semibold rounded-lg hover:bg-cyan-600 transition-colors cursor-pointer" %>
          <% end %>

          <p class="mt-3 text-xs text-gray-400">PDF or DOCX up to 10MB</p>
        </div>

        <% if @resume %>
          <div class="mt-4 bg-gray-50 rounded-xl p-4">
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-cyan-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
              <p class="text-xs text-gray-500">When you upload a new resume, it becomes your <strong class="text-gray-700">active resume</strong>. Click <strong class="text-gray-700">Generate Report</strong> below to create a new career analysis based on it.</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="bg-white rounded-2xl border border-gray-100 p-8">
      <h2 class="text-xl font-semibold text-gray-900">Generate Career Report</h2>
      <p class="mt-2 text-gray-500">Get a comprehensive analysis with salary benchmarking, skill gaps, career roadmap, and interview readiness score.</p>
      <% if @resume&.completed? %>
        <p class="mt-2 text-xs text-cyan-600">Report will be based on your latest resume (<%= (@resume.parsed_data&.dig("skills") || []).size %> skills detected).</p>
      <% end %>
      <div class="mt-6">
        <%= button_to "Generate Report", career_reports_path, method: :post, class: "px-6 py-3 bg-cyan-500 text-white font-medium rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer" %>
      </div>
    </div>

    <% if @latest_report %>
      <div class="bg-white rounded-2xl border border-gray-100 p-8">
        <h2 class="text-xl font-semibold text-gray-900">Latest Report</h2>
        <p class="mt-2 text-gray-500">Generated <%= time_ago_in_words(@latest_report.created_at) %> ago</p>
        <div class="mt-4 space-y-2">
          <p class="text-sm"><span class="text-gray-500">Salary Gap:</span> <span class="font-semibold"><%= @latest_report.salary_gap_percentage %>%</span></p>
          <p class="text-sm"><span class="text-gray-500">Interview Score:</span> <span class="font-semibold"><%= @latest_report.interview_score&.round(0) %>/100</span></p>
        </div>
        <div class="mt-6 flex gap-3">
          <%= link_to "View Report", career_report_path(@latest_report), class: "px-4 py-2 bg-cyan-500 text-white text-sm font-medium rounded-lg hover:bg-cyan-600 transition-colors" %>
          <%= link_to "Download PDF", download_pdf_career_report_path(@latest_report), class: "px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Phase 2 Pro Tools -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Pro Tools</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Interview Prep -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-cyan-100 rounded-xl flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900">Interview Prep</h3>
        <p class="text-xs text-gray-500 mt-1">System Design, DSA & Behavioral prep</p>
        <%= link_to "Start Preparing", interview_prep_path, class: "mt-3 inline-block text-xs text-cyan-600 font-semibold hover:text-cyan-700" %>
      </div>

      <!-- Mock Interviews -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-purple-100 rounded-xl flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900">Mock Interview</h3>
        <p class="text-xs text-gray-500 mt-1">AI-powered practice interviews</p>
        <%= link_to "Take Interview", mock_interviews_path, class: "mt-3 inline-block text-xs text-cyan-600 font-semibold hover:text-cyan-700" %>
        <% unless current_user.subscribed? %>
          <span class="ml-2 text-[10px] font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded-full">PRO</span>
        <% end %>
      </div>

      <!-- Salary Negotiation -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-green-100 rounded-xl flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900">Salary Negotiation</h3>
        <p class="text-xs text-gray-500 mt-1">AI strategies & talking points</p>
        <%= link_to "Negotiate", negotiations_path, class: "mt-3 inline-block text-xs text-cyan-600 font-semibold hover:text-cyan-700" %>
        <% unless current_user.subscribed? %>
          <span class="ml-2 text-[10px] font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded-full">PRO</span>
        <% end %>
      </div>

      <!-- ATS Score -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-orange-100 rounded-xl flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900">ATS Score</h3>
        <p class="text-xs text-gray-500 mt-1">Check resume ATS compatibility</p>
        <%= link_to "Check Score", ats_score_path, class: "mt-3 inline-block text-xs text-cyan-600 font-semibold hover:text-cyan-700" %>
        <% unless current_user.subscribed? %>
          <span class="ml-2 text-[10px] font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded-full">PRO</span>
        <% end %>
      </div>
    </div>

    <!-- Offer Analyzer - full width -->
    <div class="bg-white rounded-2xl border border-gray-100 p-6 mt-4 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 bg-red-100 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-900">Offer Letter Analyzer</h3>
            <p class="text-xs text-gray-500 mt-0.5">Get AI analysis of job offers with red/green flags, market comparison, and recommendations</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <% unless current_user.subscribed? %>
            <span class="text-[10px] font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded-full">PRO</span>
          <% end %>
          <%= link_to "Analyze Offer", offer_analyses_path, class: "px-4 py-2 bg-cyan-500 text-white text-xs font-semibold rounded-lg hover:bg-cyan-600 transition-colors" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Community & Intelligence -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Community & Intelligence</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900">Salary Explorer</h3>
        <p class="text-xs text-gray-500 mt-1">Crowdsourced salary data from the community</p>
        <%= link_to "Explore Salaries", salary_submissions_path, class: "mt-3 inline-block text-xs text-cyan-600 font-semibold hover:text-cyan-700" %>
      </div>

      <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900">Peer Benchmark</h3>
        <p class="text-xs text-gray-500 mt-1">Compare yourself against peers in your role</p>
        <%= link_to "View Benchmark", peer_benchmark_path, class: "mt-3 inline-block text-xs text-cyan-600 font-semibold hover:text-cyan-700" %>
      </div>

      <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-indigo-100 rounded-xl flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900">Skill Trends</h3>
        <p class="text-xs text-gray-500 mt-1">Track rising & declining skill demand</p>
        <%= link_to "View Trends", skill_trends_path, class: "mt-3 inline-block text-xs text-cyan-600 font-semibold hover:text-cyan-700" %>
      </div>

      <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-amber-100 rounded-xl flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900">Interview Experiences</h3>
        <p class="text-xs text-gray-500 mt-1">Real interview stories from the community</p>
        <%= link_to "Browse Experiences", interview_experiences_path, class: "mt-3 inline-block text-xs text-cyan-600 font-semibold hover:text-cyan-700" %>
      </div>

      <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-pink-100 rounded-xl flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900">Refer & Earn</h3>
        <p class="text-xs text-gray-500 mt-1">Invite friends, earn free Pro days</p>
        <%= link_to "Your Referrals", referral_path, class: "mt-3 inline-block text-xs text-cyan-600 font-semibold hover:text-cyan-700" %>
      </div>
    </div>
  </div>

  <!-- Phase 4: Advanced Tools -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Advanced Tools</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- LinkedIn Integration -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900">LinkedIn Sync</h3>
        <p class="text-xs text-gray-500 mt-1">Import & sync your LinkedIn profile</p>
        <%= link_to "View Profile", linkedin_profile_path, class: "mt-3 inline-block text-xs text-cyan-600 font-semibold hover:text-cyan-700" %>
        <% unless current_user.subscribed? %>
          <span class="ml-2 text-[10px] font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded-full">PRO</span>
        <% end %>
      </div>

      <!-- Job Recommendations -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-teal-100 rounded-xl flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900">Job Matches</h3>
        <p class="text-xs text-gray-500 mt-1">AI-powered job recommendations</p>
        <%= link_to "View Jobs", job_recommendations_path, class: "mt-3 inline-block text-xs text-cyan-600 font-semibold hover:text-cyan-700" %>
        <% unless current_user.subscribed? %>
          <span class="ml-2 text-[10px] font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded-full">PRO</span>
        <% end %>
      </div>

      <!-- AI Career Coach -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-violet-100 rounded-xl flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900">AI Career Coach</h3>
        <p class="text-xs text-gray-500 mt-1">Chat with your personal career advisor</p>
        <%= link_to "Start Chat", career_coach_index_path, class: "mt-3 inline-block text-xs text-cyan-600 font-semibold hover:text-cyan-700" %>
        <% unless current_user.subscribed? %>
          <span class="ml-2 text-[10px] font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded-full">PRO</span>
        <% end %>
      </div>

      <!-- Enterprise Analytics -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-rose-100 rounded-xl flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900">Enterprise HR</h3>
        <p class="text-xs text-gray-500 mt-1">Team analytics & workforce insights</p>
        <%= link_to "Dashboard", enterprise_dashboard_path, class: "mt-3 inline-block text-xs text-cyan-600 font-semibold hover:text-cyan-700" %>
      </div>
    </div>
  </div>

  <!-- All Previous Reports -->
  <% if @all_reports.any? %>
    <div class="bg-white rounded-2xl border border-gray-100 p-6">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <h2 class="text-xl font-semibold text-gray-900">All Career Reports</h2>
        </div>
        <span class="text-sm text-gray-400"><%= @all_reports.count %> report<%= @all_reports.count == 1 ? '' : 's' %> generated</span>
      </div>

      <!-- Table Header -->
      <div class="hidden md:grid grid-cols-12 gap-4 px-4 py-3 text-xs font-semibold text-gray-400 uppercase tracking-wide border-b border-gray-100">
        <div class="col-span-1">#</div>
        <div class="col-span-3">Generated On</div>
        <div class="col-span-2">Salary Gap</div>
        <div class="col-span-2">Interview Score</div>
        <div class="col-span-2">Status</div>
        <div class="col-span-2 text-right">Actions</div>
      </div>

      <!-- Report Rows -->
      <div class="divide-y divide-gray-50">
        <% @all_reports.each_with_index do |report, index| %>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 px-4 py-4 items-center hover:bg-gray-50 rounded-xl transition-colors">
            <div class="col-span-1">
              <span class="hidden md:inline text-sm font-medium text-gray-400"><%= @all_reports.count - index %></span>
              <span class="md:hidden text-sm font-semibold text-gray-900">Report #<%= @all_reports.count - index %></span>
            </div>
            <div class="col-span-3">
              <p class="text-sm font-medium text-gray-900"><%= report.created_at.strftime("%B %d, %Y") %></p>
              <p class="text-xs text-gray-400"><%= report.created_at.strftime("%I:%M %p") %> &middot; <%= time_ago_in_words(report.created_at) %> ago</p>
            </div>
            <div class="col-span-2">
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-sm font-semibold
                <% if report.salary_gap_percentage.to_f > 15 %>
                  bg-red-50 text-red-600
                <% elsif report.salary_gap_percentage.to_f > 0 %>
                  bg-yellow-50 text-yellow-600
                <% else %>
                  bg-green-50 text-green-600
                <% end %>">
                <%= report.salary_gap_percentage %>%
              </span>
            </div>
            <div class="col-span-2">
              <div class="flex items-center gap-2">
                <div class="w-16 bg-gray-100 rounded-full h-2">
                  <div class="h-2 rounded-full bg-cyan-500" style="width: <%= [report.interview_score.to_f, 100].min %>%"></div>
                </div>
                <span class="text-sm font-semibold text-gray-900"><%= report.interview_score&.round(0) %>/100</span>
              </div>
            </div>
            <div class="col-span-2">
              <% if report.paid? %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-green-50 text-green-600 rounded-full text-xs font-semibold">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Paid
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-yellow-50 text-yellow-600 rounded-full text-xs font-semibold">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
                  Free
                </span>
              <% end %>
            </div>
            <div class="col-span-2 flex items-center justify-end gap-2">
              <%= link_to career_report_path(report), class: "inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-cyan-600 hover:text-cyan-700 hover:bg-cyan-50 rounded-lg transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                View
              <% end %>
              <% if report.downloadable? %>
                <%= link_to download_pdf_career_report_path(report), class: "inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                  PDF
                <% end %>
              <% else %>
                <span class="inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-gray-300 cursor-not-allowed" title="Pay to unlock PDF">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
                  PDF
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

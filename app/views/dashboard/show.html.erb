<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Welcome back, <%= current_user.full_name || current_user.email %></h1>
    <p class="mt-1 text-gray-500"><%= current_user.role %> in <%= current_user.city %> &middot; <%= current_user.experience_years %> years experience</p>
  </div>

  <!-- Quick Stats -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <% if @salary_analysis %>
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <p class="text-sm font-medium text-gray-500">Salary Position</p>
        <p class="mt-2 text-3xl font-bold <%= @salary_analysis[:underpaid_percentage] > 0 ? 'text-red-600' : 'text-green-600' %>">
          <%= @salary_analysis[:underpaid_percentage] > 0 ? "#{@salary_analysis[:underpaid_percentage]}% underpaid" : "At market rate" %>
        </p>
        <p class="mt-1 text-sm text-gray-400">
          Market median: &#8377;<%= number_with_delimiter(@salary_analysis[:salary_range][:median].to_i) %>
        </p>
      </div>
    <% else %>
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <p class="text-sm font-medium text-gray-500">Salary Position</p>
        <p class="mt-2 text-lg text-gray-400">No benchmark data available for your profile yet.</p>
      </div>
    <% end %>

    <div class="bg-white rounded-2xl border border-gray-100 p-6">
      <p class="text-sm font-medium text-gray-500">Resume Status</p>
      <% if @resume %>
        <p class="mt-2 text-lg font-semibold text-gray-900"><%= @resume.parsing_status.humanize %></p>
        <p class="mt-1 text-sm text-gray-400">Uploaded <%= time_ago_in_words(@resume.created_at) %> ago</p>
      <% else %>
        <p class="mt-2 text-lg text-gray-400">No resume uploaded</p>
        <%= link_to "Upload Resume", new_resume_path, class: "mt-2 inline-block text-sm text-cyan-600 font-medium hover:text-cyan-700" %>
      <% end %>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 p-6">
      <p class="text-sm font-medium text-gray-500">Interview Readiness</p>
      <% if @latest_report %>
        <p class="mt-2 text-3xl font-bold text-cyan-600"><%= @latest_report.interview_score&.round(0) %>/100</p>
        <p class="mt-1 text-sm text-gray-400">Based on your latest report</p>
      <% else %>
        <p class="mt-2 text-lg text-gray-400">Generate a report to see your score</p>
      <% end %>
    </div>
  </div>

  <!-- Resume Management -->
  <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-8">
    <div class="flex items-center justify-between mb-5">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-cyan-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>
        <h2 class="text-xl font-semibold text-gray-900">Your Resume</h2>
      </div>
      <span class="text-sm text-gray-400"><%= @all_resumes.count %> resume<%= @all_resumes.count == 1 ? '' : 's' %> uploaded</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Current Active Resume -->
      <div class="lg:col-span-2">
        <% if @resume %>
          <div class="bg-gray-50 rounded-xl p-5">
            <div class="flex items-start justify-between">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl flex items-center justify-center
                  <%= case @resume.parsing_status
                      when 'completed' then 'bg-green-100'
                      when 'processing' then 'bg-yellow-100'
                      when 'failed' then 'bg-red-100'
                      else 'bg-gray-100'
                      end %>">
                  <% case @resume.parsing_status %>
                  <% when 'completed' %>
                    <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <% when 'processing' %>
                    <svg class="w-6 h-6 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                  <% when 'failed' %>
                    <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <% else %>
                    <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <% end %>
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <p class="text-sm font-semibold text-gray-900">Active Resume</p>
                    <span class="px-2 py-0.5 text-xs font-medium rounded-full
                      <%= case @resume.parsing_status
                          when 'completed' then 'bg-green-100 text-green-700'
                          when 'processing' then 'bg-yellow-100 text-yellow-700'
                          when 'failed' then 'bg-red-100 text-red-700'
                          else 'bg-gray-100 text-gray-500'
                          end %>">
                      <%= @resume.parsing_status.capitalize %>
                    </span>
                  </div>
                  <p class="text-xs text-gray-500 mt-1">Uploaded on <%= @resume.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
                  <% if @resume.completed? && @resume.parsed_data.present? %>
                    <div class="flex items-center gap-3 mt-2">
                      <span class="text-xs text-gray-400">
                        <strong class="text-gray-600"><%= (@resume.parsed_data["skills"] || []).size %></strong> skills extracted
                      </span>
                      <span class="text-xs text-gray-400">
                        <strong class="text-gray-600"><%= (@resume.parsed_data["experience_entries"] || @resume.parsed_data["experience"] || []).size %></strong> experience entries
                      </span>
                      <span class="text-xs text-gray-400">
                        <strong class="text-gray-600"><%= (@resume.parsed_data["certifications"] || []).size %></strong> certifications
                      </span>
                    </div>
                  <% end %>
                </div>
              </div>
              <%= link_to resume_path(@resume), class: "text-sm text-cyan-600 font-medium hover:text-cyan-700" do %>
                View Details
              <% end %>
            </div>

            <% if @resume.completed? && @resume.parsed_data.present? %>
              <div class="mt-4 pt-4 border-t border-gray-200">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Extracted Skills</p>
                <div class="flex flex-wrap gap-1.5">
                  <% (@resume.parsed_data["skills"] || []).first(10).each do |skill| %>
                    <span class="px-2.5 py-1 bg-cyan-50 text-cyan-700 border border-cyan-100 rounded-md text-xs font-medium"><%= skill %></span>
                  <% end %>
                  <% remaining = (@resume.parsed_data["skills"] || []).size - 10 %>
                  <% if remaining > 0 %>
                    <span class="px-2.5 py-1 bg-gray-100 text-gray-500 rounded-md text-xs font-medium">+<%= remaining %> more</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>

          <!-- Previous Resumes -->
          <% if @all_resumes.count > 1 %>
            <div class="mt-4">
              <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Previous Resumes</p>
              <div class="space-y-2">
                <% @all_resumes.drop(1).first(3).each do |resume| %>
                  <div class="flex items-center justify-between px-4 py-3 bg-gray-50 rounded-lg">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 bg-gray-200 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>
                      </div>
                      <div>
                        <p class="text-sm text-gray-600">Resume #<%= resume.id %></p>
                        <p class="text-xs text-gray-400"><%= resume.created_at.strftime("%b %d, %Y") %> &middot; <%= (resume.parsed_data&.dig("skills") || []).size %> skills</p>
                      </div>
                    </div>
                    <span class="text-xs font-medium px-2 py-0.5 rounded-full
                      <%= case resume.parsing_status
                          when 'completed' then 'bg-green-100 text-green-700'
                          when 'processing' then 'bg-yellow-100 text-yellow-700'
                          when 'failed' then 'bg-red-100 text-red-700'
                          else 'bg-gray-100 text-gray-500'
                          end %>">
                      <%= resume.parsing_status.capitalize %>
                    </span>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="bg-gray-50 rounded-xl p-8 text-center">
            <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
            </div>
            <p class="text-sm text-gray-500">No resume uploaded yet. Upload one to get personalized skill analysis.</p>
          </div>
        <% end %>
      </div>

      <!-- Upload / Change Resume -->
      <div>
        <div class="bg-cyan-50 border-2 border-dashed border-cyan-200 rounded-xl p-6 text-center hover:border-cyan-400 transition-colors">
          <div class="w-12 h-12 bg-cyan-100 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
          </div>
          <% if @resume %>
            <p class="text-sm font-semibold text-gray-900 mb-1">Change Resume</p>
            <p class="text-xs text-gray-500 mb-4">Upload a new resume to update your skills profile. Your next report will use this resume.</p>
          <% else %>
            <p class="text-sm font-semibold text-gray-900 mb-1">Upload Resume</p>
            <p class="text-xs text-gray-500 mb-4">Upload your resume for AI-powered skill extraction and career analysis.</p>
          <% end %>

          <%= form_with(url: resumes_path, method: :post, multipart: true, class: "space-y-3") do |f| %>
            <div class="relative">
              <label for="dashboard_resume_file" class="block w-full px-4 py-3 bg-white border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50 transition-colors">
                <span id="dashboard-file-label" class="text-sm text-gray-400">Choose PDF or DOCX...</span>
              </label>
              <input type="file" name="resume[file]" id="dashboard_resume_file" accept=".pdf,.docx" class="sr-only" onchange="document.getElementById('dashboard-file-label').textContent = this.files[0] ? this.files[0].name : 'Choose PDF or DOCX...'">
            </div>
            <%= f.submit "Upload & Analyze", class: "w-full py-2.5 bg-cyan-500 text-white text-sm font-semibold rounded-lg hover:bg-cyan-600 transition-colors cursor-pointer" %>
          <% end %>

          <p class="mt-3 text-xs text-gray-400">PDF or DOCX up to 10MB</p>
        </div>

        <% if @resume %>
          <div class="mt-4 bg-gray-50 rounded-xl p-4">
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-cyan-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
              <p class="text-xs text-gray-500">When you upload a new resume, it becomes your <strong class="text-gray-700">active resume</strong>. Click <strong class="text-gray-700">Generate Report</strong> below to create a new career analysis based on it.</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="bg-white rounded-2xl border border-gray-100 p-8">
      <h2 class="text-xl font-semibold text-gray-900">Generate Career Report</h2>
      <p class="mt-2 text-gray-500">Get a comprehensive analysis with salary benchmarking, skill gaps, career roadmap, and interview readiness score.</p>
      <% if @resume&.completed? %>
        <p class="mt-2 text-xs text-cyan-600">Report will be based on your latest resume (<%= (@resume.parsed_data&.dig("skills") || []).size %> skills detected).</p>
      <% end %>
      <div class="mt-6">
        <%= button_to "Generate Report", career_reports_path, method: :post, class: "px-6 py-3 bg-cyan-500 text-white font-medium rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer" %>
      </div>
    </div>

    <% if @latest_report %>
      <div class="bg-white rounded-2xl border border-gray-100 p-8">
        <h2 class="text-xl font-semibold text-gray-900">Latest Report</h2>
        <p class="mt-2 text-gray-500">Generated <%= time_ago_in_words(@latest_report.created_at) %> ago</p>
        <div class="mt-4 space-y-2">
          <p class="text-sm"><span class="text-gray-500">Salary Gap:</span> <span class="font-semibold"><%= @latest_report.salary_gap_percentage %>%</span></p>
          <p class="text-sm"><span class="text-gray-500">Interview Score:</span> <span class="font-semibold"><%= @latest_report.interview_score&.round(0) %>/100</span></p>
        </div>
        <div class="mt-6 flex gap-3">
          <%= link_to "View Report", career_report_path(@latest_report), class: "px-4 py-2 bg-cyan-500 text-white text-sm font-medium rounded-lg hover:bg-cyan-600 transition-colors" %>
          <%= link_to "Download PDF", download_pdf_career_report_path(@latest_report), class: "px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- All Previous Reports -->
  <% if @all_reports.any? %>
    <div class="bg-white rounded-2xl border border-gray-100 p-6">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <h2 class="text-xl font-semibold text-gray-900">All Career Reports</h2>
        </div>
        <span class="text-sm text-gray-400"><%= @all_reports.count %> report<%= @all_reports.count == 1 ? '' : 's' %> generated</span>
      </div>

      <!-- Table Header -->
      <div class="hidden md:grid grid-cols-12 gap-4 px-4 py-3 text-xs font-semibold text-gray-400 uppercase tracking-wide border-b border-gray-100">
        <div class="col-span-1">#</div>
        <div class="col-span-3">Generated On</div>
        <div class="col-span-2">Salary Gap</div>
        <div class="col-span-2">Interview Score</div>
        <div class="col-span-2">Status</div>
        <div class="col-span-2 text-right">Actions</div>
      </div>

      <!-- Report Rows -->
      <div class="divide-y divide-gray-50">
        <% @all_reports.each_with_index do |report, index| %>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 px-4 py-4 items-center hover:bg-gray-50 rounded-xl transition-colors">
            <div class="col-span-1">
              <span class="hidden md:inline text-sm font-medium text-gray-400"><%= @all_reports.count - index %></span>
              <span class="md:hidden text-sm font-semibold text-gray-900">Report #<%= @all_reports.count - index %></span>
            </div>
            <div class="col-span-3">
              <p class="text-sm font-medium text-gray-900"><%= report.created_at.strftime("%B %d, %Y") %></p>
              <p class="text-xs text-gray-400"><%= report.created_at.strftime("%I:%M %p") %> &middot; <%= time_ago_in_words(report.created_at) %> ago</p>
            </div>
            <div class="col-span-2">
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-sm font-semibold
                <% if report.salary_gap_percentage.to_f > 15 %>
                  bg-red-50 text-red-600
                <% elsif report.salary_gap_percentage.to_f > 0 %>
                  bg-yellow-50 text-yellow-600
                <% else %>
                  bg-green-50 text-green-600
                <% end %>">
                <%= report.salary_gap_percentage %>%
              </span>
            </div>
            <div class="col-span-2">
              <div class="flex items-center gap-2">
                <div class="w-16 bg-gray-100 rounded-full h-2">
                  <div class="h-2 rounded-full bg-cyan-500" style="width: <%= [report.interview_score.to_f, 100].min %>%"></div>
                </div>
                <span class="text-sm font-semibold text-gray-900"><%= report.interview_score&.round(0) %>/100</span>
              </div>
            </div>
            <div class="col-span-2">
              <% if report.paid? %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-green-50 text-green-600 rounded-full text-xs font-semibold">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Paid
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-yellow-50 text-yellow-600 rounded-full text-xs font-semibold">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
                  Free
                </span>
              <% end %>
            </div>
            <div class="col-span-2 flex items-center justify-end gap-2">
              <%= link_to career_report_path(report), class: "inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-cyan-600 hover:text-cyan-700 hover:bg-cyan-50 rounded-lg transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                View
              <% end %>
              <% if report.paid? %>
                <%= link_to download_pdf_career_report_path(report), class: "inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                  PDF
                <% end %>
              <% else %>
                <span class="inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-gray-300 cursor-not-allowed" title="Pay to unlock PDF">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
                  PDF
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

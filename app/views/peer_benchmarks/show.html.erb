<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Peer Benchmark</h1>
      <p class="mt-1 text-gray-500">See how you compare against other <%= current_user.role %> professionals</p>
    </div>
    <%= button_to "Refresh Benchmark", peer_benchmark_path, method: :post, class: "px-5 py-2.5 bg-cyan-500 text-white text-sm font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer" %>
  </div>

  <% if @benchmark %>
    <!-- Percentile Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      <% [
        { label: "Salary Percentile", value: @benchmark.salary_percentile, color: "cyan" },
        { label: "Skill Percentile", value: @benchmark.skill_percentile, color: "purple" },
        { label: "Interview Percentile", value: @benchmark.interview_percentile, color: "green" }
      ].each do |item| %>
        <div class="bg-white rounded-2xl border border-gray-100 p-6 text-center">
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-full border-4 border-<%= item[:color] %>-100 mb-3">
            <span class="text-2xl font-bold text-<%= item[:color] %>-600"><%= item[:value]&.round(0) %></span>
          </div>
          <p class="text-sm font-medium text-gray-500"><%= item[:label] %></p>
          <p class="text-xs text-gray-400 mt-1">
            <% pct = item[:value].to_f %>
            <%= pct >= 75 ? "Top performer" : pct >= 50 ? "Above average" : pct >= 25 ? "Below average" : "Room to grow" %>
          </p>
        </div>
      <% end %>
    </div>

    <!-- Overall Score -->
    <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-gray-900">Overall Standing</h2>
        <span class="text-2xl font-bold text-cyan-600"><%= @benchmark.overall_percentile %>th percentile</span>
      </div>
      <div class="bg-gray-100 rounded-full h-4 relative">
        <div class="bg-cyan-500 h-4 rounded-full transition-all" style="width: <%= @benchmark.overall_percentile %>%"></div>
        <div class="absolute top-[-24px] text-xs font-bold text-cyan-600" style="left: <%= @benchmark.overall_percentile %>%">You</div>
      </div>
      <div class="flex justify-between text-xs text-gray-400 mt-2">
        <span>0%</span>
        <span>25%</span>
        <span>50%</span>
        <span>75%</span>
        <span>100%</span>
      </div>
    </div>

    <!-- Comparison -->
    <% comparison = @benchmark.comparison_data || {} %>
    <% if comparison.any? %>
      <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">You vs Peers</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-gray-50 rounded-xl p-5">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Salary Comparison</p>
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-600">Your Salary</span>
                <span class="text-sm font-bold text-gray-900">&#8377;<%= number_with_delimiter(comparison["your_salary"].to_i) %></span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-600">Peer Average</span>
                <span class="text-sm font-bold text-gray-900">&#8377;<%= number_with_delimiter(comparison["peer_avg_salary"].to_i) %></span>
              </div>
              <div class="flex items-center justify-between pt-2 border-t border-gray-200">
                <span class="text-sm text-gray-600">Difference</span>
                <% diff = comparison["salary_diff_pct"].to_f %>
                <span class="text-sm font-bold <%= diff >= 0 ? 'text-green-600' : 'text-red-600' %>">
                  <%= diff >= 0 ? "+" : "" %><%= diff %>%
                </span>
              </div>
            </div>
          </div>

          <div class="bg-gray-50 rounded-xl p-5">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Experience</p>
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-600">Your Experience</span>
                <span class="text-sm font-bold text-gray-900"><%= comparison["your_experience"] %> years</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-600">Peer Average</span>
                <span class="text-sm font-bold text-gray-900"><%= comparison["peer_avg_experience"] %> years</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Ranking -->
    <% ranking = @benchmark.ranking_data || {} %>
    <% if ranking.any? %>
      <div class="bg-cyan-50 rounded-2xl border border-cyan-100 p-6 mb-6">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 bg-cyan-100 rounded-full flex items-center justify-center">
            <span class="text-2xl font-bold text-cyan-600">#<%= ranking["rank"] %></span>
          </div>
          <div>
            <p class="text-lg font-semibold text-cyan-900">You rank #<%= ranking["rank"] %> out of <%= ranking["total"] %> peers</p>
            <p class="text-sm text-cyan-600">Top <%= ranking["top_pct"] %>% of <%= current_user.role %> professionals</p>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Distribution -->
    <% distribution = @benchmark.peer_distribution || [] %>
    <% if distribution.any? %>
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Salary Distribution Among Peers</h2>
        <div class="space-y-3">
          <% max_count = distribution.map { |d| d["count"].to_i }.max.to_f %>
          <% distribution.each do |bucket| %>
            <div class="flex items-center gap-4">
              <span class="text-sm font-medium text-gray-600 w-16"><%= bucket["label"] %></span>
              <div class="flex-1 bg-gray-100 rounded-full h-6">
                <% width = max_count > 0 ? (bucket["count"].to_i / max_count * 100).round : 0 %>
                <div class="h-6 rounded-full flex items-center justify-end px-2 <%= bucket["is_user"] ? 'bg-cyan-500' : 'bg-gray-300' %>" style="width: <%= [width, 3].max %>%">
                  <% if width > 10 %>
                    <span class="text-xs font-bold text-white"><%= bucket["count"] %></span>
                  <% end %>
                </div>
              </div>
              <% if bucket["is_user"] %>
                <span class="text-xs font-bold text-cyan-600">You</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <p class="text-xs text-gray-400 mt-4 text-center">Based on <%= @benchmark.peer_count %> peers &middot; Last updated <%= time_ago_in_words(@benchmark.created_at) %> ago</p>

  <% else %>
    <div class="bg-white rounded-2xl border border-gray-100 p-12 text-center">
      <div class="w-16 h-16 bg-cyan-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">No peer benchmark yet</h3>
      <p class="text-gray-500 mb-6">Generate a benchmark to see how you compare against other professionals in your role.</p>
      <%= button_to "Generate Benchmark", peer_benchmark_path, method: :post, class: "inline-flex items-center px-6 py-3 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>

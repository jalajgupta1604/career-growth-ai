<div class="min-h-screen bg-gray-50 flex">
  <!-- Left Panel -->
  <div class="hidden lg:flex lg:w-1/2 bg-gray-900 flex-col justify-between p-12">
    <div class="flex items-center space-x-2">
      <div class="w-8 h-8 bg-cyan-500 rounded-lg flex items-center justify-center">
        <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
      </div>
      <span class="text-xl font-bold text-white">Career Growth AI</span>
    </div>
    <div>
      <h2 class="text-4xl font-bold text-white leading-tight">Know Your Real<br><span class="text-cyan-400">Market Value.</span></h2>
      <p class="mt-4 text-gray-400 text-lg">AI-powered salary benchmarking and career roadmaps for Indian IT professionals.</p>
      <div class="mt-10 grid grid-cols-3 gap-6">
        <div>
          <p class="text-2xl font-bold text-white">50k+</p>
          <p class="text-sm text-gray-500">Users Profiled</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-white">&#8377;12L</p>
          <p class="text-sm text-gray-500">Avg. Benchmark</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-cyan-400">AI</p>
          <p class="text-sm text-gray-500">Powered</p>
        </div>
      </div>
    </div>
    <p class="text-sm text-gray-600">Trusted by professionals at Google, Amazon, Flipkart, and 1,200+ companies.</p>
  </div>

  <!-- Right Panel -->
  <div class="w-full lg:w-1/2 flex items-center justify-center p-8">
    <div class="w-full max-w-md">
      <!-- Mobile logo -->
      <div class="flex items-center space-x-2 mb-8 lg:hidden">
        <div class="w-8 h-8 bg-cyan-500 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        </div>
        <span class="text-xl font-bold text-gray-900">Career Growth AI</span>
      </div>

      <h1 class="text-3xl font-bold text-gray-900">Welcome back</h1>
      <p class="mt-2 text-gray-500">Sign in to access your career dashboard.</p>

      <!-- Google OAuth -->
      <div class="mt-8">
        <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false }, class: "w-full flex items-center justify-center gap-3 px-6 py-3.5 bg-white border-2 border-gray-200 rounded-xl font-semibold text-gray-700 hover:bg-gray-50 hover:border-gray-300 transition-all cursor-pointer" do %>
          <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          Continue with Google
        <% end %>
      </div>

      <!-- Divider -->
      <div class="relative my-8">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-gray-200"></div></div>
        <div class="relative flex justify-center text-sm"><span class="px-4 bg-gray-50 text-gray-400">or sign in with email</span></div>
      </div>

      <!-- Email/Password Form -->
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Email address</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com",
                class: "w-full pl-10 pr-4 py-3 bg-white border border-gray-200 rounded-xl text-gray-700 focus:border-cyan-500 focus:ring-cyan-500 transition-colors" %>
          </div>
        </div>

        <div>
          <div class="flex justify-between items-center mb-2">
            <label class="block text-sm font-semibold text-gray-700">Password</label>
            <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-sm text-cyan-600 hover:text-cyan-700 font-medium" %>
          </div>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            </div>
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "Enter your password",
                class: "w-full pl-10 pr-4 py-3 bg-white border border-gray-200 rounded-xl text-gray-700 focus:border-cyan-500 focus:ring-cyan-500 transition-colors" %>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "w-4 h-4 text-cyan-500 border-gray-300 rounded focus:ring-cyan-500" %>
            <label class="ml-2 text-sm text-gray-600">Remember me for 30 days</label>
          </div>
        <% end %>

        <%= f.submit "Sign in", class: "w-full py-3.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer text-lg" %>
      <% end %>

      <p class="mt-8 text-center text-sm text-gray-500">
        Use your Google account to get started instantly.
      </p>
    </div>
  </div>
</div>

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Import LinkedIn Profile</h1>
    <p class="mt-1 text-gray-500">Manually enter your LinkedIn data to sync skills and experience</p>
  </div>

  <div class="bg-white rounded-2xl border border-gray-100 p-8">
    <%= form_with(url: linkedin_profile_path, method: :post, scope: :linkedin_profile, class: "space-y-6") do |f| %>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">LinkedIn Profile URL</label>
        <%= f.text_field :linkedin_url, value: @profile&.linkedin_url, placeholder: "https://linkedin.com/in/yourname", class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Professional Headline</label>
        <%= f.text_field :headline, value: @profile&.headline, placeholder: "e.g., Senior Software Engineer at Google", class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Industry</label>
          <%= f.text_field :industry, value: @profile&.industry, placeholder: "e.g., Information Technology", class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Location</label>
          <%= f.text_field :location, value: @profile&.location || current_user.city, placeholder: "e.g., Bangalore, India", class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Work Experience</label>
        <p class="text-xs text-gray-400 mb-2">One position per line. Format: Title - Company (e.g., "Senior Engineer - Google")</p>
        <%= f.text_area :positions_text, rows: 5, placeholder: "Senior Software Engineer - Google\nSoftware Engineer - Microsoft\nJunior Developer - Infosys", class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Skills</label>
        <p class="text-xs text-gray-400 mb-2">Comma-separated or one per line</p>
        <%= f.text_area :skills_text, rows: 4, placeholder: "JavaScript, React, Node.js, Python, AWS, Docker", class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
      </div>

      <div class="flex items-center justify-between pt-4">
        <%= link_to "Cancel", linkedin_profile_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
        <%= f.submit "Import Profile", class: "px-6 py-3 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

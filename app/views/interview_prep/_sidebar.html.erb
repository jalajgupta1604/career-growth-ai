<aside class="hidden lg:flex lg:flex-col w-64 border-r border-gray-200 bg-white fixed h-full overflow-y-auto z-30"
       data-interview-prep-target="sidebar">
  <div class="p-6">
    <!-- Logo -->
    <div class="flex items-center gap-3 mb-8">
      <div class="w-10 h-10 rounded-full bg-cyan-50 flex items-center justify-center text-cyan-500">
        <span class="material-symbols-outlined font-bold">school</span>
      </div>
      <span class="text-xl font-bold tracking-tight text-gray-900">PrepMaster</span>
    </div>

    <!-- User Info -->
    <div class="flex items-center gap-3 p-3 mb-8 rounded-xl bg-gray-50 border border-gray-100">
      <%= user_avatar(current_user, size: "w-10 h-10", extra_class: "shrink-0") %>
      <div class="flex flex-col min-w-0">
        <span class="text-sm font-semibold text-gray-900 truncate"><%= current_user.full_name || "User" %></span>
        <span class="text-xs text-gray-500">L<%= [current_user.experience_years.to_i / 2, 10].min %> Candidate</span>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="space-y-1">
      <%= link_to interview_prep_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg #{action_name == 'show' ? 'bg-cyan-50 text-cyan-600 font-medium' : 'text-gray-600 hover:bg-gray-100 transition-colors'}" do %>
        <span class="material-symbols-outlined">dashboard</span>
        <span>Dashboard</span>
      <% end %>

      <%= link_to interview_prep_path(anchor: "categories"), class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors" do %>
        <span class="material-symbols-outlined text-[24px]">book_5</span>
        <span>Modules</span>
      <% end %>

      <%= link_to mock_interviews_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors" do %>
        <span class="material-symbols-outlined text-[24px]">interpreter_mode</span>
        <span>Mock Interviews</span>
      <% end %>

      <%= link_to daily_challenge_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors" do %>
        <span class="material-symbols-outlined text-[24px]">bolt</span>
        <span>Daily Challenge</span>
      <% end %>

      <%= link_to company_packs_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors" do %>
        <span class="material-symbols-outlined text-[24px]">business</span>
        <span>Company Packs</span>
      <% end %>

      <%= link_to interview_debriefs_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors" do %>
        <span class="material-symbols-outlined text-[24px]">rate_review</span>
        <span>Debriefs</span>
      <% end %>

      <%= link_to revisions_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors" do %>
        <span class="material-symbols-outlined text-[24px]">psychology</span>
        <span>Smart Revision</span>
      <% end %>

      <%= link_to new_interview_simulator_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors" do %>
        <span class="material-symbols-outlined text-[24px]">smart_toy</span>
        <span>AI Simulator</span>
      <% end %>

      <%= link_to coding_playground_index_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors" do %>
        <span class="material-symbols-outlined text-[24px]">code</span>
        <span>Code Playground</span>
      <% end %>

      <%= link_to peer_practice_index_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors" do %>
        <span class="material-symbols-outlined text-[24px]">group</span>
        <span>Peer Practice</span>
      <% end %>

      <div class="pt-4 mt-4 border-t border-gray-100">
        <%= link_to interview_prep_path(anchor: "resources"), class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors" do %>
          <span class="material-symbols-outlined text-[24px]">library_books</span>
          <span>Resources</span>
        <% end %>
        <%= link_to dashboard_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors" do %>
          <span class="material-symbols-outlined text-[24px]">arrow_back</span>
          <span>Main Dashboard</span>
        <% end %>
      </div>
    </nav>
  </div>

  <!-- Upgrade CTA -->
  <% unless current_user.subscribed? %>
    <div class="mt-auto p-6">
      <div class="bg-cyan-50 rounded-xl p-4 border border-cyan-100">
        <p class="text-xs font-bold text-cyan-600 mb-1 uppercase tracking-wider">Upgrade Pro</p>
        <p class="text-xs text-gray-500 mb-3 leading-relaxed">Unlock unlimited L7 system design cases.</p>
        <%= link_to "Go Premium", pricing_path, class: "block w-full py-2 bg-cyan-500 text-white text-xs font-bold rounded-lg hover:bg-cyan-600 transition-all text-center" %>
      </div>
    </div>
  <% end %>
</aside>

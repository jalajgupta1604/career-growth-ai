<div class="flex min-h-screen bg-gray-50" data-controller="interview-prep">
  <!-- Mobile Header -->
  <div class="lg:hidden bg-white border-b border-gray-200 px-4 py-3 flex items-center justify-between fixed top-0 left-0 right-0 z-40">
    <button data-action="click->interview-prep#toggleSidebar" class="p-2 rounded-lg hover:bg-gray-100">
      <span class="material-symbols-outlined text-gray-600">menu</span>
    </button>
    <span class="text-sm font-bold text-gray-900">PrepMaster</span>
    <div class="w-8 h-8 bg-cyan-50 rounded-full flex items-center justify-center">
      <span class="text-xs font-semibold text-cyan-600"><%= current_user.full_name&.first&.upcase || "U" %></span>
    </div>
  </div>

  <%= render "interview_prep/sidebar" %>

  <!-- Main Content -->
  <main class="flex-1 ml-0 lg:ml-64 mt-14 lg:mt-0">
    <div class="max-w-4xl px-4 sm:px-6 lg:px-8 py-6">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm mb-6">
        <%= link_to "Interview Prep", interview_prep_path, class: "text-gray-400 hover:text-cyan-500 transition-colors" %>
        <span class="material-symbols-outlined text-gray-300 text-[16px]">chevron_right</span>
        <span class="text-gray-400"><%= @category.name %></span>
        <span class="material-symbols-outlined text-gray-300 text-[16px]">chevron_right</span>
        <span class="text-gray-900 font-medium truncate"><%= @lesson.title %></span>
      </nav>

      <!-- Lesson Header -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
        <div class="flex items-start justify-between mb-4">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2.5 py-0.5 text-xs font-medium rounded-full <%= prep_color(@category.color_class, :light) %> <%= prep_color(@category.color_class, :text) %>"><%= @category.name %></span>
              <span class="text-xs text-gray-400"><%= @lesson.difficulty_label %></span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900"><%= @lesson.title %></h1>
            <p class="text-sm text-gray-500 mt-2 leading-relaxed"><%= @lesson.description %></p>
          </div>
          <% if @status == "completed" %>
            <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-green-50 text-green-600 rounded-full text-xs font-semibold shrink-0">
              <span class="material-symbols-outlined text-[16px]">check_circle</span>
              Completed
            </span>
          <% elsif @status == "in_progress" %>
            <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-yellow-50 text-yellow-600 rounded-full text-xs font-semibold shrink-0">
              <span class="material-symbols-outlined text-[16px]">schedule</span>
              In Progress
            </span>
          <% end %>
        </div>

        <div class="flex flex-wrap items-center gap-4 text-sm text-gray-400">
          <span class="inline-flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[18px]">schedule</span>
            <%= @lesson.duration_minutes %> minutes
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[18px]">sell</span>
            <%= @lesson.topic %>
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[18px]">assignment</span>
            Lesson <%= (@current_index || 0) + 1 %> of <%= @siblings.size %>
          </span>
        </div>
      </div>

      <!-- Lesson Content -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
        <% content = @lesson.content_data %>
        <% if content.present? && content["sections"].present? %>
          <% content["sections"].each_with_index do |section, idx| %>
            <div class="<%= idx > 0 ? 'mt-8 pt-8 border-t border-gray-100' : '' %>">
              <h2 class="text-lg font-bold text-gray-900 mb-3"><%= section["title"] %></h2>
              <div class="prose prose-sm max-w-none text-gray-600 leading-relaxed">
                <p><%= section["body"] %></p>
              </div>
            </div>
          <% end %>

          <% if content["key_points"].present? %>
            <div class="mt-8 bg-cyan-50 rounded-xl p-5">
              <h3 class="text-sm font-bold text-cyan-700 mb-3 flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px]">bolt</span>
                Key Takeaways
              </h3>
              <ul class="space-y-2.5">
                <% content["key_points"].each do |point| %>
                  <li class="flex items-start gap-2.5 text-sm text-cyan-800">
                    <span class="material-symbols-outlined text-cyan-500 text-[16px] mt-0.5 shrink-0">check</span>
                    <%= point %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        <% else %>
          <div class="py-16 text-center">
            <div class="w-14 h-14 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined text-gray-400 text-[28px]">menu_book</span>
            </div>
            <p class="text-sm font-medium text-gray-500 mb-1">Lesson content coming soon</p>
            <p class="text-xs text-gray-400">This module is being prepared. Check back later!</p>
          </div>
        <% end %>
      </div>

      <!-- AI Practice Questions -->
      <% if @ai_questions.present? && @ai_questions.any? %>
        <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-9 h-9 bg-cyan-500 rounded-lg flex items-center justify-center">
              <span class="material-symbols-outlined text-white text-[20px]">bolt</span>
            </div>
            <div>
              <h2 class="text-lg font-bold text-gray-900">AI Practice Questions</h2>
              <p class="text-xs text-gray-400">Personalized questions based on your role and this topic</p>
            </div>
          </div>

          <div class="space-y-3">
            <% @ai_questions.each_with_index do |q, index| %>
              <div class="border border-gray-100 rounded-xl overflow-hidden" data-controller="accordion">
                <button data-action="click->accordion#toggle" class="w-full flex items-center justify-between p-4 text-left hover:bg-gray-50 transition-colors">
                  <div class="flex items-center gap-3">
                    <span class="w-7 h-7 bg-cyan-50 text-cyan-600 rounded-full flex items-center justify-center text-xs font-bold shrink-0"><%= index + 1 %></span>
                    <span class="text-sm font-medium text-gray-900"><%= q["question"] %></span>
                  </div>
                  <div class="flex items-center gap-2 shrink-0 ml-3">
                    <% if q["difficulty"].present? %>
                      <span class="px-2 py-0.5 text-[11px] font-medium rounded-full
                        <%= case q["difficulty"].to_s.downcase
                            when "easy" then "bg-green-50 text-green-600"
                            when "hard" then "bg-red-50 text-red-600"
                            else "bg-yellow-50 text-yellow-600"
                            end %>">
                        <%= q["difficulty"].capitalize %>
                      </span>
                    <% end %>
                    <span data-accordion-target="icon" class="material-symbols-outlined text-gray-400 text-[20px] transition-transform">expand_more</span>
                  </div>
                </button>
                <div data-accordion-target="content" class="hidden border-t border-gray-100 p-4 bg-gray-50">
                  <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Model Answer</p>
                  <p class="text-sm text-gray-600 leading-relaxed"><%= q["model_answer"] %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Bottom Navigation -->
      <div class="flex items-center justify-between py-2">
        <div>
          <% if @prev_lesson %>
            <%= link_to interview_prep_lesson_path(@prev_lesson), class: "inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors" do %>
              <span class="material-symbols-outlined text-[18px]">chevron_left</span>
              Previous
            <% end %>
          <% end %>
        </div>

        <div class="flex items-center gap-3">
          <% unless @status == "completed" %>
            <%= button_to interview_prep_complete_lesson_path(@lesson), method: :post, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-green-500 text-white text-sm font-semibold rounded-lg hover:bg-green-600 transition-colors cursor-pointer" do %>
              <span class="material-symbols-outlined text-[18px]">check_circle</span>
              Mark as Complete
            <% end %>
          <% else %>
            <span class="inline-flex items-center gap-2 px-5 py-2.5 bg-green-100 text-green-700 text-sm font-semibold rounded-lg">
              <span class="material-symbols-outlined text-[18px]">check_circle</span>
              Completed
            </span>
          <% end %>

          <% if @next_lesson %>
            <%= link_to interview_prep_lesson_path(@next_lesson), class: "inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors" do %>
              Next
              <span class="material-symbols-outlined text-[18px]">chevron_right</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </main>
</div>

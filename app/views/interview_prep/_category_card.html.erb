<%# locals: (category_data:) %>
<% cat = category_data[:category] %>
<% total = category_data[:total_lessons] %>
<% completed = category_data[:completed_count] %>
<% progress = category_data[:progress_percentage] %>
<% color = cat.color_class || "cyan" %>
<% first_lesson = cat.prep_lessons.first %>
<% is_mock = cat.icon_name == "video" %>

<%= link_to (first_lesson ? interview_prep_lesson_path(first_lesson) : "#"), class: "block p-5 bg-white border border-gray-100 rounded-2xl hover:border-cyan-300 hover:shadow-md transition-all group" do %>
  <div class="flex justify-between items-start mb-4">
    <div class="w-10 h-10 rounded-lg <%= prep_color(color, :light) %> <%= prep_color(color, :text) %> flex items-center justify-center">
      <span class="material-symbols-outlined"><%= prep_color(color, :icon) %></span>
    </div>
    <span class="text-[11px] font-bold text-gray-400 group-hover:text-cyan-500 transition-colors"><%= completed %>/<%= total %> <%= is_mock ? "SESSIONS" : "LESSONS" %></span>
  </div>

  <h4 class="font-bold text-gray-900 mb-1"><%= cat.name %></h4>
  <p class="text-xs text-gray-500 mb-4 line-clamp-2"><%= cat.description %></p>

  <div class="space-y-2">
    <div class="flex justify-between text-[10px] font-bold uppercase text-gray-400 tracking-wider">
      <span>Progress</span>
      <span><%= progress %>%</span>
    </div>
    <div class="h-1.5 w-full bg-gray-100 rounded-full overflow-hidden">
      <div class="<%= prep_color(color, :bar) %> h-full transition-all duration-500" style="width: <%= progress %>%"></div>
    </div>
  </div>
<% end %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to skill_trends_path, class: "text-sm text-gray-500 hover:text-gray-700" do %>
      &larr; Back to Trends
    <% end %>
  </div>

  <div class="bg-white rounded-2xl border border-gray-100 p-8 mb-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= @detail[:skill_name] %></h1>
        <p class="text-sm text-gray-500 mt-1">Skill demand trend analysis</p>
      </div>
      <div class="text-right">
        <p class="text-3xl font-bold text-cyan-600"><%= @detail[:current_demand] %></p>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold
          <%= @detail[:trend_direction] == 'rising' ? 'bg-green-100 text-green-700' : @detail[:trend_direction] == 'declining' ? 'bg-red-100 text-red-700' : 'bg-gray-100 text-gray-700' %>">
          <%= @detail[:trend_direction]&.capitalize %>
        </span>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-gray-100">
      <div>
        <p class="text-xs text-gray-400">Salary Premium</p>
        <p class="text-lg font-bold text-green-600">+<%= @detail[:salary_premium] %>%</p>
      </div>
      <div>
        <p class="text-xs text-gray-400">Current Demand</p>
        <p class="text-lg font-bold text-gray-900"><%= @detail[:current_demand] %>/100</p>
      </div>
    </div>
  </div>

  <% if @detail[:history].size > 1 %>
    <div class="bg-white rounded-2xl border border-gray-100 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Demand History</h2>
      <div class="space-y-2">
        <% @detail[:history].each do |point| %>
          <div class="flex items-center gap-4">
            <span class="text-sm text-gray-500 w-20"><%= point[:period] %></span>
            <div class="flex-1 bg-gray-100 rounded-full h-4">
              <div class="bg-cyan-500 h-4 rounded-full" style="width: <%= point[:demand] %>%"></div>
            </div>
            <span class="text-sm font-bold text-gray-900 w-10 text-right"><%= point[:demand] %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

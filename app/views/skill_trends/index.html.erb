<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Skill Demand Trends</h1>
      <p class="mt-1 text-gray-500">Track which skills are rising and falling in demand</p>
    </div>
    <div class="flex items-center gap-3">
      <!-- Role Filter -->
      <%= form_with url: skill_trends_path, method: :get, class: "flex items-center gap-2" do %>
        <select name="role" class="rounded-lg border border-gray-200 px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500" onchange="this.form.submit()">
          <% @data[:available_roles].each do |role| %>
            <option value="<%= role %>" <%= "selected" if @selected_role == role %>><%= role %></option>
          <% end %>
        </select>
      <% end %>
    </div>
  </div>

  <p class="text-sm text-gray-400 mb-6"><%= @data[:total_skills_tracked] %> skills tracked for <%= @selected_role %></p>

  <!-- Rising Skills -->
  <% if @data[:rising].any? %>
    <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
      <div class="flex items-center gap-2 mb-4">
        <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        <h2 class="text-lg font-semibold text-green-700">Rising Skills</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <% @data[:rising].each do |trend| %>
          <div class="flex items-center justify-between p-4 bg-green-50 rounded-xl">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center">
                <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
              </span>
              <div>
                <p class="text-sm font-semibold text-gray-900"><%= trend.skill_name %></p>
                <p class="text-xs text-gray-400">+<%= trend.salary_premium_pct %>% salary premium</p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-lg font-bold text-green-600"><%= trend.demand_score %></p>
              <p class="text-xs text-gray-400">demand</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- All Trending Skills -->
  <% if @data[:trending].any? %>
    <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">All Skills by Demand</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs font-semibold text-gray-400 uppercase tracking-wide border-b border-gray-100">
              <th class="text-left py-3 px-2">#</th>
              <th class="text-left py-3 px-2">Skill</th>
              <th class="text-left py-3 px-2">Trend</th>
              <th class="text-right py-3 px-2">Demand Score</th>
              <th class="text-right py-3 px-2">Salary Premium</th>
              <th class="text-right py-3 px-2">Job Postings</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            <% @data[:trending].each_with_index do |trend, idx| %>
              <tr class="hover:bg-gray-50">
                <td class="py-3 px-2 text-gray-400 font-medium"><%= idx + 1 %></td>
                <td class="py-3 px-2 font-semibold text-gray-900"><%= trend.skill_name %></td>
                <td class="py-3 px-2">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold
                    bg-<%= trend.trend_badge_color %>-100 text-<%= trend.trend_badge_color %>-700">
                    <% if trend.rising? %>
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
                    <% elsif trend.declining? %>
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M14.707 10.293a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 12.586V5a1 1 0 012 0v7.586l2.293-2.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                    <% end %>
                    <%= trend.trend_direction.capitalize %>
                  </span>
                </td>
                <td class="py-3 px-2 text-right font-bold text-gray-900"><%= trend.demand_score %></td>
                <td class="py-3 px-2 text-right text-cyan-600 font-medium">+<%= trend.salary_premium_pct %>%</td>
                <td class="py-3 px-2 text-right text-gray-500"><%= number_with_delimiter(trend.job_postings_count) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Declining Skills -->
  <% if @data[:declining].any? %>
    <div class="bg-white rounded-2xl border border-gray-100 p-6">
      <div class="flex items-center gap-2 mb-4">
        <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/></svg>
        <h2 class="text-lg font-semibold text-red-700">Declining Skills</h2>
      </div>
      <div class="flex flex-wrap gap-2">
        <% @data[:declining].each do |trend| %>
          <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-red-50 text-red-700 border border-red-100 rounded-lg text-xs font-medium">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M14.707 10.293a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 12.586V5a1 1 0 012 0v7.586l2.293-2.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <%= trend.skill_name %> (<%= trend.demand_score %>)
          </span>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @data[:trending].empty? %>
    <div class="bg-white rounded-2xl border border-gray-100 p-12 text-center">
      <div class="w-16 h-16 bg-cyan-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">No trend data yet</h3>
      <p class="text-gray-500 mb-6">Skill trend data will appear as more users join and data is collected.</p>
      <%= button_to "Seed Trend Data", seed_skill_trends_path, method: :post, class: "inline-flex items-center px-5 py-2.5 bg-cyan-500 text-white text-sm font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>

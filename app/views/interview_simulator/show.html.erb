<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <% if @interview.completed? && @scorecard %>
      <!-- ==================== SCORECARD VIEW ==================== -->

      <div class="mb-6">
        <%= link_to new_interview_simulator_path, class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 transition-colors" do %>
          <span class="material-symbols-outlined text-[18px]">arrow_back</span>
          Start New Simulation
        <% end %>
      </div>

      <!-- Scorecard Header -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
        <div class="flex items-center justify-between flex-wrap gap-4">
          <div>
            <h1 class="text-2xl font-bold text-gray-900"><%= @company[:name] %> Interview Scorecard</h1>
            <p class="text-sm text-gray-500 mt-1"><%= @interview.interview_type.humanize %> &middot; <%= @interview.difficulty.capitalize %></p>
          </div>
          <div>
            <%
              verdict = @scorecard["verdict"]
              verdict_classes = case verdict
                when "Strong Hire" then "bg-green-100 text-green-700 border-green-200"
                when "Hire" then "bg-cyan-100 text-cyan-700 border-cyan-200"
                when "Lean Hire" then "bg-yellow-100 text-yellow-700 border-yellow-200"
                when "Lean No Hire" then "bg-orange-100 text-orange-700 border-orange-200"
                when "No Hire" then "bg-red-100 text-red-700 border-red-200"
                else "bg-gray-100 text-gray-700 border-gray-200"
              end
            %>
            <span class="inline-flex items-center px-4 py-1.5 text-sm font-bold rounded-full border <%= verdict_classes %>">
              <%= verdict %>
            </span>
          </div>
        </div>
      </div>

      <!-- Score Overview -->
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
        <!-- Overall Score Circle -->
        <div class="bg-white rounded-2xl border border-gray-100 p-6 flex flex-col items-center justify-center">
          <div class="relative w-24 h-24 mb-3">
            <svg class="w-24 h-24 -rotate-90" viewBox="0 0 96 96">
              <circle cx="48" cy="48" r="40" fill="none" stroke="#f3f4f6" stroke-width="8"/>
              <circle cx="48" cy="48" r="40" fill="none" stroke="#06b6d4" stroke-width="8"
                stroke-dasharray="<%= ((@scorecard["overall_score"].to_f / 10) * 251.2).round(1) %> 251.2"
                stroke-linecap="round"/>
            </svg>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-2xl font-bold text-gray-900"><%= @scorecard["overall_score"] %></span>
            </div>
          </div>
          <p class="text-xs font-medium text-gray-500">Overall Score</p>
        </div>

        <!-- Communication Score -->
        <div class="bg-white rounded-2xl border border-gray-100 p-6 flex flex-col items-center justify-center">
          <div class="flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-cyan-500 text-[28px]">forum</span>
          </div>
          <span class="text-3xl font-bold text-gray-900"><%= @scorecard["communication_score"] %></span>
          <span class="text-xs text-gray-400">/10</span>
          <p class="text-xs font-medium text-gray-500 mt-1">Communication</p>
        </div>

        <!-- Technical Depth Score -->
        <div class="bg-white rounded-2xl border border-gray-100 p-6 flex flex-col items-center justify-center">
          <div class="flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-cyan-500 text-[28px]">code</span>
          </div>
          <span class="text-3xl font-bold text-gray-900"><%= @scorecard["technical_depth_score"] %></span>
          <span class="text-xs text-gray-400">/10</span>
          <p class="text-xs font-medium text-gray-500 mt-1">Technical Depth</p>
        </div>

        <!-- Hire Probability -->
        <div class="bg-white rounded-2xl border border-gray-100 p-6 flex flex-col items-center justify-center">
          <div class="flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-cyan-500 text-[28px]">trending_up</span>
          </div>
          <span class="text-3xl font-bold text-gray-900"><%= @scorecard["hire_probability"] %>%</span>
          <p class="text-xs font-medium text-gray-500 mt-1">Hire Probability</p>
        </div>
      </div>

      <!-- Category Scores -->
      <% if @scorecard["category_scores"].present? %>
        <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Category Breakdown</h2>
          <div class="space-y-3">
            <% @scorecard["category_scores"].each do |category, score| %>
              <div class="flex items-center gap-4">
                <span class="text-sm font-medium text-gray-700 w-40 shrink-0 truncate"><%= category %></span>
                <div class="flex-1 bg-gray-100 rounded-full h-3">
                  <div class="h-3 rounded-full <%= score.to_f >= 7 ? 'bg-green-400' : score.to_f >= 5 ? 'bg-cyan-400' : 'bg-orange-400' %>" style="width: <%= (score.to_f / 10 * 100).round %>%"></div>
                </div>
                <span class="text-sm font-bold text-gray-700 w-12 text-right"><%= score %>/10</span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Strengths & Improvements -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <% if (@scorecard["strengths"] || []).any? %>
          <div class="bg-white rounded-2xl border border-gray-100 p-6">
            <div class="flex items-center gap-2 mb-4">
              <span class="material-symbols-outlined text-green-500 text-[20px]">thumb_up</span>
              <h3 class="text-sm font-semibold text-gray-900">Top Strengths</h3>
            </div>
            <ul class="space-y-2">
              <% @scorecard["strengths"].each do |strength| %>
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  <span class="text-sm text-green-700"><%= strength %></span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if (@scorecard["improvements"] || []).any? %>
          <div class="bg-white rounded-2xl border border-gray-100 p-6">
            <div class="flex items-center gap-2 mb-4">
              <span class="material-symbols-outlined text-orange-500 text-[20px]">trending_up</span>
              <h3 class="text-sm font-semibold text-gray-900">Areas to Improve</h3>
            </div>
            <ul class="space-y-2">
              <% @scorecard["improvements"].each do |improvement| %>
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-orange-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                  <span class="text-sm text-orange-700"><%= improvement %></span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>

      <!-- All Q&A Pairs -->
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Interview Questions & Answers</h2>
      <div class="space-y-4 mb-8">
        <% (@interview.questions_data || []).each_with_index do |question, idx| %>
          <% response = @responses.find { |r| r["question_index"] == idx } %>
          <% follow_up = @follow_ups[idx.to_s] %>
          <div class="bg-white rounded-2xl border border-gray-100 p-6">
            <div class="flex items-start gap-3 mb-4">
              <span class="w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center text-sm font-bold text-gray-600 shrink-0">Q<%= idx + 1 %></span>
              <div class="flex-1">
                <p class="text-sm font-semibold text-gray-900"><%= question["question"] %></p>
                <span class="text-xs text-gray-400"><%= question["category"] %></span>
              </div>
              <% if response %>
                <% score = response.dig("feedback", "score").to_i %>
                <span class="text-sm font-bold shrink-0 <%= score >= 7 ? 'text-green-600' : score >= 5 ? 'text-yellow-600' : 'text-red-600' %>">
                  <%= score %>/10
                </span>
              <% end %>
            </div>

            <% if response %>
              <div class="ml-11 space-y-3">
                <div class="bg-gray-50 rounded-xl p-4">
                  <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Your Answer</p>
                  <p class="text-sm text-gray-700"><%= response["answer"] %></p>
                </div>

                <% feedback = response["feedback"] || {} %>

                <% if (feedback["strengths"] || []).any? %>
                  <div class="bg-green-50 rounded-xl p-3">
                    <p class="text-xs font-semibold text-green-700 mb-1">Strengths</p>
                    <ul class="space-y-1">
                      <% feedback["strengths"].each do |s| %>
                        <li class="text-xs text-green-600 flex items-start gap-1">
                          <svg class="w-3 h-3 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                          <%= s %>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>

                <% if (feedback["improvements"] || []).any? %>
                  <div class="bg-yellow-50 rounded-xl p-3">
                    <p class="text-xs font-semibold text-yellow-700 mb-1">Improvements</p>
                    <ul class="space-y-1">
                      <% feedback["improvements"].each do |s| %>
                        <li class="text-xs text-yellow-600 flex items-start gap-1">
                          <svg class="w-3 h-3 text-yellow-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                          <%= s %>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>

                <% if feedback["model_answer"].present? %>
                  <div class="bg-cyan-50 rounded-xl p-3">
                    <p class="text-xs font-semibold text-cyan-700 mb-1">Model Answer</p>
                    <p class="text-xs text-cyan-600"><%= feedback["model_answer"] %></p>
                  </div>
                <% end %>

                <% if feedback["tip"].present? %>
                  <p class="text-xs text-gray-500 italic"><%= feedback["tip"] %></p>
                <% end %>

                <% if follow_up && follow_up["question"].present? %>
                  <div class="bg-cyan-50 border border-cyan-200 rounded-xl p-3">
                    <div class="flex items-center gap-1.5 mb-1">
                      <span class="material-symbols-outlined text-cyan-600 text-[16px]">reply</span>
                      <p class="text-xs font-semibold text-cyan-700">Follow-up Question</p>
                    </div>
                    <p class="text-sm text-cyan-800"><%= follow_up["question"] %></p>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- New Simulation CTA -->
      <div class="text-center">
        <%= link_to new_interview_simulator_path, class: "inline-flex items-center gap-2 px-8 py-3 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors" do %>
          <span class="material-symbols-outlined text-[20px]">refresh</span>
          Start New Simulation
        <% end %>
      </div>

    <% elsif @question %>
      <!-- ==================== IN-PROGRESS VIEW ==================== -->

      <div class="mb-6">
        <%= link_to new_interview_simulator_path, class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 transition-colors" do %>
          <span class="material-symbols-outlined text-[18px]">arrow_back</span>
          Back to Simulator
        <% end %>
      </div>

      <!-- Interview Header with Progress -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
        <div class="flex items-center justify-between flex-wrap gap-4">
          <div>
            <div class="flex items-center gap-3 mb-1">
              <h1 class="text-2xl font-bold text-gray-900"><%= @interview.interview_type.humanize %> Interview</h1>
              <span class="inline-flex items-center px-3 py-0.5 bg-cyan-100 text-cyan-700 text-xs font-semibold rounded-full">
                <%= @company[:name] %> Style
              </span>
            </div>
            <p class="text-sm text-gray-500"><%= @interview.difficulty.capitalize %> &middot; <%= @interview.target_role %></p>
          </div>
          <div class="text-right">
            <p class="text-sm text-gray-500">Progress</p>
            <p class="text-lg font-bold text-gray-900"><%= @interview.answered_questions %>/<%= @interview.total_questions %></p>
            <div class="w-32 bg-gray-100 rounded-full h-2 mt-1">
              <div class="bg-cyan-500 h-2 rounded-full transition-all" style="width: <%= @interview.progress_percentage %>%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Follow-up callout from previous question -->
      <% prev_idx = @interview.current_question_index - 1 %>
      <% if prev_idx >= 0 && @follow_ups[prev_idx.to_s].present? && @follow_ups[prev_idx.to_s]["question"].present? %>
        <div class="bg-cyan-50 border border-cyan-200 rounded-2xl p-5 mb-4">
          <div class="flex items-start gap-3">
            <span class="w-8 h-8 bg-cyan-100 rounded-lg flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-cyan-600 text-[18px]">reply</span>
            </span>
            <div>
              <p class="text-xs font-semibold text-cyan-700 uppercase tracking-wide mb-1">Follow-up from interviewer:</p>
              <p class="text-sm font-medium text-cyan-900"><%= @follow_ups[prev_idx.to_s]["question"] %></p>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Current Question -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
        <div class="flex items-start gap-3 mb-4">
          <span class="w-8 h-8 bg-cyan-100 rounded-lg flex items-center justify-center text-sm font-bold text-cyan-600 shrink-0">Q<%= @interview.current_question_index + 1 %></span>
          <div>
            <p class="text-lg font-semibold text-gray-900"><%= @question["question"] %></p>
            <div class="flex items-center gap-3 mt-2">
              <span class="text-xs text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full"><%= @question["category"] %></span>
              <% if @question["expected_time_minutes"] %>
                <span class="text-xs text-gray-400 flex items-center gap-1">
                  <span class="material-symbols-outlined text-[14px]">schedule</span>
                  <%= @question["expected_time_minutes"] %> min expected
                </span>
              <% end %>
            </div>
          </div>
        </div>

        <% if @question["evaluation_criteria"].present? %>
          <div class="bg-gray-50 rounded-xl p-3 mb-4">
            <p class="text-xs font-semibold text-gray-500 mb-2">What the interviewer looks for:</p>
            <div class="flex flex-wrap gap-1.5">
              <% @question["evaluation_criteria"].each do |criterion| %>
                <span class="text-xs text-gray-600 bg-white px-2 py-0.5 rounded-full border border-gray-200"><%= criterion %></span>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Answer Form -->
        <%= form_with url: answer_interview_simulator_path(@interview), method: :post, class: "space-y-4", data: { controller: "loading-button", loading_button_text_value: "Submitting Answer...", action: "submit->loading-button#submit" } do |f| %>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Your Answer</label>
            <textarea name="answer" rows="8" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 resize-y" placeholder="Type your answer here... Be detailed and structured."></textarea>
          </div>
          <div class="flex justify-end">
            <button type="submit" data-loading-button-target="button" class="inline-flex items-center gap-2 px-6 py-3 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer">
              <span class="material-symbols-outlined text-[20px]">send</span>
              Submit Answer
            </button>
          </div>
        <% end %>
      </div>

      <!-- Previous Responses -->
      <% if @responses.any? %>
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Previous Answers</h3>
        <div class="space-y-3">
          <% @responses.reverse.each do |response| %>
            <% q_idx = response["question_index"].to_i %>
            <% q = @interview.questions_data[q_idx] %>
            <% feedback = response["feedback"] || {} %>
            <% follow_up = @follow_ups[q_idx.to_s] %>
            <div class="bg-white rounded-2xl border border-gray-100 p-5">
              <div class="flex items-start gap-3 mb-3">
                <span class="w-7 h-7 bg-gray-100 rounded-lg flex items-center justify-center text-xs font-bold text-gray-600 shrink-0">Q<%= q_idx + 1 %></span>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-800"><%= q&.dig("question") %></p>
                  <span class="text-xs text-gray-400"><%= q&.dig("category") %></span>
                </div>
                <% score = feedback["score"].to_i %>
                <span class="text-sm font-bold shrink-0 <%= score >= 7 ? 'text-green-600' : score >= 5 ? 'text-yellow-600' : 'text-red-600' %>">
                  <%= score %>/10
                </span>
              </div>

              <div class="ml-10 space-y-2">
                <div class="bg-gray-50 rounded-xl p-3">
                  <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Your Answer</p>
                  <p class="text-sm text-gray-700"><%= response["answer"] %></p>
                </div>

                <% if (feedback["strengths"] || []).any? %>
                  <div class="bg-green-50 rounded-xl p-3">
                    <p class="text-xs font-semibold text-green-700 mb-1">Strengths</p>
                    <ul class="space-y-1">
                      <% feedback["strengths"].each do |s| %>
                        <li class="text-xs text-green-600 flex items-start gap-1">
                          <svg class="w-3 h-3 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                          <%= s %>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>

                <% if (feedback["improvements"] || []).any? %>
                  <div class="bg-yellow-50 rounded-xl p-3">
                    <p class="text-xs font-semibold text-yellow-700 mb-1">Improvements</p>
                    <ul class="space-y-1">
                      <% feedback["improvements"].each do |s| %>
                        <li class="text-xs text-yellow-600 flex items-start gap-1">
                          <svg class="w-3 h-3 text-yellow-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                          <%= s %>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>

                <% if follow_up && follow_up["question"].present? %>
                  <div class="bg-cyan-50 border border-cyan-200 rounded-xl p-3">
                    <div class="flex items-center gap-1.5 mb-1">
                      <span class="material-symbols-outlined text-cyan-600 text-[16px]">reply</span>
                      <p class="text-xs font-semibold text-cyan-700">Follow-up Question</p>
                    </div>
                    <p class="text-sm text-cyan-800"><%= follow_up["question"] %></p>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

    <% else %>
      <!-- No question available -->
      <div class="bg-white rounded-2xl border border-gray-100 p-12 text-center">
        <span class="material-symbols-outlined text-gray-300 text-[48px] mb-4">help_outline</span>
        <p class="text-gray-500 mb-4">No questions available. Please try starting a new interview.</p>
        <%= link_to new_interview_simulator_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors" do %>
          <span class="material-symbols-outlined text-[20px]">add</span>
          Start New Simulation
        <% end %>
      </div>
    <% end %>

  </div>
</div>

<% content_for :page_title, "Company Settings" %>
<% content_for :page_subtitle, "Manage your company profile and preferences" %>

<div class="max-w-3xl">
  <%= form_with model: current_employer, url: employer_settings_path, method: :patch, class: "space-y-8" do |f| %>
    <% if current_employer.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4">
        <div class="flex items-center gap-2 mb-2">
          <span class="material-symbols-outlined text-red-500 text-lg">error</span>
          <p class="text-sm font-medium text-red-700"><%= pluralize(current_employer.errors.count, "error") %> prevented saving:</p>
        </div>
        <ul class="list-disc list-inside text-sm text-red-600 space-y-1">
          <% current_employer.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Company Info -->
    <div class="bg-white rounded-2xl border border-gray-100 p-6">
      <h3 class="text-base font-semibold text-gray-900 mb-4">Company Information</h3>
      <div class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Company Name</label>
          <%= f.text_field :company_name, class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition", placeholder: "Your company name" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Company Domain</label>
          <%= f.text_field :company_domain, class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition", placeholder: "e.g. acme.com" %>
          <p class="mt-1 text-xs text-gray-400">Used for employer verification</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Company Size</label>
            <%= f.select :company_size, options_for_select([
              ["1-10 employees", "1-10"],
              ["11-50 employees", "11-50"],
              ["51-200 employees", "51-200"],
              ["201-500 employees", "201-500"],
              ["501-1000 employees", "501-1000"],
              ["1000+ employees", "1000+"]
            ], current_employer.company_size), { include_blank: "Select size" }, class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Industry</label>
            <%= f.text_field :industry, class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition", placeholder: "e.g. Technology" %>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Company Description</label>
          <%= f.text_area :company_description, rows: 4, class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition resize-y", placeholder: "Tell candidates about your company..." %>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Logo URL</label>
          <%= f.text_field :company_logo_url, class: "w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition", placeholder: "https://example.com/logo.png" %>
        </div>
      </div>
    </div>

    <!-- Verification Status -->
    <div class="bg-white rounded-2xl border border-gray-100 p-6">
      <h3 class="text-base font-semibold text-gray-900 mb-4">Verification Status</h3>
      <% if current_employer.verified? %>
        <div class="flex items-center gap-3 p-4 bg-green-50 rounded-xl">
          <span class="material-symbols-outlined text-green-600">verified</span>
          <div>
            <p class="text-sm font-medium text-green-800">Verified Employer</p>
            <p class="text-xs text-green-600">Your company has been verified. A trust badge appears on all your job listings.</p>
          </div>
        </div>
      <% else %>
        <div class="flex items-center gap-3 p-4 bg-amber-50 rounded-xl">
          <span class="material-symbols-outlined text-amber-600">pending</span>
          <div>
            <p class="text-sm font-medium text-amber-800">Pending Verification</p>
            <p class="text-xs text-amber-600">Complete your domain verification to get the verified employer badge.</p>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Save -->
    <div class="flex items-center justify-end gap-3">
      <%= f.submit "Save Changes", class: "inline-flex items-center gap-2 px-6 py-2.5 bg-indigo-600 text-white text-sm font-semibold rounded-xl hover:bg-indigo-700 transition cursor-pointer" %>
    </div>
  <% end %>
</div>

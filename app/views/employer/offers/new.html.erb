<div class="min-h-screen bg-gray-50">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Create Offer</h1>

    <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
      <p class="text-sm text-gray-500">Creating offer for</p>
      <p class="text-lg font-bold text-gray-900"><%= @application.user.full_name || @application.user.email %></p>
    </div>

    <%= form_with url: employer_offers_path, method: :post, class: "space-y-5" do %>
      <input type="hidden" name="job_offer[job_application_id]" value="<%= @application.id %>">

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Designation</label>
        <input type="text" name="job_offer[designation]" required class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="e.g., Senior Software Engineer">
      </div>

      <div class="grid grid-cols-3 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Base Salary</label>
          <input type="number" name="job_offer[base_salary]" required class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="e.g., 1500000">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Variable Pay</label>
          <input type="number" name="job_offer[variable_pay]" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="0">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Equity Value</label>
          <input type="number" name="job_offer[equity_value]" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="0">
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Location</label>
          <input type="text" name="job_offer[location]" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="e.g., Bangalore">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Joining Date</label>
          <input type="date" name="job_offer[joining_date]" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Benefits</label>
        <textarea name="job_offer[benefits]" rows="3" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Health insurance, ESOP, etc."></textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Additional Terms</label>
        <textarea name="job_offer[additional_terms]" rows="2" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
      </div>

      <button type="submit" class="px-6 py-2.5 bg-indigo-500 text-white font-semibold rounded-xl hover:bg-indigo-600 transition-colors cursor-pointer">
        Create Draft Offer
      </button>
    <% end %>
  </div>
</div>

<% content_for :page_title, "Pipeline" %>
<% content_for :page_subtitle, @job ? "#{@job.title} — #{@applications.size} applicants" : "All applications — #{@applications.size} total" %>

<div>
  <!-- Job Filter -->
  <div class="bg-white rounded-2xl border border-gray-100 p-4 mb-6">
    <div class="flex items-center gap-4">
      <span class="material-symbols-outlined text-gray-400">filter_list</span>
      <div class="flex items-center gap-2 flex-wrap">
        <%= link_to "All Jobs", employer_pipeline_index_path, class: "px-3 py-1.5 text-sm font-medium rounded-lg transition #{@job.nil? ? 'bg-indigo-100 text-indigo-700' : 'text-gray-500 hover:bg-gray-100'}" %>
        <% @jobs.each do |job| %>
          <%= link_to job.title, employer_pipeline_index_path(job_id: job.id), class: "px-3 py-1.5 text-sm font-medium rounded-lg transition #{@job&.id == job.id ? 'bg-indigo-100 text-indigo-700' : 'text-gray-500 hover:bg-gray-100'}" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Kanban Board -->
  <% stages = [
    { key: "applied", label: "Applied", color: "blue", icon: "inbox" },
    { key: "screening", label: "Screening", color: "yellow", icon: "filter_alt" },
    { key: "interview", label: "Interview", color: "purple", icon: "mic" },
    { key: "offer", label: "Offer", color: "green", icon: "handshake" },
    { key: "hired", label: "Hired", color: "emerald", icon: "check_circle" },
    { key: "rejected", label: "Rejected", color: "red", icon: "cancel" }
  ] %>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4">
    <% stages.each do |stage| %>
      <% stage_applications = @applications.select { |a| a.pipeline_stage.to_s == stage[:key] } %>
      <div class="bg-white rounded-2xl border border-gray-100 flex flex-col">
        <!-- Column Header -->
        <div class="px-4 py-3 border-b border-gray-100">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-<%= stage[:color] %>-500 text-[20px]"><%= stage[:icon] %></span>
              <h3 class="text-sm font-semibold text-gray-900"><%= stage[:label] %></h3>
            </div>
            <span class="inline-flex items-center justify-center w-6 h-6 bg-gray-100 rounded-full text-xs font-bold text-gray-600"><%= stage_applications.size %></span>
          </div>
        </div>

        <!-- Cards -->
        <div class="p-3 space-y-3 flex-1 min-h-[200px]">
          <% if stage_applications.any? %>
            <% stage_applications.each do |application| %>
              <div class="bg-gray-50 rounded-xl p-4 border border-gray-100 hover:border-gray-200 transition-colors">
                <div class="flex items-center gap-2 mb-2">
                  <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-xs font-bold text-indigo-700">
                    <%= application.user.full_name&.first&.upcase || "?" %>
                  </div>
                  <div class="min-w-0">
                    <p class="text-sm font-semibold text-gray-900 truncate"><%= application.user.full_name || application.user.email %></p>
                    <p class="text-xs text-gray-400"><%= application.job_posting.title %></p>
                  </div>
                </div>
                <p class="text-[10px] text-gray-400 mb-2">Applied <%= application.created_at.strftime("%b %d") %></p>

                <!-- Move Actions -->
                <div class="flex flex-wrap gap-1">
                  <% stages.reject { |s| s[:key] == stage[:key] }.first(3).each do |target| %>
                    <%= button_to update_stage_employer_pipeline_path(application), params: { stage: target[:key] }, method: :post, class: "inline-flex items-center gap-0.5 px-2 py-1 text-[10px] font-medium rounded-md bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors cursor-pointer", title: "Move to #{target[:label]}" do %>
                      <span class="material-symbols-outlined text-[12px]"><%= target[:icon] %></span>
                      <%= target[:label] %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="flex items-center justify-center h-full min-h-[120px]">
              <p class="text-xs text-gray-400 text-center">No applicants</p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% content_for :page_title, "Billing" %>

<div class="space-y-6">
  <!-- Current Plan -->
  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Current Plan</h2>
    <div class="flex items-center justify-between">
      <div>
        <p class="text-2xl font-bold text-gray-900"><%= @current_plan.capitalize %></p>
        <p class="text-sm text-gray-500 mt-1">
          <%= @plans[@current_plan][:reveal_credits] %> candidate reveals &bull;
          <%= @plans[@current_plan][:job_posts] %> job posts
        </p>
      </div>
      <div class="text-right">
        <p class="text-sm text-gray-500">Credits remaining</p>
        <p class="text-3xl font-bold text-indigo-600"><%= @employer.candidate_reveal_credits %></p>
      </div>
    </div>
    <% if @employer.billing_period_end.present? %>
      <p class="text-xs text-gray-400 mt-3">Current period ends <%= @employer.billing_period_end.strftime("%B %d, %Y") %></p>
    <% end %>
  </div>

  <!-- Plans -->
  <h3 class="text-sm font-semibold text-gray-900">Available Plans</h3>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <% @plans.each do |plan_name, plan| %>
      <div class="bg-white rounded-xl border-2 p-6 <%= plan_name == @current_plan ? 'border-indigo-500' : 'border-gray-200' %>">
        <div class="flex items-center justify-between mb-4">
          <h4 class="font-semibold text-gray-900"><%= plan_name.capitalize %></h4>
          <% if plan_name == @current_plan %>
            <span class="text-xs font-medium text-indigo-600 bg-indigo-100 px-2 py-0.5 rounded-full">Current</span>
          <% end %>
        </div>
        <p class="text-3xl font-bold text-gray-900">
          <% if plan[:price] == 0 %>
            Free
          <% else %>
            &#8377;<%= number_with_delimiter(plan[:price]) %><span class="text-sm font-normal text-gray-500">/mo</span>
          <% end %>
        </p>
        <ul class="mt-4 space-y-2 text-sm text-gray-600">
          <li class="flex items-center gap-2">
            <span class="material-symbols-outlined text-base text-green-500">check_circle</span>
            <%= plan[:reveal_credits] %> candidate reveals/month
          </li>
          <li class="flex items-center gap-2">
            <span class="material-symbols-outlined text-base text-green-500">check_circle</span>
            <%= plan[:job_posts] %> active job posts
          </li>
          <% if plan_name == "professional" %>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-base text-green-500">check_circle</span>
              Priority support
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-base text-green-500">check_circle</span>
              Public company page
            </li>
          <% end %>
        </ul>
        <% unless plan_name == @current_plan %>
          <div class="mt-6">
            <span class="block text-center px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 text-gray-400 cursor-not-allowed">
              Coming Soon
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Your Job Postings</h1>
      <p class="mt-1 text-gray-500">Manage and track all your listed positions</p>
    </div>
    <%= link_to new_employer_job_path, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors" do %>
      <span class="material-symbols-outlined text-[20px]">add</span>
      Post New Job
    <% end %>
  </div>

  <% if @jobs.any? %>
    <div class="bg-white rounded-2xl border border-gray-100">
      <!-- Table Header -->
      <div class="hidden md:grid grid-cols-12 gap-4 px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wide border-b border-gray-100">
        <div class="col-span-3">Title</div>
        <div class="col-span-2">Location</div>
        <div class="col-span-2">Applications</div>
        <div class="col-span-2">Expires</div>
        <div class="col-span-1">Status</div>
        <div class="col-span-2 text-right">Actions</div>
      </div>

      <div class="divide-y divide-gray-50">
        <% @jobs.each do |job| %>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 px-6 py-5 items-center hover:bg-gray-50 transition-colors">
            <div class="col-span-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-cyan-50 rounded-xl flex items-center justify-center">
                  <span class="material-symbols-outlined text-cyan-600 text-[20px]">work</span>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-900"><%= job.title %></p>
                  <p class="text-xs text-gray-400"><%= job.job_type&.titleize %></p>
                </div>
              </div>
            </div>
            <div class="col-span-2">
              <span class="inline-flex items-center gap-1 text-sm text-gray-600">
                <span class="material-symbols-outlined text-[16px] text-gray-400">location_on</span>
                <%= job.location.presence || "Not specified" %>
              </span>
            </div>
            <div class="col-span-2">
              <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-gray-900"><%= job.applications_count.to_i %></span>
                <span class="text-xs text-gray-400">applicants</span>
              </div>
            </div>
            <div class="col-span-2">
              <% if job.expires_at.present? %>
                <p class="text-sm text-gray-600"><%= job.expires_at.strftime("%b %d, %Y") %></p>
                <% if job.expires_at < Time.current %>
                  <p class="text-xs text-red-500">Expired</p>
                <% elsif job.expires_at < 7.days.from_now %>
                  <p class="text-xs text-yellow-600">Expiring soon</p>
                <% end %>
              <% else %>
                <p class="text-sm text-gray-400">No expiry</p>
              <% end %>
            </div>
            <div class="col-span-1">
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold
                <%= case job.status.to_s
                    when 'active', 'open' then 'bg-green-50 text-green-700'
                    when 'closed' then 'bg-gray-100 text-gray-500'
                    when 'draft' then 'bg-yellow-50 text-yellow-700'
                    when 'paused' then 'bg-orange-50 text-orange-700'
                    else 'bg-gray-100 text-gray-500'
                    end %>">
                <%= job.status.to_s.titleize %>
              </span>
            </div>
            <div class="col-span-2 flex items-center justify-end gap-2">
              <%= link_to edit_employer_job_path(job), class: "inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-cyan-600 hover:text-cyan-700 hover:bg-cyan-50 rounded-lg transition-colors" do %>
                <span class="material-symbols-outlined text-[16px]">edit</span>
                Edit
              <% end %>
              <%= link_to employer_pipeline_index_path(job_id: job.id), class: "inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors" do %>
                <span class="material-symbols-outlined text-[16px]">view_kanban</span>
                Pipeline
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl border border-gray-100 p-16 text-center">
      <div class="w-16 h-16 bg-cyan-50 rounded-full flex items-center justify-center mx-auto mb-4">
        <span class="material-symbols-outlined text-cyan-500 text-[32px]">work</span>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">No job postings yet</h3>
      <p class="text-sm text-gray-500 mb-6">Create your first job posting to start receiving applications.</p>
      <%= link_to new_employer_job_path, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors" do %>
        <span class="material-symbols-outlined text-[20px]">add</span>
        Post New Job
      <% end %>
    </div>
  <% end %>
</div>

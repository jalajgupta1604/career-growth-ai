<!-- Hero Section -->
<div class="bg-gradient-to-br from-indigo-50 via-white to-purple-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-indigo-100 text-indigo-700 text-xs font-semibold rounded-full mb-6">
          <span class="material-symbols-outlined text-sm">trending_up</span>
          Trusted by 500+ companies
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 leading-tight">
          Hire top tech talent<br>
          <span class="text-indigo-600">smarter & faster</span>
        </h1>
        <p class="mt-6 text-lg text-gray-600 leading-relaxed">
          Access a curated pool of pre-assessed candidates. Our AI-powered platform matches skills, experience, and career trajectory to find your perfect hire.
        </p>
        <div class="mt-8 flex items-center gap-4">
          <% if user_signed_in? %>
            <%= link_to employer_onboarding_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 text-white font-semibold rounded-xl hover:bg-indigo-700 transition shadow-lg shadow-indigo-200" do %>
              <span class="material-symbols-outlined text-xl">rocket_launch</span>
              Set Up Your Company
            <% end %>
          <% else %>
            <%= link_to employer_login_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 text-white font-semibold rounded-xl hover:bg-indigo-700 transition shadow-lg shadow-indigo-200" do %>
              <span class="material-symbols-outlined text-xl">rocket_launch</span>
              Start Hiring — Free
            <% end %>
          <% end %>
          <span class="text-sm text-gray-400">No credit card required</span>
        </div>
      </div>

      <!-- Stats / Visual -->
      <div class="bg-white rounded-2xl border border-gray-100 p-8 shadow-xl shadow-gray-100">
        <div class="grid grid-cols-2 gap-6">
          <div class="text-center p-4 bg-indigo-50 rounded-xl">
            <p class="text-3xl font-extrabold text-indigo-600"><%= number_with_delimiter(User.count) %>+</p>
            <p class="text-sm text-gray-600 mt-1">Active Candidates</p>
          </div>
          <div class="text-center p-4 bg-purple-50 rounded-xl">
            <p class="text-3xl font-extrabold text-purple-600"><%= JobPosting.count %>+</p>
            <p class="text-sm text-gray-600 mt-1">Jobs Posted</p>
          </div>
          <div class="text-center p-4 bg-green-50 rounded-xl">
            <p class="text-3xl font-extrabold text-green-600">85%</p>
            <p class="text-sm text-gray-600 mt-1">Avg Match Score</p>
          </div>
          <div class="text-center p-4 bg-amber-50 rounded-xl">
            <p class="text-3xl font-extrabold text-amber-600">14 days</p>
            <p class="text-sm text-gray-600 mt-1">Avg Time to Hire</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Features Section -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <div class="text-center mb-14">
    <h2 class="text-3xl font-bold text-gray-900">Everything you need to hire great talent</h2>
    <p class="mt-3 text-gray-500 text-lg">Built for modern tech hiring teams</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <div class="bg-white rounded-2xl border border-gray-100 p-8 hover:shadow-lg transition-shadow">
      <div class="w-12 h-12 bg-indigo-100 rounded-xl flex items-center justify-center mb-4">
        <span class="material-symbols-outlined text-indigo-600 text-2xl">work</span>
      </div>
      <h3 class="text-lg font-semibold text-gray-900">Job Posting</h3>
      <p class="mt-2 text-sm text-gray-500 leading-relaxed">Create detailed job listings with requirements, salary ranges, and application deadlines. Reach pre-qualified candidates instantly.</p>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 p-8 hover:shadow-lg transition-shadow">
      <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center mb-4">
        <span class="material-symbols-outlined text-purple-600 text-2xl">filter_list</span>
      </div>
      <h3 class="text-lg font-semibold text-gray-900">ATS Pipeline</h3>
      <p class="mt-2 text-sm text-gray-500 leading-relaxed">Track candidates through every stage — from application to offer. Kanban-style boards with drag-and-drop stage management.</p>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 p-8 hover:shadow-lg transition-shadow">
      <div class="w-12 h-12 bg-cyan-100 rounded-xl flex items-center justify-center mb-4">
        <span class="material-symbols-outlined text-cyan-600 text-2xl">person_search</span>
      </div>
      <h3 class="text-lg font-semibold text-gray-900">Candidate Search</h3>
      <p class="mt-2 text-sm text-gray-500 leading-relaxed">Search our talent pool by role, skills, experience, and location. View pre-assessed profiles with interview scores and skill badges.</p>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 p-8 hover:shadow-lg transition-shadow">
      <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center mb-4">
        <span class="material-symbols-outlined text-green-600 text-2xl">verified</span>
      </div>
      <h3 class="text-lg font-semibold text-gray-900">Verified Profiles</h3>
      <p class="mt-2 text-sm text-gray-500 leading-relaxed">Candidates are pre-assessed through mock interviews, coding challenges, and skill verification. No more resume guesswork.</p>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 p-8 hover:shadow-lg transition-shadow">
      <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-4">
        <span class="material-symbols-outlined text-amber-600 text-2xl">analytics</span>
      </div>
      <h3 class="text-lg font-semibold text-gray-900">Hiring Analytics</h3>
      <p class="mt-2 text-sm text-gray-500 leading-relaxed">Track pipeline velocity, time-to-hire, and source effectiveness. Data-driven decisions for your hiring process.</p>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 p-8 hover:shadow-lg transition-shadow">
      <div class="w-12 h-12 bg-rose-100 rounded-xl flex items-center justify-center mb-4">
        <span class="material-symbols-outlined text-rose-600 text-2xl">webhook</span>
      </div>
      <h3 class="text-lg font-semibold text-gray-900">Integrations</h3>
      <p class="mt-2 text-sm text-gray-500 leading-relaxed">Connect via webhooks and API. Get notified on new applications, stage changes, and more in your existing tools.</p>
    </div>
  </div>
</div>

<!-- CTA Section -->
<div class="bg-indigo-600">
  <div class="max-w-4xl mx-auto px-4 py-16 text-center">
    <h2 class="text-3xl font-bold text-white">Ready to transform your hiring?</h2>
    <p class="mt-3 text-indigo-200 text-lg">Join hundreds of companies already hiring smarter with Career Growth AI.</p>
    <div class="mt-8">
      <% if user_signed_in? %>
        <%= link_to employer_onboarding_path, class: "inline-flex items-center gap-2 px-8 py-3.5 bg-white text-indigo-600 font-semibold rounded-xl hover:bg-indigo-50 transition shadow-lg" do %>
          Set Up Your Company
          <span class="material-symbols-outlined text-xl">arrow_forward</span>
        <% end %>
      <% else %>
        <%= link_to employer_login_path, class: "inline-flex items-center gap-2 px-8 py-3.5 bg-white text-indigo-600 font-semibold rounded-xl hover:bg-indigo-50 transition shadow-lg" do %>
          Get Started Free
          <span class="material-symbols-outlined text-xl">arrow_forward</span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<!-- Footer -->
<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between">
    <p class="text-sm text-gray-400">&copy; <%= Date.current.year %> Career Growth AI</p>
    <div class="flex items-center gap-4">
      <%= link_to "For Candidates", root_path, class: "text-sm text-gray-400 hover:text-gray-600" %>
      <%= link_to "Pricing", pricing_path, class: "text-sm text-gray-400 hover:text-gray-600" %>
    </div>
  </div>
</div>

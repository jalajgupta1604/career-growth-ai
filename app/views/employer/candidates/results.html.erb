<% content_for :page_title, "Search Results" %>

<div class="space-y-6">
  <!-- Back link -->
  <div>
    <%= link_to employer_candidates_path, class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-indigo-600 transition-colors" do %>
      <span class="material-symbols-outlined text-[18px]">arrow_back</span>
      Back to Search
    <% end %>
  </div>

  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Search Results</h1>
      <p class="mt-1 text-sm text-gray-500">
        Found <strong class="text-gray-900"><%= @candidates.size %></strong> candidates
        <% if params[:role].present? %> matching "<%= params[:role] %>"<% end %>
        <% if params[:city].present? %> in <%= params[:city] %><% end %>
      </p>
    </div>
    <div class="flex items-center gap-3">
      <span class="text-xs text-gray-500">
        <span class="font-semibold text-indigo-600"><%= current_employer.candidate_reveal_credits %></span> reveal credits
      </span>
      <%= link_to employer_candidates_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition" do %>
        <span class="material-symbols-outlined text-base">tune</span> Refine
      <% end %>
    </div>
  </div>

  <% if @candidates.any? %>
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="hidden md:grid grid-cols-12 gap-4 px-6 py-3 text-xs font-semibold text-gray-400 uppercase tracking-wide border-b border-gray-100">
        <div class="col-span-4">Candidate</div>
        <div class="col-span-3">Role</div>
        <div class="col-span-2">City</div>
        <div class="col-span-2">Experience</div>
        <div class="col-span-1 text-right">Actions</div>
      </div>

      <div class="divide-y divide-gray-50">
        <% @candidates.each do |candidate| %>
          <% revealed = @revealed_ids.include?(candidate.id) %>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 px-6 py-4 items-center hover:bg-gray-50 transition">
            <div class="col-span-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold <%= revealed ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-100 text-gray-400' %>">
                  <% if revealed %>
                    <%= candidate.full_name&.first&.upcase || "?" %>
                  <% else %>
                    <span class="material-symbols-outlined text-base">person</span>
                  <% end %>
                </div>
                <div>
                  <% if revealed %>
                    <p class="text-sm font-semibold text-gray-900"><%= candidate.full_name || "Anonymous" %></p>
                  <% else %>
                    <p class="text-sm font-semibold text-gray-400">Hidden Candidate</p>
                    <p class="text-xs text-gray-300">Reveal to see details</p>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="col-span-3">
              <p class="text-sm text-gray-700"><%= candidate.role.presence || "Not specified" %></p>
            </div>
            <div class="col-span-2">
              <span class="inline-flex items-center gap-1 text-sm text-gray-600">
                <span class="material-symbols-outlined text-base text-gray-400">location_on</span>
                <%= candidate.city.presence || "N/A" %>
              </span>
            </div>
            <div class="col-span-2">
              <span class="inline-flex items-center px-2.5 py-1 bg-indigo-50 text-indigo-700 rounded-full text-xs font-semibold">
                <%= candidate.experience_years.to_i %> years
              </span>
            </div>
            <div class="col-span-1 text-right">
              <% if revealed %>
                <span class="inline-flex items-center gap-1 text-xs text-green-600">
                  <span class="material-symbols-outlined text-sm">check_circle</span> Revealed
                </span>
              <% else %>
                <%= button_to reveal_employer_candidate_path(candidate), method: :post,
                    class: "inline-flex items-center gap-1 text-sm text-indigo-600 font-medium hover:text-indigo-700 cursor-pointer",
                    data: { turbo_confirm: "Use 1 reveal credit to see this candidate's full profile?" } do %>
                  <span class="material-symbols-outlined text-base">visibility</span> Reveal
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-gray-100 p-12 text-center">
      <span class="material-symbols-outlined text-4xl text-gray-300">person_search</span>
      <h3 class="text-lg font-semibold text-gray-900 mt-3 mb-2">No candidates found</h3>
      <p class="text-sm text-gray-500 mb-6">Try adjusting your search filters to broaden the results.</p>
      <%= link_to employer_candidates_path, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-500 text-white font-medium rounded-lg hover:bg-indigo-600 transition" do %>
        <span class="material-symbols-outlined text-base">tune</span> Modify Search
      <% end %>
    </div>
  <% end %>
</div>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Back link -->
  <div class="mb-6">
    <%= link_to employer_candidates_path, class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-cyan-600 transition-colors" do %>
      <span class="material-symbols-outlined text-[18px]">arrow_back</span>
      Back to Search
    <% end %>
  </div>

  <!-- Header -->
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Search Results</h1>
      <p class="mt-1 text-gray-500">
        Found <strong class="text-gray-900"><%= @candidates.size %></strong> candidates
        <% if params[:role].present? %> matching "<%= params[:role] %>"<% end %>
        <% if params[:city].present? %> in <%= params[:city] %><% end %>
      </p>
    </div>
    <%= link_to employer_candidates_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-gray-100 text-gray-700 font-semibold rounded-xl hover:bg-gray-200 transition-colors" do %>
      <span class="material-symbols-outlined text-[20px]">tune</span>
      Refine Search
    <% end %>
  </div>

  <% if @candidates.any? %>
    <div class="bg-white rounded-2xl border border-gray-100">
      <!-- Table Header -->
      <div class="hidden md:grid grid-cols-12 gap-4 px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wide border-b border-gray-100">
        <div class="col-span-4">Candidate</div>
        <div class="col-span-3">Role</div>
        <div class="col-span-2">City</div>
        <div class="col-span-2">Experience</div>
        <div class="col-span-1 text-right">Actions</div>
      </div>

      <div class="divide-y divide-gray-50">
        <% @candidates.each do |candidate| %>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 px-6 py-5 items-center hover:bg-gray-50 transition-colors">
            <div class="col-span-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-cyan-100 flex items-center justify-center text-sm font-bold text-cyan-700">
                  <%= candidate.full_name&.first&.upcase || "?" %>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-900"><%= candidate.full_name || "Anonymous" %></p>
                  <p class="text-xs text-gray-400"><%= candidate.email %></p>
                </div>
              </div>
            </div>
            <div class="col-span-3">
              <p class="text-sm text-gray-700"><%= candidate.role.presence || "Not specified" %></p>
            </div>
            <div class="col-span-2">
              <span class="inline-flex items-center gap-1 text-sm text-gray-600">
                <span class="material-symbols-outlined text-[16px] text-gray-400">location_on</span>
                <%= candidate.city.presence || "N/A" %>
              </span>
            </div>
            <div class="col-span-2">
              <span class="inline-flex items-center px-2.5 py-1 bg-cyan-50 text-cyan-700 rounded-full text-xs font-semibold">
                <%= candidate.experience_years.to_i %> years
              </span>
            </div>
            <div class="col-span-1 text-right">
              <%= link_to "#", class: "inline-flex items-center gap-1 text-sm text-cyan-600 font-medium hover:text-cyan-700" do %>
                <span class="material-symbols-outlined text-[16px]">visibility</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl border border-gray-100 p-16 text-center">
      <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <span class="material-symbols-outlined text-gray-400 text-[32px]">person_search</span>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">No candidates found</h3>
      <p class="text-sm text-gray-500 mb-6">Try adjusting your search filters to broaden the results.</p>
      <%= link_to employer_candidates_path, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors" do %>
        <span class="material-symbols-outlined text-[20px]">tune</span>
        Modify Search
      <% end %>
    </div>
  <% end %>
</div>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Back link -->
  <div class="mb-6">
    <%= link_to employer_dashboard_path, class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-cyan-600 transition-colors" do %>
      <span class="material-symbols-outlined text-[18px]">arrow_back</span>
      Back to Dashboard
    <% end %>
  </div>

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Search Candidates</h1>
    <p class="mt-1 text-gray-500">Find the right talent for your open positions</p>
  </div>

  <!-- Search Form -->
  <div class="bg-white rounded-2xl border border-gray-100 p-8 mb-8">
    <div class="flex items-center gap-2 mb-6">
      <span class="material-symbols-outlined text-cyan-500">search</span>
      <h2 class="text-lg font-semibold text-gray-900">Search Filters</h2>
    </div>

    <%= form_with url: employer_candidates_results_path, method: :get, class: "space-y-6" do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Role -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Role / Job Title</label>
          <input type="text" name="role" value="<%= params[:role] %>" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-colors" placeholder="e.g. Backend Engineer">
        </div>

        <!-- City -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">City</label>
          <input type="text" name="city" value="<%= params[:city] %>" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-colors" placeholder="e.g. Bangalore">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Experience Min -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Min Experience (years)</label>
          <input type="number" name="experience_min" value="<%= params[:experience_min] %>" min="0" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-colors" placeholder="0">
        </div>

        <!-- Experience Max -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Max Experience (years)</label>
          <input type="number" name="experience_max" value="<%= params[:experience_max] %>" min="0" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-colors" placeholder="20">
        </div>
      </div>

      <div class="pt-2">
        <button type="submit" class="inline-flex items-center gap-2 px-6 py-3 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 active:bg-cyan-700 transition-colors cursor-pointer">
          <span class="material-symbols-outlined text-[20px]">search</span>
          Search Candidates
        </button>
      </div>
    <% end %>
  </div>

  <!-- Previous Searches -->
  <% if @previous_searches.present? && @previous_searches.any? %>
    <div class="bg-white rounded-2xl border border-gray-100 p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-gray-400">history</span>
        <h2 class="text-lg font-semibold text-gray-900">Previous Searches</h2>
      </div>

      <div class="space-y-2">
        <% @previous_searches.each do |search| %>
          <div class="flex items-center justify-between px-4 py-3 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">
            <div class="flex items-center gap-4">
              <div class="w-8 h-8 bg-cyan-50 rounded-lg flex items-center justify-center">
                <span class="material-symbols-outlined text-cyan-600 text-[18px]">search</span>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-900">
                  <%= search.role.presence || "Any role" %>
                  <% if search.city.present? %>
                    <span class="text-gray-400">in</span> <%= search.city %>
                  <% end %>
                </p>
                <p class="text-xs text-gray-400">
                  <% if search.experience_min.present? || search.experience_max.present? %>
                    <%= search.experience_min || 0 %>-<%= search.experience_max || "any" %> years &middot;
                  <% end %>
                  <%= time_ago_in_words(search.created_at) %> ago
                </p>
              </div>
            </div>
            <%= link_to employer_candidates_results_path(role: search.role, city: search.city, experience_min: search.experience_min, experience_max: search.experience_max), class: "inline-flex items-center gap-1 text-sm text-cyan-600 font-medium hover:text-cyan-700" do %>
              <span class="material-symbols-outlined text-[16px]">refresh</span>
              Run Again
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

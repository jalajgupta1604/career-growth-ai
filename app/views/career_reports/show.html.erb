<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8 flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Career Report</h1>
      <p class="mt-1 text-gray-500">Generated <%= time_ago_in_words(@report.created_at) %> ago</p>
    </div>
    <%= link_to "Back to Dashboard", dashboard_path, class: "text-indigo-600 hover:text-indigo-700 font-medium" %>
  </div>

  <!-- Salary Benchmark Section -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-6">Salary Benchmark</h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
      <div class="text-center p-4 bg-gray-50 rounded-xl">
        <p class="text-sm text-gray-500">Your Salary</p>
        <p class="text-2xl font-bold text-gray-900">&#8377;<%= number_with_delimiter(current_user.current_salary.to_i) %></p>
      </div>
      <div class="text-center p-4 bg-blue-50 rounded-xl">
        <p class="text-sm text-blue-600">Market Min</p>
        <p class="text-2xl font-bold text-blue-700">&#8377;<%= number_with_delimiter(@salary_data.dig("benchmark", "min_salary").to_i) %></p>
      </div>
      <div class="text-center p-4 bg-green-50 rounded-xl">
        <p class="text-sm text-green-600">Market Median</p>
        <p class="text-2xl font-bold text-green-700">&#8377;<%= number_with_delimiter(@salary_data.dig("benchmark", "median_salary").to_i) %></p>
      </div>
      <div class="text-center p-4 bg-purple-50 rounded-xl">
        <p class="text-sm text-purple-600">Market Max</p>
        <p class="text-2xl font-bold text-purple-700">&#8377;<%= number_with_delimiter(@salary_data.dig("benchmark", "max_salary").to_i) %></p>
      </div>
    </div>
    <div class="mt-6 text-center">
      <p class="text-lg">
        You are
        <span class="font-bold text-2xl <%= @report.salary_gap_percentage.to_f > 0 ? 'text-red-600' : 'text-green-600' %>">
          <%= @report.salary_gap_percentage.to_f > 0 ? "#{@report.salary_gap_percentage}% underpaid" : "at or above market rate" %>
        </span>
      </p>
    </div>
  </div>

  <!-- Interview Readiness (Free Preview) -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Interview Readiness Score</h2>
    <div class="flex items-center gap-8">
      <div class="text-center">
        <p class="text-5xl font-bold text-indigo-600"><%= @report.interview_score&.round(0) %></p>
        <p class="text-gray-500 mt-1">out of 100</p>
      </div>
      <div class="flex-1 space-y-2">
        <div>
          <div class="flex justify-between text-sm"><span class="text-gray-600">Skill Match</span><span><%= @interview_data.dig("skill_match_score") || "N/A" %></span></div>
          <div class="w-full bg-gray-200 rounded-full h-2"><div class="bg-indigo-600 h-2 rounded-full" style="width: <%= @interview_data.dig("skill_match_score").to_f %>%"></div></div>
        </div>
        <div>
          <div class="flex justify-between text-sm"><span class="text-gray-600">Experience</span><span><%= @interview_data.dig("experience_score") || "N/A" %></span></div>
          <div class="w-full bg-gray-200 rounded-full h-2"><div class="bg-green-500 h-2 rounded-full" style="width: <%= @interview_data.dig("experience_score").to_f %>%"></div></div>
        </div>
        <div>
          <div class="flex justify-between text-sm"><span class="text-gray-600">Project Depth</span><span><%= @interview_data.dig("project_depth_score") || "N/A" %></span></div>
          <div class="w-full bg-gray-200 rounded-full h-2"><div class="bg-purple-500 h-2 rounded-full" style="width: <%= @interview_data.dig("project_depth_score").to_f %>%"></div></div>
        </div>
      </div>
    </div>
  </div>

  <% if @report.paid? %>
    <!-- Full Skill Gap Analysis (Paid) -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 mb-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-6">Skill Gap Analysis</h2>
      <% if @skill_data.dig("missing_skills").present? %>
        <h3 class="text-sm font-medium text-gray-500 mb-3 uppercase tracking-wide">Top Skills to Learn (by ROI)</h3>
        <div class="space-y-3">
          <% @skill_data["missing_skills"].each do |skill| %>
            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl">
              <div>
                <p class="font-medium text-gray-900"><%= skill["name"] %></p>
                <p class="text-sm text-gray-500"><%= skill["category"] %></p>
              </div>
              <div class="text-right">
                <p class="text-sm font-semibold text-indigo-600">ROI: <%= skill["roi_score"] %></p>
                <p class="text-xs text-gray-400">Demand: <%= skill["demand_index"] %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Full Roadmap (Paid) -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 mb-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-6">12-Month Career Roadmap</h2>
      <% if @roadmap_data.dig("milestones").present? %>
        <div class="space-y-6">
          <% @roadmap_data["milestones"].each do |milestone| %>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center">
                <span class="text-sm font-bold text-indigo-600">M<%= milestone["month"] %></span>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900"><%= milestone["title"] %></h4>
                <p class="text-sm text-gray-500"><%= milestone["description"] %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @roadmap_data.dig("certifications").present? %>
        <div class="mt-8">
          <h3 class="text-sm font-medium text-gray-500 mb-3 uppercase tracking-wide">Recommended Certifications</h3>
          <div class="flex flex-wrap gap-2">
            <% @roadmap_data["certifications"].each do |cert| %>
              <span class="px-3 py-1 bg-indigo-50 text-indigo-700 rounded-full text-sm font-medium"><%= cert %></span>
            <% end %>
          </div>
        </div>
      <% end %>

      <%= link_to "Download PDF Blueprint", download_pdf_career_report_path(@report), class: "mt-6 inline-block px-6 py-3 bg-indigo-600 text-white font-medium rounded-xl hover:bg-indigo-700 transition-colors" %>
    </div>
  <% else %>
    <!-- Payment Wall -->
    <div class="bg-gradient-to-br from-indigo-600 to-purple-600 rounded-2xl p-8 text-white text-center">
      <h2 class="text-2xl font-bold">Unlock Your Full Career Blueprint</h2>
      <p class="mt-2 text-indigo-100">Get detailed skill gap analysis, 12-month roadmap, recommended certifications, and downloadable PDF report.</p>
      <div class="mt-6 bg-white/10 rounded-xl p-6 max-w-md mx-auto">
        <p class="text-4xl font-bold">&#8377;999</p>
        <p class="text-indigo-200 mt-1">One-time payment</p>
      </div>
      <div class="mt-6">
        <button id="pay-button"
                data-report-id="<%= @report.id %>"
                class="px-8 py-4 bg-white text-indigo-600 font-semibold rounded-xl hover:bg-indigo-50 transition-all text-lg cursor-pointer">
          Pay & Unlock Full Report
        </button>
      </div>
    </div>
  <% end %>
</div>

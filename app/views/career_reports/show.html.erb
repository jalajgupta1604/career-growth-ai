<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 bg-cyan-500 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        </div>
        <span class="text-lg font-bold text-gray-900">Career Growth AI</span>
      </div>
      <div class="flex items-center gap-4">
        <% if @report.paid? %>
          <%= link_to download_pdf_career_report_path(@report), class: "inline-flex items-center px-4 py-2 bg-cyan-500 text-white text-sm font-semibold rounded-lg hover:bg-cyan-600 transition-colors" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Download PDF Report
          <% end %>
        <% else %>
          <span class="inline-flex items-center px-3 py-1 bg-gray-100 text-gray-400 text-sm font-medium rounded-lg">
            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
            PDF Locked
          </span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Title -->
    <div class="flex justify-between items-start mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Career Blueprint</h1>
        <p class="mt-1 text-gray-500">Personalized roadmap to market-leading compensation for <%= current_user.role %>s.</p>
      </div>
      <% unless @report.paid? %>
        <span class="px-3 py-1 bg-cyan-50 text-cyan-600 text-sm font-semibold rounded-full">PREMIUM: &#8377;1,199</span>
      <% end %>
    </div>

    <!-- Top Row: Salary Benchmark + Interview Readiness -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
      <!-- Salary Benchmark -->
      <div class="lg:col-span-2 bg-white rounded-2xl border border-gray-100 p-6">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-lg font-bold text-gray-900">Salary Benchmark</h2>
          <span class="px-3 py-1 bg-red-50 text-red-600 text-sm font-semibold rounded-full">Underpaid by <%= @report.salary_gap_percentage %>%</span>
        </div>
        <div class="grid grid-cols-3 gap-4 mb-6">
          <div>
            <p class="text-xs text-gray-400 mb-1">Current CTC</p>
            <p class="text-2xl font-bold text-gray-900">&#8377;<%= (current_user.current_salary.to_i / 100000.0).round(0) %>L</p>
          </div>
          <div>
            <p class="text-xs text-gray-400 mb-1">Market Median</p>
            <p class="text-2xl font-bold text-cyan-600">&#8377;<%= (@salary_data.dig("benchmark", "median_salary").to_i / 100000.0).round(0) %>L</p>
          </div>
          <div>
            <p class="text-xs text-gray-400 mb-1">Target (95th Percentile)</p>
            <p class="text-2xl font-bold text-gray-900">&#8377;<%= (@salary_data.dig("benchmark", "max_salary").to_i / 100000.0).round(0) %>L+</p>
          </div>
        </div>
        <!-- Salary Gap Progress -->
        <div>
          <p class="text-xs text-gray-400 mb-2">Salary Gap Progress</p>
          <div class="w-full bg-gray-100 rounded-full h-3 relative">
            <% gap_pct = @report.salary_gap_percentage.to_f.clamp(0, 100) %>
            <div class="bg-gradient-to-r from-cyan-400 to-cyan-500 h-3 rounded-full" style="width: <%= 100 - gap_pct %>%"></div>
          </div>
          <div class="flex justify-between mt-2">
            <span class="text-xs text-gray-400">&#8377;<%= (((@salary_data.dig("benchmark", "median_salary").to_i - current_user.current_salary.to_i).abs) / 100000.0).round(0) %>L to Median</span>
          </div>
        </div>
      </div>

      <!-- Interview Readiness (Circular Gauge) -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Interview Readiness</h2>
        <div class="flex justify-center mb-4">
          <div class="relative w-32 h-32">
            <svg class="w-32 h-32 transform -rotate-90" viewBox="0 0 120 120">
              <circle cx="60" cy="60" r="52" fill="none" stroke="#f0f0f0" stroke-width="10"/>
              <circle cx="60" cy="60" r="52" fill="none" stroke="url(#gauge-gradient)" stroke-width="10"
                      stroke-dasharray="<%= ((@report.interview_score || 0) / 100.0 * 326.7).round(1) %> 326.7"
                      stroke-linecap="round"/>
              <defs>
                <linearGradient id="gauge-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#06b6d4"/>
                  <stop offset="100%" stop-color="#0891b2"/>
                </linearGradient>
              </defs>
            </svg>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-3xl font-bold text-gray-900"><%= @report.interview_score&.round(0) %></span>
            </div>
          </div>
        </div>
        <% weak_areas = (@skill_data.dig("missing_skills") || []).first(2).map { |s| s["name"] || s[:name] } %>
        <p class="text-sm text-gray-500 text-center">
          <% if weak_areas.any? %>
            Needs improvement in
            <% weak_areas.each_with_index do |area, i| %>
              <span class="font-semibold">"<%= area %>"</span><%= i < weak_areas.length - 1 ? " and" : "" %>
            <% end %>
            modules.
          <% else %>
            Strong across all skill areas. Keep practicing!
          <% end %>
        </p>
        <div class="mt-4 text-center">
          <%= link_to "Take Mock Interview", interview_prep_path, class: "text-sm text-cyan-600 font-semibold hover:text-cyan-700" %>
        </div>
      </div>
    </div>

    <!-- Middle Row: Skill ROI Analysis + AI Growth Hacks -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <!-- Skill ROI Analysis -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <div class="flex items-center gap-2 mb-5">
          <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
          <h2 class="text-lg font-bold text-gray-900">Skill ROI Analysis</h2>
        </div>
        <div class="space-y-1">
          <% missing_skills = (@skill_data.dig("missing_skills") || []) %>
          <% missing_skills.first(5).each do |skill| %>
            <% skill_name = skill["name"] || skill[:name] %>
            <% uplift = skill["salary_uplift_index"] || skill[:salary_uplift_index] %>
            <div class="flex items-center justify-between py-3 border-b border-gray-50 last:border-0">
              <div class="flex items-center gap-3">
                <div class="w-2 h-2 bg-cyan-500 rounded-full shrink-0"></div>
                <p class="font-medium text-gray-900"><%= skill_name %></p>
              </div>
              <span class="px-3 py-1 bg-green-50 text-green-600 text-sm font-semibold rounded-full whitespace-nowrap">+&#8377;<%= uplift.to_f.round(1) %>L Impact</span>
            </div>
          <% end %>
          <% if missing_skills.empty? %>
            <div class="py-6 text-center">
              <p class="text-sm text-gray-400">Upload your resume to get personalized skill ROI analysis.</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- AI Growth Hacks -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <div class="flex items-center gap-2 mb-5">
          <svg class="w-5 h-5 text-cyan-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/></svg>
          <h2 class="text-lg font-bold text-gray-900">AI Growth Hacks</h2>
        </div>
        <div class="space-y-4">
          <% matched_skills = (@skill_data.dig("matched_skills") || []).map { |s| s["name"] || s[:name] } %>
          <% top_missing = missing_skills.first(2).map { |s| s["name"] || s[:name] } %>

          <div class="flex items-start gap-3">
            <div class="w-5 h-5 bg-cyan-100 rounded flex items-center justify-center shrink-0 mt-0.5">
              <div class="w-1.5 h-1.5 bg-cyan-500 rounded-full"></div>
            </div>
            <p class="text-sm text-gray-600">Your background in <span class="font-semibold text-gray-900"><%= matched_skills.first || "your current stack" %></span> is strong. Transitioning to Fullstack with this could trigger a <span class="font-semibold text-green-600">+20% salary jump</span> immediately.</p>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-5 h-5 bg-cyan-100 rounded flex items-center justify-center shrink-0 mt-0.5">
              <div class="w-1.5 h-1.5 bg-cyan-500 rounded-full"></div>
            </div>
            <p class="text-sm text-gray-600">MAANG companies are currently hiring <span class="font-semibold text-gray-900">12% more</span> for your specific profile in the <span class="font-semibold text-gray-900"><%= current_user.city %></span> region.</p>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-5 h-5 bg-cyan-100 rounded flex items-center justify-center shrink-0 mt-0.5">
              <div class="w-1.5 h-1.5 bg-cyan-500 rounded-full"></div>
            </div>
            <p class="text-sm text-gray-600">Applying through internal referrals increases your interview conversion by <span class="font-semibold text-gray-900">4.5x</span>. Use your network strategically.</p>
          </div>

          <% if top_missing.any? %>
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 bg-cyan-100 rounded flex items-center justify-center shrink-0 mt-0.5">
                <div class="w-1.5 h-1.5 bg-cyan-500 rounded-full"></div>
              </div>
              <p class="text-sm text-gray-600">Learning <span class="font-semibold text-gray-900"><%= top_missing.join(" and ") %></span> would close your skill gap and boost your interview score significantly.</p>
            </div>
          <% end %>
        </div>
        <div class="mt-5 pt-4 border-t border-gray-50">
          <a href="#" class="text-sm text-cyan-600 font-semibold hover:text-cyan-700">View Comprehensive Analysis &rarr;</a>
        </div>
      </div>
    </div>

    <!-- 12-Month Career Roadmap -->
    <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
      <div class="flex items-center gap-2 mb-6">
        <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
        <h2 class="text-lg font-bold text-gray-900">12-Month Career Roadmap</h2>
      </div>

      <!-- Timeline connector -->
      <div class="relative">
        <div class="hidden md:block absolute top-4 left-0 right-0 h-0.5 bg-gray-100 z-0"></div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative z-10">
          <% roadmap_timeline = @roadmap_data.dig("timeline") || [] %>
          <% milestones = @roadmap_data.dig("milestones") || [] %>

          <!-- Months 1-3: Foundation -->
          <div class="relative bg-gray-50 rounded-xl p-4">
            <div class="flex items-center gap-2 mb-3">
              <div class="w-8 h-8 bg-cyan-500 rounded-full flex items-center justify-center shadow-sm">
                <span class="text-xs font-bold text-white">1-3</span>
              </div>
              <span class="text-sm font-semibold text-gray-700">Months 1-3</span>
            </div>
            <p class="text-sm font-semibold text-gray-900 mb-1">Foundation</p>
            <% first_skills = roadmap_timeline.select { |t| s = t["start_month"] || t[:start_month]; s.to_i <= 3 }.map { |t| t["skill"] || t[:skill] } %>
            <p class="text-xs text-gray-500">
              <% if first_skills.any? %>
                Master <%= first_skills.first(2).join(" & ") %> basics. Clear 10 mock interviews.
              <% else %>
                Master ML & distributed systems basics. Clear 10 mock interviews.
              <% end %>
            </p>
          </div>

          <!-- Months 4-6: Skill Building -->
          <div class="relative bg-gray-50 rounded-xl p-4">
            <div class="flex items-center gap-2 mb-3">
              <div class="w-8 h-8 bg-cyan-400 rounded-full flex items-center justify-center shadow-sm">
                <span class="text-xs font-bold text-white">4-6</span>
              </div>
              <span class="text-sm font-semibold text-gray-700">Months 4-6</span>
            </div>
            <p class="text-sm font-semibold text-gray-900 mb-1">Skill Building</p>
            <% mid_skills = roadmap_timeline.select { |t| s = t["start_month"] || t[:start_month]; s.to_i.between?(4, 6) }.map { |t| t["skill"] || t[:skill] } %>
            <p class="text-xs text-gray-500">
              <% if mid_skills.any? %>
                Resume revamp. Start active outreach to Tier-1 product firms.
              <% else %>
                Resume revamp. Start active outreach to Tier-1 product firms.
              <% end %>
            </p>
          </div>

          <!-- Months 7-9: Interview Sprint -->
          <div class="relative bg-gray-50 rounded-xl p-4">
            <div class="flex items-center gap-2 mb-3">
              <div class="w-8 h-8 bg-cyan-300 rounded-full flex items-center justify-center shadow-sm">
                <span class="text-xs font-bold text-white">7-9</span>
              </div>
              <span class="text-sm font-semibold text-gray-700">Months 7-9</span>
            </div>
            <p class="text-sm font-semibold text-gray-900 mb-1">Interview Sprint</p>
            <p class="text-xs text-gray-500">Handle multiple offers. Deploy compensation leverage strategy.</p>
          </div>

          <!-- Months 10-12: Career Advancement -->
          <div class="relative bg-gray-50 rounded-xl p-4">
            <div class="flex items-center gap-2 mb-3">
              <div class="w-8 h-8 bg-cyan-200 rounded-full flex items-center justify-center shadow-sm">
                <span class="text-xs font-bold text-gray-700">10-12</span>
              </div>
              <span class="text-sm font-semibold text-gray-700">Months 10-12</span>
            </div>
            <p class="text-sm font-semibold text-gray-900 mb-1">Career Advancement</p>
            <p class="text-xs text-gray-500">Onboarding & achieving first "High Performer" rating in new role.</p>
          </div>
        </div>
      </div>
    </div>

    <% unless @report.paid? %>
      <!-- Payment Wall / CTA -->
      <div class="bg-gray-900 rounded-2xl p-8 mb-6"
           data-controller="payment"
           data-payment-report-id-value="<%= @report.id %>"
           data-payment-key-id-value="<%= ENV.fetch('RAZORPAY_KEY_ID', '') %>"
           data-payment-user-name-value="<%= current_user.full_name %>"
           data-payment-user-email-value="<%= current_user.email %>">
        <div class="max-w-2xl mx-auto text-center">
          <div class="inline-flex items-center justify-center w-14 h-14 bg-cyan-500/20 rounded-full mb-4">
            <svg class="w-7 h-7 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
          </div>
          <h2 class="text-2xl font-bold text-white">Unlock Your Full Career Blueprint</h2>
          <p class="mt-2 text-gray-400">Get the complete analysis with personalized roadmap, skill recommendations, and downloadable PDF report.</p>
          <div class="mt-4 flex flex-wrap justify-center gap-4 text-sm text-gray-400">
            <span class="flex items-center gap-1"><svg class="w-4 h-4 text-cyan-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Full PDF Report</span>
            <span class="flex items-center gap-1"><svg class="w-4 h-4 text-cyan-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Skill ROI Analysis</span>
            <span class="flex items-center gap-1"><svg class="w-4 h-4 text-cyan-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> 12-Month Roadmap</span>
            <span class="flex items-center gap-1"><svg class="w-4 h-4 text-cyan-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Salary Projections</span>
          </div>
          <div class="mt-6 flex flex-col sm:flex-row gap-4 justify-center items-center">
            <button data-action="click->payment#pay"
                    class="px-8 py-3 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 transition-colors cursor-pointer text-lg">
              Unlock Full Report &mdash; &#8377;999
            </button>
            <span class="text-xs text-gray-500">One-time payment &bull; Secure via Razorpay</span>
          </div>
        </div>
      </div>
    <% else %>
      <!-- Paid confirmation badge -->
      <div class="bg-green-50 border border-green-200 rounded-2xl p-4 mb-6 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-green-800">Premium Report Unlocked</p>
            <p class="text-xs text-green-600">Full access to your career blueprint and PDF download.</p>
          </div>
        </div>
        <%= link_to download_pdf_career_report_path(@report), class: "px-4 py-2 bg-green-500 text-white text-sm font-semibold rounded-lg hover:bg-green-600 transition-colors" do %>
          Download PDF
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Footer -->
  <footer class="bg-white border-t border-gray-100 py-6">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <p class="text-xs text-gray-400">&copy; 2024 Career Growth AI. All data is based on real-time market surveys and verified hiring trends.</p>
    </div>
  </footer>
</div>

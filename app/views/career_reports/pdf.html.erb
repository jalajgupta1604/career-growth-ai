<!-- Header -->
<div class="pdf-header clearfix">
  <span class="logo-icon">&#9733;</span>
  <span class="logo-text">Career Growth AI</span>
  <span class="date">Generated on <%= Date.today.strftime("%B %d, %Y") %></span>
</div>

<!-- Title -->
<div class="pdf-title">
  <h1>Career Blueprint</h1>
  <p>Personalized roadmap for <strong><%= @user.full_name || @user.email %></strong> &mdash; <%= @user.role %> in <%= @user.city %> &bull; <%= @user.experience_years %> years experience</p>
</div>

<!-- Salary Benchmark + Interview Score -->
<div class="section">
  <div class="section-title"><span class="dot"></span>Salary Benchmark & Interview Score</div>
  <table class="stats-table">
    <tr>
      <td>
        <div class="stat-label">Current CTC</div>
        <div class="stat-value color-dark">&#8377;<%= (@user.current_salary.to_i / 100000.0).round(0) %>L</div>
      </td>
      <td>
        <div class="stat-label">Market Median</div>
        <% median = @salary_data.dig("salary_analysis", "benchmark", "median_salary") || @salary_data.dig("benchmark", "median_salary") %>
        <div class="stat-value color-primary">&#8377;<%= (median.to_i / 100000.0).round(0) %>L</div>
      </td>
      <td>
        <div class="stat-label">Target (95th %ile)</div>
        <% max_sal = @salary_data.dig("salary_analysis", "benchmark", "max_salary") || @salary_data.dig("benchmark", "max_salary") %>
        <div class="stat-value color-dark">&#8377;<%= (max_sal.to_i / 100000.0).round(0) %>L+</div>
      </td>
      <td>
        <div class="stat-label">Salary Gap</div>
        <div class="stat-value color-danger"><%= @report.salary_gap_percentage %>%</div>
      </td>
      <td>
        <div class="stat-label">Interview Score</div>
        <div class="stat-value color-primary"><%= @report.interview_score&.round(0) %>/100</div>
      </td>
    </tr>
  </table>

  <!-- Progress Bar -->
  <div class="progress-label">Salary Gap Progress</div>
  <div class="progress-bar">
    <% gap_pct = @report.salary_gap_percentage.to_f.clamp(0, 100) %>
    <div class="progress-fill" style="width: <%= 100 - gap_pct %>%"></div>
  </div>
  <div class="progress-note">&#8377;<%= (((median.to_i - @user.current_salary.to_i).abs) / 100000.0).round(0) %>L gap to market median</div>
</div>

<!-- Two Column: Skill ROI + AI Growth Hacks -->
<div class="section clearfix">
  <div class="col-left">
    <div class="section-title"><span class="dot"></span>Skill ROI Analysis</div>
    <% missing_skills = (@report.skill_gap_data.dig("skill_analysis", "missing_skills") || @report.skill_gap_data.dig("skill_analysis", "top_skills_to_learn") || []) %>
    <table class="skill-table">
      <% missing_skills.first(6).each do |skill| %>
        <tr>
          <td>
            <span class="skill-bullet"></span>
            <span class="skill-name"><%= skill["name"] %></span>
          </td>
          <td style="text-align: right;">
            <span class="skill-tag">+&#8377;<%= skill["salary_uplift_index"].to_f.round(1) %>L Impact</span>
          </td>
        </tr>
      <% end %>
    </table>
    <% if missing_skills.empty? %>
      <p style="color: #9ca3af;">Upload your resume for personalized skill analysis.</p>
    <% end %>
  </div>

  <div class="col-right">
    <div class="section-title"><span class="dot"></span>AI Growth Hacks</div>
    <% matched_skills = (@report.skill_gap_data.dig("skill_analysis", "matched_skills") || []).map { |s| s["name"] } %>

    <div class="hack-item">
      <span class="hack-dot"></span>
      <span class="hack-text">Your background in <strong><%= matched_skills.first || "your current stack" %></strong> is strong. Transitioning to Fullstack could trigger a <strong style="color: #16a34a;">+20% salary jump</strong> immediately.</span>
    </div>

    <div class="hack-item">
      <span class="hack-dot"></span>
      <span class="hack-text">MAANG companies are hiring <strong>12% more</strong> for your profile in <strong><%= @user.city %></strong>.</span>
    </div>

    <div class="hack-item">
      <span class="hack-dot"></span>
      <span class="hack-text">Internal referrals increase interview conversion by <strong>4.5x</strong>. Leverage your network.</span>
    </div>

    <% top_missing = missing_skills.first(2).map { |s| s["name"] } %>
    <% if top_missing.any? %>
      <div class="hack-item">
        <span class="hack-dot"></span>
        <span class="hack-text">Learning <strong><%= top_missing.join(" and ") %></strong> would close your skill gap and boost interview score.</span>
      </div>
    <% end %>
  </div>
</div>

<!-- 12-Month Career Roadmap -->
<div class="section">
  <div class="section-title"><span class="dot"></span>12-Month Career Roadmap</div>
  <% timeline = @report.roadmap_data.dig("roadmap", "timeline") || [] %>
  <% first_skills = timeline.select { |t| t["start_month"].to_i <= 3 }.map { |t| t["skill"] } %>
  <table class="roadmap-table">
    <tr>
      <td>
        <div class="roadmap-badge" style="background: #06b6d4;">1-3</div>
        <div class="roadmap-phase">Foundation</div>
        <div class="roadmap-desc">
          <% if first_skills.any? %>
            Master <%= first_skills.first(2).join(" & ") %> basics. Clear 10 mock interviews.
          <% else %>
            Master core skills and system design. Clear 10 mock interviews.
          <% end %>
        </div>
      </td>
      <td>
        <div class="roadmap-badge" style="background: #22d3ee;">4-6</div>
        <div class="roadmap-phase">Skill Building</div>
        <div class="roadmap-desc">Resume revamp. Start active outreach to Tier-1 product firms.</div>
      </td>
      <td>
        <div class="roadmap-badge" style="background: #67e8f9;">7-9</div>
        <div class="roadmap-phase">Interview Sprint</div>
        <div class="roadmap-desc">Handle multiple offers. Deploy compensation leverage strategy.</div>
      </td>
      <td>
        <div class="roadmap-badge" style="background: #a5f3fc; color: #374151;">10-12</div>
        <div class="roadmap-phase">Career Advancement</div>
        <div class="roadmap-desc">Onboarding & achieving "High Performer" rating in new role.</div>
      </td>
    </tr>
  </table>
</div>

<!-- Recommended Certifications -->
<% certs = @report.roadmap_data.dig("roadmap", "certifications") || [] %>
<% if certs.any? %>
  <div class="section">
    <div class="section-title"><span class="dot"></span>Recommended Certifications</div>
    <% certs.each do |cert| %>
      <div class="cert-item"><span class="cert-check">&#10003;</span> <%= cert %></div>
    <% end %>
  </div>
<% end %>

<!-- Salary Projection -->
<% projection = @report.roadmap_data.dig("roadmap", "salary_projection") || {} %>
<% if projection.any? %>
  <div class="section">
    <div class="section-title"><span class="dot"></span>Salary Projection</div>
    <table class="stats-table">
      <tr>
        <td>
          <div class="stat-label">Current</div>
          <div class="stat-value color-dark">&#8377;<%= (projection["current_salary"].to_i / 100000.0).round(0) %>L</div>
        </td>
        <td>
          <div class="stat-label">6-Month Target</div>
          <div class="stat-value color-primary">&#8377;<%= (projection["projected_6_months"].to_i / 100000.0).round(0) %>L</div>
        </td>
        <td>
          <div class="stat-label">12-Month Target</div>
          <div class="stat-value color-primary">&#8377;<%= (projection["projected_12_months"].to_i / 100000.0).round(0) %>L</div>
        </td>
      </tr>
    </table>
  </div>
<% end %>

<!-- Footer -->
<div class="pdf-footer">
  <p><strong>Career Growth AI</strong> &mdash; Personalized Career Intelligence for Indian IT Professionals</p>
  <p>This report is confidential and generated specifically for <%= @user.full_name || @user.email %>.</p>
  <p>&copy; 2024 Career Growth AI. Data based on real-time market surveys and verified hiring trends.</p>
</div>

<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-3xl mx-auto px-4">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 bg-cyan-500 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        </div>
        <span class="text-lg font-bold text-gray-900">Career Growth AI</span>
      </div>
      <%= link_to dashboard_path, class: "flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Back to Dashboard
      <% end %>
    </div>

    <!-- Status Card -->
    <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center
            <%= case @resume.parsing_status
                when 'completed' then 'bg-green-100'
                when 'processing' then 'bg-yellow-100'
                when 'failed' then 'bg-red-100'
                else 'bg-gray-100'
                end %>">
            <% case @resume.parsing_status %>
            <% when 'completed' %>
              <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <% when 'processing' %>
              <svg class="w-6 h-6 text-yellow-500 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            <% when 'failed' %>
              <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <% else %>
              <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <% end %>
          </div>
          <div>
            <h1 class="text-xl font-bold text-gray-900">Resume #<%= @resume.id %></h1>
            <p class="text-sm text-gray-500">Uploaded on <%= @resume.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
          </div>
        </div>
        <span class="text-sm font-semibold px-4 py-2 rounded-full
          <%= case @resume.parsing_status
              when 'completed' then 'bg-green-100 text-green-700'
              when 'processing' then 'bg-yellow-100 text-yellow-700'
              when 'failed' then 'bg-red-100 text-red-700'
              else 'bg-gray-100 text-gray-500'
              end %>">
          <%= @resume.parsing_status.capitalize %>
        </span>
      </div>
    </div>

    <% if @resume.completed? && @resume.parsed_data.present? %>
      <!-- Extracted Skills -->
      <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-cyan-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <h2 class="text-lg font-bold text-gray-900">Extracted Skills</h2>
          <span class="text-xs font-medium bg-cyan-100 text-cyan-700 px-2 py-0.5 rounded-full">
            <%= (@resume.parsed_data["skills"] || []).size %> found
          </span>
        </div>
        <div class="flex flex-wrap gap-2">
          <% (@resume.parsed_data["skills"] || []).each do |skill| %>
            <span class="px-3 py-1.5 bg-cyan-50 text-cyan-700 border border-cyan-100 rounded-lg text-sm font-medium"><%= skill %></span>
          <% end %>
        </div>
      </div>

      <!-- Experience -->
      <% if @resume.parsed_data["experience"].present? %>
        <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
          <div class="flex items-center gap-2 mb-4">
            <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <h2 class="text-lg font-bold text-gray-900">Experience</h2>
          </div>
          <div class="space-y-3">
            <% Array(@resume.parsed_data["experience"]).each do |exp| %>
              <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-xl">
                <div class="w-2 h-2 bg-cyan-500 rounded-full mt-2 shrink-0"></div>
                <p class="text-sm text-gray-700"><%= exp %></p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Certifications -->
      <% if @resume.parsed_data["certifications"].present? %>
        <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
          <div class="flex items-center gap-2 mb-4">
            <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
            <h2 class="text-lg font-bold text-gray-900">Certifications</h2>
          </div>
          <div class="flex flex-wrap gap-2">
            <% Array(@resume.parsed_data["certifications"]).each do |cert| %>
              <span class="px-3 py-1.5 bg-green-50 text-green-700 border border-green-100 rounded-lg text-sm font-medium"><%= cert %></span>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Projects -->
      <% if @resume.parsed_data["projects"].present? %>
        <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
          <div class="flex items-center gap-2 mb-4">
            <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            <h2 class="text-lg font-bold text-gray-900">Projects</h2>
          </div>
          <div class="space-y-3">
            <% Array(@resume.parsed_data["projects"]).each do |project| %>
              <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-xl">
                <div class="w-2 h-2 bg-cyan-500 rounded-full mt-2 shrink-0"></div>
                <p class="text-sm text-gray-700"><%= project %></p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% elsif @resume.processing? %>
      <!-- Processing state -->
      <div class="bg-white rounded-2xl border border-gray-100 p-12 text-center">
        <div class="w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-yellow-500 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900">Analyzing Your Resume</h3>
        <p class="mt-2 text-gray-500">Our AI is extracting skills, experience, and certifications. This usually takes a few seconds.</p>
        <p class="mt-4 text-sm text-gray-400">Refresh the page to check the status.</p>
      </div>
    <% elsif @resume.failed? %>
      <!-- Failed state -->
      <div class="bg-white rounded-2xl border border-red-100 p-12 text-center">
        <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900">Parsing Failed</h3>
        <p class="mt-2 text-gray-500">We couldn't extract data from your resume. Please try uploading again with a different format.</p>
        <%= link_to "Upload Again", new_resume_path, class: "inline-block mt-6 px-6 py-3 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors" %>
      </div>
    <% else %>
      <!-- Pending state -->
      <div class="bg-white rounded-2xl border border-gray-100 p-12 text-center">
        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900">Queued for Processing</h3>
        <p class="mt-2 text-gray-500">Your resume is in the queue. Analysis will begin shortly.</p>
        <p class="mt-4 text-sm text-gray-400">Refresh the page to check the status.</p>
      </div>
    <% end %>

    <!-- Actions -->
    <div class="mt-6 flex items-center justify-between">
      <%= link_to dashboard_path, class: "flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Back to Dashboard
      <% end %>
      <%= link_to "Upload New Resume", new_resume_path, class: "text-sm font-semibold text-cyan-600 hover:text-cyan-700 transition-colors" %>
    </div>
  </div>
</div>

<div class="min-h-screen bg-gray-50 flex">
  <!-- Left Panel -->
  <div class="hidden lg:flex lg:w-1/2 bg-gray-900 flex-col justify-between p-12">
    <div class="flex items-center space-x-2">
      <div class="w-8 h-8 bg-cyan-500 rounded-lg flex items-center justify-center">
        <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
      </div>
      <span class="text-xl font-bold text-white">Career Growth AI</span>
    </div>

    <div>
      <h2 class="text-4xl font-bold text-white leading-tight">Let AI Read<br><span class="text-cyan-400">Your Resume.</span></h2>
      <p class="mt-4 text-gray-400 text-lg">Upload your resume and our AI will extract skills, experience, and certifications to build your personalized career blueprint.</p>

      <div class="mt-10 space-y-5">
        <div class="flex items-start space-x-4">
          <div class="w-10 h-10 bg-cyan-500/20 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
          </div>
          <div>
            <p class="text-white font-semibold">Skill Extraction</p>
            <p class="text-sm text-gray-500">We identify 60+ in-demand tech skills from your resume automatically.</p>
          </div>
        </div>

        <div class="flex items-start space-x-4">
          <div class="w-10 h-10 bg-cyan-500/20 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
          </div>
          <div>
            <p class="text-white font-semibold">Gap Analysis</p>
            <p class="text-sm text-gray-500">Compare your skills against top market requirements for your role.</p>
          </div>
        </div>

        <div class="flex items-start space-x-4">
          <div class="w-10 h-10 bg-cyan-500/20 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
          </div>
          <div>
            <p class="text-white font-semibold">100% Private</p>
            <p class="text-sm text-gray-500">Your resume data is encrypted and never shared with third parties.</p>
          </div>
        </div>
      </div>
    </div>

    <p class="text-sm text-gray-600">Supports PDF and DOCX formats up to 10MB.</p>
  </div>

  <!-- Right Panel -->
  <div class="w-full lg:w-1/2 flex items-center justify-center p-8">
    <div class="w-full max-w-md">
      <!-- Mobile logo -->
      <div class="flex items-center space-x-2 mb-8 lg:hidden">
        <div class="w-8 h-8 bg-cyan-500 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        </div>
        <span class="text-xl font-bold text-gray-900">Career Growth AI</span>
      </div>

      <h1 class="text-3xl font-bold text-gray-900">Upload Your Resume</h1>
      <p class="mt-2 text-gray-500">We'll extract your skills and experience to generate personalized career insights.</p>

      <%= form_with(model: @resume, url: resumes_path, method: :post, multipart: true, class: "mt-8 space-y-6", data: { controller: "loading-button", loading_button_text_value: "Uploading & Analyzing...", action: "submit->loading-button#submit" }) do |f| %>
        <!-- Upload Zone -->
        <div data-controller="file-drop">
          <div data-file-drop-target="zone" class="border-2 border-dashed border-cyan-200 bg-cyan-50/30 rounded-2xl p-10 text-center hover:border-cyan-400 transition-all cursor-pointer relative">
            <div class="w-16 h-16 bg-cyan-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
              </svg>
            </div>
            <p class="text-gray-700 font-semibold">
              <label for="resume_file" class="cursor-pointer text-cyan-600 hover:text-cyan-700">Click to upload</label>
              or drag and drop
            </p>
            <p class="mt-2 text-sm text-gray-400">PDF or DOCX (Max 10MB)</p>
            <div data-file-drop-target="fileName" class="mt-3 hidden">
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-cyan-100 text-cyan-700 rounded-lg text-sm font-medium">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>
                <span data-file-drop-target="fileNameText"></span>
              </span>
            </div>
            <%= f.file_field :file, accept: ".pdf,.docx", id: "resume_file", class: "sr-only", data: { file_drop_target: "input", action: "change->file-drop#selected" } %>
          </div>
        </div>

        <!-- What we extract -->
        <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
          <p class="text-sm font-semibold text-gray-700 mb-3">What our AI extracts:</p>
          <div class="grid grid-cols-2 gap-3">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-cyan-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span class="text-sm text-gray-600">Technical Skills</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-cyan-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span class="text-sm text-gray-600">Work Experience</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-cyan-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span class="text-sm text-gray-600">Certifications</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-cyan-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span class="text-sm text-gray-600">Projects</span>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="space-y-3">
          <%= f.submit "Upload & Analyze", class: "w-full py-3.5 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer text-lg" %>
          <%= link_to dashboard_path, class: "w-full py-3 block text-center text-gray-500 font-medium hover:text-gray-700 transition-colors" do %>
            Skip for now
          <% end %>
        </div>
      <% end %>

      <!-- Already uploaded -->
      <% if current_user.resumes.any? %>
        <div class="mt-8 pt-6 border-t border-gray-200">
          <p class="text-sm font-semibold text-gray-700 mb-3">Previous Uploads</p>
          <div class="space-y-2">
            <% current_user.resumes.order(created_at: :desc).limit(3).each do |resume| %>
              <%= link_to resume_path(resume), class: "flex items-center justify-between p-3 bg-white border border-gray-100 rounded-xl hover:border-cyan-200 transition-colors" do %>
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-cyan-50 rounded-lg flex items-center justify-center">
                    <svg class="w-4 h-4 text-cyan-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-gray-700">Resume #<%= resume.id %></p>
                    <p class="text-xs text-gray-400"><%= resume.created_at.strftime("%b %d, %Y") %></p>
                  </div>
                </div>
                <span class="text-xs font-medium px-2.5 py-1 rounded-full
                  <%= case resume.parsing_status
                      when 'completed' then 'bg-green-100 text-green-700'
                      when 'processing' then 'bg-yellow-100 text-yellow-700'
                      when 'failed' then 'bg-red-100 text-red-700'
                      else 'bg-gray-100 text-gray-500'
                      end %>">
                  <%= resume.parsing_status.capitalize %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>


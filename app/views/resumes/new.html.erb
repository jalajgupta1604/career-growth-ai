<div class="min-h-screen bg-gray-50 py-12">
  <div class="max-w-2xl mx-auto px-4">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Upload Your Resume</h1>
      <p class="mt-2 text-gray-500">We'll extract your skills and experience to generate personalized insights.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
      <%= form_with(model: @resume, url: resumes_path, method: :post, multipart: true, class: "space-y-6") do |f| %>
        <div class="border-2 border-dashed border-gray-300 rounded-xl p-12 text-center hover:border-indigo-400 transition-colors">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
          </svg>
          <p class="mt-4 text-sm text-gray-600">
            <label for="resume_file" class="cursor-pointer text-indigo-600 font-medium hover:text-indigo-500">
              Click to upload
            </label>
            or drag and drop
          </p>
          <p class="mt-1 text-xs text-gray-400">PDF or DOCX up to 10MB</p>
          <%= f.file_field :file, accept: ".pdf,.docx", id: "resume_file", class: "sr-only" %>
        </div>

        <div class="flex gap-4">
          <%= f.submit "Upload & Analyze", class: "flex-1 py-3 px-6 bg-indigo-600 text-white font-medium rounded-xl hover:bg-indigo-700 transition-colors cursor-pointer" %>
          <%= link_to "Skip for now", dashboard_path, class: "py-3 px-6 bg-gray-100 text-gray-600 font-medium rounded-xl hover:bg-gray-200 transition-colors text-center" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Study Groups</h1>
        <p class="mt-1 text-sm text-gray-500">Collaborate and prepare together with like-minded professionals</p>
      </div>
      <a href="#create-group" class="inline-flex items-center gap-2 px-4 py-2.5 bg-cyan-500 text-white text-sm font-semibold rounded-xl hover:bg-cyan-600 transition-colors">
        <span class="material-symbols-outlined text-[18px]">add</span>
        Create Group
      </a>
    </div>

    <!-- Create Group Form -->
    <div id="create-group" class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-10 h-10 rounded-lg bg-cyan-100 flex items-center justify-center">
          <span class="material-symbols-outlined text-[22px] text-cyan-500">group_add</span>
        </div>
        <h2 class="text-lg font-bold text-gray-900">Create a New Group</h2>
      </div>

      <%= form_with url: study_groups_path, method: :post, data: { controller: "loading-button", loading_button_text_value: "Creating...", action: "submit->loading-button#submit" } do |f| %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div class="sm:col-span-2">
            <label class="block text-sm font-semibold text-gray-700 mb-2">Group Name</label>
            <%= f.text_field :name, class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-900 focus:border-cyan-500 focus:ring-cyan-500 transition-colors", placeholder: "e.g. FAANG System Design Prep" %>
          </div>
          <div class="sm:col-span-2">
            <label class="block text-sm font-semibold text-gray-700 mb-2">Description</label>
            <%= f.text_area :description, rows: 3, class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-900 focus:border-cyan-500 focus:ring-cyan-500 transition-colors resize-none", placeholder: "What will the group focus on?" %>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Target Company</label>
            <%= f.text_field :target_company, class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-900 focus:border-cyan-500 focus:ring-cyan-500 transition-colors", placeholder: "e.g. Google" %>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Target Role</label>
            <%= f.text_field :target_role, class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-900 focus:border-cyan-500 focus:ring-cyan-500 transition-colors", placeholder: "e.g. Backend Engineer" %>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Max Members</label>
            <%= f.number_field :max_members, value: 6, min: 2, max: 20, class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-900 focus:border-cyan-500 focus:ring-cyan-500 transition-colors" %>
          </div>
        </div>
        <%= f.submit "Create Group", class: "w-full py-3 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer" %>
      <% end %>
    </div>

    <!-- My Groups -->
    <% if @my_groups.present? && @my_groups.any? %>
      <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center">
            <span class="material-symbols-outlined text-[22px] text-emerald-500">bookmark</span>
          </div>
          <h2 class="text-lg font-bold text-gray-900">My Groups</h2>
        </div>
        <div class="space-y-3">
          <% @my_groups.each do |group| %>
            <%= link_to study_group_path(group), class: "block" do %>
              <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-cyan-100 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px] text-cyan-600">group</span>
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-gray-900"><%= group.name %></p>
                    <p class="text-xs text-gray-400">
                      <%= group.members_count || group.members.size %> / <%= group.max_members %> members
                      <% if group.target_company.present? %>
                        &bull; <%= group.target_company %>
                      <% end %>
                    </p>
                  </div>
                </div>
                <span class="material-symbols-outlined text-[18px] text-gray-400">chevron_right</span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- All Groups -->
    <div class="bg-white rounded-2xl border border-gray-100 p-6">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-10 h-10 rounded-lg bg-violet-100 flex items-center justify-center">
          <span class="material-symbols-outlined text-[22px] text-violet-500">explore</span>
        </div>
        <h2 class="text-lg font-bold text-gray-900">All Groups</h2>
      </div>

      <% if @groups.present? && @groups.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% @groups.each do |group| %>
            <div class="border border-gray-100 rounded-xl p-4 hover:border-cyan-200 transition-colors">
              <div class="mb-3">
                <h3 class="text-sm font-bold text-gray-900"><%= group.name %></h3>
                <% if group.description.present? %>
                  <p class="text-xs text-gray-500 mt-1 line-clamp-2"><%= truncate(group.description, length: 120) %></p>
                <% end %>
              </div>
              <div class="flex flex-wrap gap-2 mb-3">
                <% if group.target_company.present? %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded-full bg-gray-50 text-gray-600">
                    <span class="material-symbols-outlined text-[14px]">business</span>
                    <%= group.target_company %>
                  </span>
                <% end %>
                <% if group.target_role.present? %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded-full bg-gray-50 text-gray-600">
                    <span class="material-symbols-outlined text-[14px]">work</span>
                    <%= group.target_role %>
                  </span>
                <% end %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded-full bg-cyan-50 text-cyan-600">
                  <span class="material-symbols-outlined text-[14px]">group</span>
                  <%= group.members_count || group.members.size %> / <%= group.max_members %>
                </span>
              </div>
              <%= link_to "View", study_group_path(group), class: "block w-full py-2 text-center bg-cyan-500 text-white text-sm font-semibold rounded-lg hover:bg-cyan-600 transition-colors" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8">
          <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-3">
            <span class="material-symbols-outlined text-[28px] text-gray-400">group_off</span>
          </div>
          <p class="text-sm text-gray-500">No study groups yet.</p>
          <p class="text-xs text-gray-400 mt-1">Be the first to create one!</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

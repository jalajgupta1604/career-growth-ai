<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <%= link_to offer_analyses_path, class: "text-sm text-gray-500 hover:text-gray-700" do %>
      &larr; Back to Offer Analyses
    <% end %>
    <h1 class="text-3xl font-bold text-gray-900 mt-4">Analyze Offer Letter</h1>
    <p class="mt-1 text-gray-500">Enter your offer details for a comprehensive AI analysis</p>
  </div>

  <%= form_with model: OfferAnalysis.new, url: offer_analyses_path, method: :post, class: "space-y-6" do |f| %>
    <div class="bg-white rounded-2xl border border-gray-100 p-6 space-y-5">
      <h2 class="text-lg font-semibold text-gray-900">Company & Role</h2>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Company Name</label>
          <%= f.text_field :company_name, class: "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500", placeholder: "e.g., Flipkart" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Offered Role</label>
          <%= f.text_field :offer_role, class: "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500", placeholder: "e.g., SDE-2", value: current_user.role %>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 p-6 space-y-5">
      <h2 class="text-lg font-semibold text-gray-900">Compensation</h2>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Base Salary (&#8377; per annum)</label>
          <%= f.number_field :base_salary, class: "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500", placeholder: "e.g., 1200000", step: 1000 %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Total CTC (&#8377; per annum)</label>
          <%= f.number_field :total_ctc, class: "w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500", placeholder: "e.g., 1800000", step: 1000 %>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">CTC Components (optional)</label>
        <textarea name="offer_analysis[components]" rows="4" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 resize-y" placeholder="Enter each component on a new line, e.g.:
Base: 12,00,000
Bonus: 2,00,000
ESOP: 3,00,000
PF: 1,00,000"></textarea>
      </div>
    </div>

    <div class="bg-cyan-50 rounded-xl p-4">
      <div class="flex items-start gap-2">
        <svg class="w-5 h-5 text-cyan-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
        <p class="text-xs text-cyan-700">We'll compare this offer against market data for <strong><%= current_user.role %></strong> in <strong><%= current_user.city %></strong> with <strong><%= current_user.experience_years %> years</strong> experience.</p>
      </div>
    </div>

    <div class="flex items-center justify-between">
      <%= link_to "Cancel", offer_analyses_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <button type="submit" class="px-8 py-3 bg-cyan-500 text-white font-semibold rounded-xl hover:bg-cyan-600 transition-colors cursor-pointer">
        Analyze Offer
      </button>
    </div>
  <% end %>
</div>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to offer_analyses_path, class: "text-sm text-gray-500 hover:text-gray-700" do %>
      &larr; Back to Offer Analyses
    <% end %>
  </div>

  <!-- Header -->
  <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @analysis.company_name %></h1>
        <p class="text-sm text-gray-500 mt-1"><%= @analysis.offer_role %> &middot; Analyzed <%= time_ago_in_words(@analysis.created_at) %> ago</p>
      </div>
      <div class="text-right">
        <p class="text-3xl font-bold text-<%= @analysis.verdict_color %>-600"><%= @analysis.offer_score.to_i %>/100</p>
        <span class="inline-flex items-center px-3 py-1 mt-1 rounded-full text-sm font-semibold
          <%= case @analysis.verdict
              when 'strong_accept' then 'bg-green-100 text-green-700'
              when 'accept' then 'bg-cyan-100 text-cyan-700'
              when 'negotiate' then 'bg-yellow-100 text-yellow-700'
              when 'caution' then 'bg-orange-100 text-orange-700'
              else 'bg-red-100 text-red-700'
              end %>">
          <%= @analysis.verdict&.humanize %>
        </span>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-4 mt-6 pt-6 border-t border-gray-100">
      <div>
        <p class="text-xs text-gray-400">Base Salary</p>
        <p class="text-lg font-bold text-gray-900">&#8377;<%= number_with_delimiter(@analysis.base_salary.to_i) %></p>
      </div>
      <div>
        <p class="text-xs text-gray-400">Total CTC</p>
        <p class="text-lg font-bold text-cyan-600">&#8377;<%= number_with_delimiter(@analysis.total_ctc.to_i) %></p>
      </div>
      <div>
        <p class="text-xs text-gray-400">Est. Monthly Take-home</p>
        <p class="text-lg font-bold text-green-600">&#8377;<%= number_with_delimiter(@data["estimated_take_home"].to_i) %></p>
      </div>
    </div>
  </div>

  <!-- Salary Analysis -->
  <% if @data["salary_analysis"].present? %>
    <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-3">Salary Analysis</h2>
      <p class="text-sm text-gray-600"><%= @data["salary_analysis"] %></p>
      <% if @data["ctc_breakdown_analysis"].present? %>
        <p class="text-sm text-gray-500 mt-2"><%= @data["ctc_breakdown_analysis"] %></p>
      <% end %>
    </div>
  <% end %>

  <!-- Flags -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <% if @analysis.green_flags.any? %>
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <h2 class="text-lg font-semibold text-green-700 mb-3">Green Flags</h2>
        <ul class="space-y-2">
          <% @analysis.green_flags.each do |flag| %>
            <li class="flex items-start gap-2 text-sm text-gray-700">
              <svg class="w-4 h-4 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <%= flag %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if @analysis.red_flags.any? %>
      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <h2 class="text-lg font-semibold text-red-700 mb-3">Red Flags</h2>
        <ul class="space-y-2">
          <% @analysis.red_flags.each do |flag| %>
            <li class="flex items-start gap-2 text-sm text-gray-700">
              <svg class="w-4 h-4 text-red-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
              <%= flag %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <!-- Recommendations -->
  <% if (@data["recommendations"] || []).any? %>
    <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Recommendations</h2>
      <div class="space-y-3">
        <% (@data["recommendations"] || []).each_with_index do |rec, idx| %>
          <div class="flex items-start gap-3">
            <span class="w-7 h-7 bg-cyan-100 rounded-full flex items-center justify-center text-xs font-bold text-cyan-600 shrink-0"><%= idx + 1 %></span>
            <p class="text-sm text-gray-700 pt-1"><%= rec %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Growth Potential -->
  <% if @data["growth_potential"].present? %>
    <div class="bg-cyan-50 rounded-2xl border border-cyan-100 p-6">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-cyan-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        <div>
          <h3 class="text-sm font-semibold text-cyan-900">Growth Potential</h3>
          <p class="text-sm text-cyan-700 mt-1"><%= @data["growth_potential"] %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>

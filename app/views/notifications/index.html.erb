<div class="max-w-3xl mx-auto py-8 px-4">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Notifications</h1>
    <% if current_user.notifications.unread.any? %>
      <%= button_to "Mark all read", mark_all_read_notifications_path, method: :post, class: "text-sm text-cyan-600 hover:text-cyan-700 font-medium" %>
    <% end %>
  </div>

  <div class="space-y-2">
    <% @notifications.each do |notification| %>
      <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-start gap-3 <%= 'bg-cyan-50/50 border-cyan-100' unless notification.read? %>">
        <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 <%= notification.read? ? 'bg-gray-100' : 'bg-cyan-100' %>">
          <span class="material-symbols-outlined text-lg <%= notification.read? ? 'text-gray-400' : 'text-cyan-600' %>">
            <% case notification.category %>
            <% when "achievement" %>emoji_events
            <% when "subscription" %>star
            <% when "interview" %>record_voice_over
            <% when "career" %>trending_up
            <% when "community" %>forum
            <% else %>notifications
            <% end %>
          </span>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="text-sm font-medium text-gray-900"><%= notification.title %></p>
              <% if notification.body.present? %>
                <p class="text-sm text-gray-500 mt-0.5"><%= notification.body %></p>
              <% end %>
            </div>
            <span class="text-xs text-gray-400 flex-shrink-0"><%= time_ago_in_words(notification.created_at) %> ago</span>
          </div>
          <div class="mt-2 flex items-center gap-3">
            <% if notification.action_url.present? %>
              <%= link_to "View", notification.action_url, class: "text-xs text-cyan-600 hover:text-cyan-700 font-medium" %>
            <% end %>
            <% unless notification.read? %>
              <%= button_to "Mark read", mark_as_read_notification_path(notification), method: :post, class: "text-xs text-gray-400 hover:text-gray-600" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% if @notifications.empty? %>
      <div class="text-center py-12">
        <span class="material-symbols-outlined text-4xl text-gray-300">notifications_off</span>
        <p class="text-sm text-gray-400 mt-2">No notifications yet</p>
      </div>
    <% end %>
  </div>
</div>
